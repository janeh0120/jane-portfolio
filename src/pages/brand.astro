---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import IconControl from '../components/IconControl.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { brandWork } from '../data/brand-work';
import '../styles/play.css';

const base = import.meta.env.BASE_URL;
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Layout title="Brand | Jane Hou's Portfolio">
  <Header />
  <main class="brand text-body">
    <section class="brand-strip brand-intro page-frame" data-comment-id="brand-intro">
      <Hero subhead={site.brand?.subhead} />
      <Experience order={site.brand?.experienceOrder} />
    </section>

    {
      brandWork.map((project, projectIndex) => (
        <section
          class="brand-project"
          id={project.slug}
          data-comment-id={`brand-${project.slug}`}
          data-color-modes={project.colorModes ? '' : undefined}
          data-mode={project.colorModes ? 'light' : undefined}
        >
          <div class="brand-gallery">
            {project.colorModes && (
              <div class="segmented is-glass brand-mode-toggle" role="group" aria-label="Illustration colour mode">
                <span class="segmented-thumb" aria-hidden="true" />
                <button type="button" class="segmented-option" data-mode-choice="light" aria-pressed="true">
                  Light
                </button>
                <button type="button" class="segmented-option" data-mode-choice="dark" aria-pressed="false">
                  Dark
                </button>
              </div>
            )}
            <div class="brand-row" tabindex="0" role="region" aria-label={`${project.title} images`}>
              {project.media.map((item, index) => {
                const src = `${base}${item.src}`;
                const style = `aspect-ratio: ${item.width} / ${item.height}`;
                return item.youtubeId ? (
                  <iframe
                    class="brand-media brand-embed"
                    style={style}
                    src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?rel=0`}
                    title={item.alt}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                ) : isVideo(item.src) ? (
                  <video
                    class="brand-media"
                    style={style}
                    src={src}
                    aria-label={item.alt}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    data-brand-video
                  />
                ) : item.darkSrc ? (
                  <div class="brand-media brand-media--themed" style={style} role="img" aria-label={item.alt}>
                    <img class="brand-mode-light" src={src} alt="" width={item.width} height={item.height} loading="lazy" decoding="async" />
                    <img class="brand-mode-dark" src={`${base}${item.darkSrc}`} alt="" width={item.width} height={item.height} loading="lazy" decoding="async" />
                  </div>
                ) : (
                  <img
                    class="brand-media"
                    style={style}
                    src={src}
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                    loading={projectIndex === 0 && index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                );
              })}
            </div>
            {/* The Play overlay's arrows and dots (play.css), shown by the script only when the row
                overflows, for mice without sideways scroll */}
            <div class="carousel-nav brand-row-nav" data-brand-row-nav hidden>
              <IconControl label={`Previous ${project.title} image`} data-brand-step="-1">
                <ArrowIcon direction="left" size="16px" />
              </IconControl>
              <div class="carousel-controls">
                {project.media.map((item, index) => (
                  <button
                    type="button"
                    class:list={['carousel-dot', { active: index === 0 }]}
                    aria-label={`Go to image ${index + 1}`}
                    data-brand-dot={index}
                  />
                ))}
              </div>
              <IconControl label={`Next ${project.title} image`} data-brand-step="1">
                <ArrowIcon direction="right" size="16px" />
              </IconControl>
            </div>
          </div>

          <div class="brand-strip page-frame">
            <div class="brand-meta">
              <h2 class="text-ink text-intro brand-title">{project.title}</h2>
              <dl class="brand-details">
                {project.details.map((detail) => (
                  <div>
                    <dt class="text-muted">{detail.label}</dt>
                    <dd class="text-ink">{detail.value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="brand-body">
              {project.description.map((paragraph) => <p class="text-ink">{paragraph}</p>)}
              {project.link && (
                <a href={project.link.href} target="_blank" rel="noopener noreferrer" class="text-link text-body text-ink brand-link">
                  {project.link.label}
                  <ExternalLinkIcon />
                </a>
              )}
            </div>
          </div>
        </section>
      ))
    }
  </main>
  <SiteFooter />
</Layout>

<style>
  /* Full-width page; text strips use .page-frame, image rows bleed to both screen edges.
     --gutter matches .page-frame's side margin so rows start and end in line with the text. */
  .brand {
    --brand-row-height: clamp(18rem, 62svh, 40rem);
    --gutter: max(1.5rem, calc((100% - 1400px) / 2));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-section);
    padding-block: var(--space-10) var(--space-section);
  }

  /* Two halves, like a spread: left for who/what, right for the story */
  .brand-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  /* Experience list hugs its text instead of filling the column. Its layout switch is a
     container query, so this strip becomes the container and the list is free to shrink. */
  .brand-intro {
    container-type: inline-size;
  }

  .brand-intro :global(.experience-list) {
    container-type: normal;
    justify-self: start;
    align-self: start;
    width: max-content;
    max-width: 100%;
  }

  .brand-project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    scroll-margin-top: 7rem;
  }

  /* Images keep their natural proportions at one height; extras scroll sideways */
  .brand-row {
    display: flex;
    gap: var(--space-2);
    height: var(--brand-row-height);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding: 0 var(--gutter);
    scroll-padding-inline: var(--gutter);
    box-sizing: content-box;
  }

  .brand-row::-webkit-scrollbar {
    display: none;
  }

  .brand-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .brand-media {
    flex: none;
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
    border-radius: var(--radius-base);
    background: var(--color-fill);
    scroll-snap-align: start;
  }

  /* Light and dark artwork stacked; the section's data-mode picks which shows */
  .brand-media--themed {
    position: relative;
    display: grid;
    overflow: hidden;
  }

  .brand-media--themed img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 320ms ease;
  }

  [data-mode='light'] .brand-mode-dark,
  [data-mode='dark'] .brand-mode-light {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-media--themed img {
      transition: none;
    }
  }

  /* Holds the toggle in place over the row while the images scroll underneath */
  .brand-gallery {
    position: relative;
    min-width: 0;
  }

  .brand-embed {
    border: 0;
    background: var(--color-media-backdrop);
  }

  /* Shared .segmented toggle (global.css), held in place over the row */
  .brand-mode-toggle {
    position: absolute;
    top: var(--space-3);
    left: calc(var(--gutter) + var(--space-3));
    z-index: 2;
  }

  .brand-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    align-content: start;
  }

  .brand-meta p,
  .brand-title {
    margin: 0;
  }

  .brand-title {
    align-self: start;
  }


  .brand-body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    max-width: 38rem;
  }

  .brand-body p {
    margin: 0;
  }

  /* Label above value, stacked down the column */
  .brand-details {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    margin: 0;
  }

  .brand-details dd {
    margin: 0;
  }

  .brand-link {
    justify-self: start;
  }

  @media (max-width: 767px) {
    .brand {
      --brand-row-height: 16rem;
      --gutter: 1rem;
      gap: var(--space-20);
      padding-top: var(--space-4);
    }

    .brand-strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .brand-meta {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>

<script>
  // Light/dark toggle: follows the site's colour mode, flips once on its own as a hint,
  // and the viewer can switch it any time.
  const root = document.documentElement;
  // The page scrolls inside #site-canvas when it's a scroll container; measure visibility against it.
  const canvas = document.getElementById('site-canvas');
  const viewRoot = canvas && /auto|scroll/.test(getComputedStyle(canvas).overflowY) ? canvas : null;
  const siteMode = () => (root.classList.contains('theme-dark') ? 'dark' : 'light');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-color-modes]').forEach((section) => {
    const options = section.querySelectorAll<HTMLButtonElement>('[data-mode-choice]');
    let touched = false;

    const setMode = (mode: string) => {
      section.dataset.mode = mode;
      options.forEach((option) => option.setAttribute('aria-pressed', String(option.dataset.modeChoice === mode)));
    };

    options.forEach((option) =>
      option.addEventListener('click', () => {
        touched = true;
        setMode(option.dataset.modeChoice ?? 'light');
      }),
    );

    setMode(siteMode());
    let lastSiteMode = siteMode();
    new MutationObserver(() => {
      const mode = siteMode();
      if (mode === lastSiteMode) return;
      lastSiteMode = mode;
      setMode(mode);
    }).observe(root, { attributes: true, attributeFilter: ['class'] });

    // Hint: a second after the illustrations come into view, flip to the other mode once.
    if (!reduceMotion) {
      const hint = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          hint.disconnect();
          window.setTimeout(() => {
            if (!touched) setMode(section.dataset.mode === 'dark' ? 'light' : 'dark');
          }, 1000);
        },
        { root: viewRoot, threshold: 0.5 },
      );
      const row = section.querySelector('.brand-row');
      if (row) hint.observe(row);
    }
  });

  // Arrows, dots, and the arrow keys while a row has focus step the row one image at a time, for
  // mice without sideways scrolling. Like the Play overlay's carousel, the arrows loop at the ends.
  // Each step lands an image's left edge on the gutter, where scroll snapping puts it.
  document.querySelectorAll<HTMLElement>('.brand-gallery').forEach((gallery) => {
    const row = gallery.querySelector<HTMLElement>('.brand-row');
    const nav = gallery.querySelector<HTMLElement>('[data-brand-row-nav]');
    if (!row || !nav) return;
    const items = [...row.children] as HTMLElement[];
    const dots = [...nav.querySelectorAll<HTMLButtonElement>('[data-brand-dot]')];
    const max = () => row.scrollWidth - row.clientWidth;
    // Where the row scrolls to for each image (the last few share the end of the row)
    const stops = () => {
      const gutter = parseFloat(getComputedStyle(row).paddingLeft);
      return items.map((item) => Math.min(max(), item.offsetLeft - row.offsetLeft - gutter));
    };
    let current = 0;
    let target: number | null = null;

    const show = (index: number) => {
      current = index;
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    };

    const go = (index: number) => {
      const next = (index + items.length) % items.length;
      target = next;
      show(next);
      row.scrollTo({ left: stops()[next], behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    // Swipes and scrolls move the dot too; a step in progress keeps the image it chose
    const sync = () => {
      nav.hidden = max() <= 1;
      const all = stops();
      if (target !== null) {
        if (Math.abs(row.scrollLeft - all[target]) > 2) return;
        target = null;
        return;
      }
      if (Math.abs(row.scrollLeft - all[current]) <= 2) return;
      let index = 0;
      all.forEach((stop, i) => {
        if (stop <= row.scrollLeft + 2) index = i;
      });
      show(index);
    };

    nav.querySelectorAll<HTMLButtonElement>('[data-brand-step]').forEach((button) =>
      button.addEventListener('click', () => go(current + Number(button.dataset.brandStep))),
    );
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    row.addEventListener('keydown', (event) => {
      if (event.target !== row || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
      event.preventDefault();
      go(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    row.addEventListener('scroll', sync, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(sync).observe(row);
    row.querySelectorAll('img, video').forEach((media) =>
      media.addEventListener(media.tagName === 'IMG' ? 'load' : 'loadedmetadata', sync, { once: true }),
    );
    sync();
  });

  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-brand-video]')];

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Respect reduced motion: don't autoplay; give the viewer controls instead.
    videos.forEach((video) => {
      video.pause();
      video.controls = true;
    });
  } else {
    // Browsers pause muted autoplay video once it leaves view and don't reliably resume it
    // inside a sideways-scrolling row, so play only while visible.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const video = target as HTMLVideoElement;
        // If the browser still blocks autoplay (e.g. Low Power Mode), offer a play button instead of a frozen frame.
        if (isIntersecting) video.play().catch(() => (video.controls = true));
        else video.pause();
      });
    }, { root: viewRoot });
    videos.forEach((video) => observer.observe(video));
  }
</script>
