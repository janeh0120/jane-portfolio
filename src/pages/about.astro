---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const aboutImageSrc = `${base}images/about/about-me.jpg`;
---

<Layout title={`About | ${site.title}`} description={site.description}>
  <Header />
  <main class="mx-auto max-w-[1400px] px-6 pb-24 pt-10 md:px-10 md:pb-32 md:pt-14" data-comment-id="about-page">
    <article class="max-w-2xl" data-comment-id="about-bio">
      <figure class="about-media">
        <img
          src={aboutImageSrc}
          alt="Jane as a toddler in traditional Chinese attire"
          loading="lazy"
        />
      </figure>
      <div class="about-copy mt-8 space-y-2 md:mt-10">
        {site.about.paragraphs.map((paragraph) => <p class="text-body text-muted">{paragraph}</p>)}
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>

<style>
  .about-media {
    margin: 0;
  }

  .about-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-copy p {
    margin: 0;
  }
</style>
