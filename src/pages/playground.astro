---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

const twitterUrl = site.links.x;
const handle = twitterUrl.replace(/^https?:\/\/(x|twitter)\.com\//i, '').replace(/\/$/, '');
const timelineHref = `https://twitter.com/${handle}`;
---

<Layout title={`Playground | ${site.title}`} description="Experiments and scraps. Find me on X.">
  <Header />
  <main class="mx-auto max-w-[1400px] px-6 pb-24 pt-10 md:px-10 md:pt-14">
    <div class="max-w-2xl">
      <h1 class="case-study-heading text-ink">
        A place for experiments.
      </h1>
      <p class="mt-5 text-body text-muted">
        Half-formed ideas, visual scraps, and things that don’t fit the main grid yet, plus posts from
        <a
          href={twitterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-ink/30 underline-offset-4 transition hover:opacity-70"
        >
          @{handle}
        </a>.
      </p>
    </div>

    <section class="playground-feed mt-12 max-w-xl" aria-label={`Posts from @${handle}`}>
      <a
        class="twitter-timeline"
        href={timelineHref}
        data-height="720"
        data-chrome="noheader nofooter noborders transparent"
        data-tweet-limit="8"
      >
        Tweets by @{handle}
      </a>
    </section>
  </main>
  <SiteFooter />

  <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
</Layout>

<style>
  .playground-feed :global(iframe) {
    max-width: 100% !important;
  }
</style>
