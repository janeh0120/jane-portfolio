---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import { site } from '../data/site';
import MigrationReel from '../components/react/MigrationReel';

const email = site.email || 'janehoudesign@gmail.com';

const nav = [
  { label: 'Context', href: '#context' },
  { label: 'Role', href: '#role' },
  { label: 'Outcome', href: '#outcome' },
  { label: 'Feedback', href: '#feedback' },
];
---

<CaseStudyLayout
  title="Migration Dashboard"
  heading="Leading design of 0 → 1 internal tooling"
  role="Product Designer"
  company="Intuit"
  team="1 Product Manager, 3 Developers"
  timeline="March 2026 – August 2026"
  projectType="Product Design"
  nav={nav}
  commentId="case-study-migration"
>
  <MigrationReel slot="hero" client:visible />
  <section id="context" data-comment-id="migration-context">
    <h2 class="section-label">Context</h2>
    <p class="heading text-ink">
      An internal platform shipped in beta to help developers and technical program managers (TPMs)
      manage and run mass code migrations.
    </p>
  </section>

  <section id="role" data-comment-id="migration-role">
    <h2 class="section-label">Role</h2>
    <p class="heading text-ink">
      I joined as the sole designer, defining design direction and what success looked like.
    </p>
    <ol>
      <li>
        <h3>Navigating ambiguity</h3>
        <p>
          In an early-stage product, I established design’s position on the project with the team.
        </p>
      </li>
      <li>
        <h3>Leading research without researchers</h3>
        <p>I led user research when there weren’t dedicated researchers on the team.</p>
      </li>
      <li>
        <h3>Prototyping in code</h3>
        <p>
          I vibe-coded design iterations in code, branching from production to closely replicate the
          end-user experience.
        </p>
      </li>
      <li>
        <h3>Setting up what’s next</h3>
        <p>
          I laid the groundwork for future iteration and advocated for web analytics tracking so the
          team could gather a clearer baseline going forward.
        </p>
      </li>
    </ol>
  </section>

  <section id="outcome" data-comment-id="migration-outcome">
    <h2 class="section-label">Outcome</h2>
    <div class="case-study-stats">
      <div class="case-study-stat">
        <strong>10</strong>
        <span>user tests led with TPMs and engineers</span>
      </div>
      <div class="case-study-stat">
        <strong>6</strong>
        <span>core features delivered for implementation</span>
      </div>
      <div class="case-study-stat">
        <strong>~1 day</strong>
        <span>estimated time saved per customer project</span>
      </div>
    </div>
  </section>


  <section id="feedback" data-comment-id="migration-feedback">
    <h2 class="section-label">Feedback</h2>
    <div class="migration-quotes">
      <figure class="migration-quote">
        <blockquote>
          <p>Your impact was so high and valuable that it feels like you've been on the team for a long time and not just a few months.</p>
        </blockquote>
        <figcaption>PM</figcaption>
      </figure>

      <figure class="migration-quote">
        <blockquote>
          <p>Thank you for helping to solve one of the largest, painful, and underappreciated aspects of our work.</p>
        </blockquote>
        <figcaption>Prospective user</figcaption>
      </figure>

      <figure class="migration-quote">
        <blockquote>
          <p>You consistently went above and beyond—diving deep into user needs, iterating quickly on feedback, and delivering design work that made a real, measurable difference to the product experience.</p>
        </blockquote>
        <figcaption>Developer on the team</figcaption>
      </figure>
    </div>
  </section>

  <section data-comment-id="migration-nda">
    <aside class="migration-disclaimer" role="note" aria-label="Confidentiality note">
      <p>
        I can’t share the full details of this work publicly. If you’d like to learn more, email me
        at <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </aside>
  </section>
</CaseStudyLayout>

<style>
  #role ol {
    margin-top: var(--space-8);
  }

  /* Outcome numbers use the page title's .heading style */
  #outcome :global(.case-study-stat strong) {
    font: var(--type-heading);
    letter-spacing: var(--tracking-tight);
  }

  #outcome .migration-outcome-note {
    margin-top: var(--space-6);
  }

  /* Short pull quotes in cards: three columns, stacked on phones */
  .migration-quotes {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .migration-quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .migration-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
  }

  .migration-quote blockquote {
    margin: 0;
    padding: 0;
    border: none;
  }

  .migration-quote blockquote p {
    margin: 0;
    color: var(--color-ink);
    font: var(--type-quote);
    letter-spacing: var(--tracking-tight);
  }

  .migration-quote blockquote p + p {
    margin-top: var(--space-4);
  }

  .migration-quote blockquote p:first-child::before {
    content: '“';
  }

  .migration-quote blockquote p:last-child::after {
    content: '”';
  }

  /* Captions line up along the bottom of the row */
  .migration-quote figcaption {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-muted);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
  }

  .migration-disclaimer {
    padding: var(--space-4) 0;
    background: transparent;
  }

  .migration-disclaimer p {
    margin: 0;
    color: var(--color-muted);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
  }

  .migration-disclaimer a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: opacity 0.15s ease;
  }

  .migration-disclaimer a:hover {
    opacity: 0.7;
  }
</style>
