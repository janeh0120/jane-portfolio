---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import { site } from '../data/site';

const email = site.email || 'janeh0120@gmail.com';
---

<CaseStudyLayout
  title="Migration Dashboard"
  heading="Complex migrations shouldn't require experts."
  role="Product Designer"
  team="1 Product Manager, 3 Developers"
  timeline="March 2026-Present"
  projectType="Product Design"
  commentId="case-study-migration"
>
  <section data-comment-id="migration-summary">
    <p class="lead">
      Helping teams independently configure complex migration projects through a clearer and more
      scalable workflow.
    </p>
    <aside class="migration-disclaimer" role="note" aria-label="Work in progress">
      <p>
        This case study is still in progress. If you’d like to learn more, please
        <a href={`mailto:${email}`}>email me</a> for details.
      </p>
    </aside>
  </section>
</CaseStudyLayout>

<style>
  .migration-disclaimer {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-canvas);
  }

  .migration-disclaimer p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0;
  }

  .migration-disclaimer a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: opacity 0.15s ease;
  }

  .migration-disclaimer a:hover {
    opacity: 0.7;
  }
</style>
