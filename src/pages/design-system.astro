                    <span class="segmented-thumb" aria-hidden="true"></span>
                    <button type="button" class="segmented-option" aria-pressed="false" tabindex="-1">Web</button>
                    <button type="button" class="segmented-option" aria-pressed="true" tabindex="-1">Problems</button>
                  </div>
                </div>
                <div>
                  <p class="mb-3 text-body text-subtle">Focus</p>
                  <div class="segmented" role="group" aria-label="Example">
