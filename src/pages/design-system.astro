      </div>
    </section>


    <section id="motion" class={sectionClass} aria-labelledby="motion-title">
      <h2 id="motion-title" class={sectionTitleClass}>Motion</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        Quick and physical: things press in and slide.
      </p>
      <dl class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          motion.map((item) => (
            <div>
              <div class:list={['motion-stage showcase-card border border-border bg-surface p-6 sm:p-10', `is-${item.demo}`]} aria-hidden="true">
                {item.demo === 'menu' ? (
                  <div class="motion-menu">
                    <span class="motion-menu-highlight" />
                    <span class="motion-menu-row" />
                    <span class="motion-menu-row" />
                    <span class="motion-menu-row" />
                  </div>
                ) : item.demo === 'nav' ? (
                  <div class="motion-nav">
                    <span class="motion-nav-logo" />
                    <span class="motion-nav-links">
                      <span />
                      <span />
                      <span />
                    </span>
                    <span class="motion-nav-button" />
                  </div>
                ) : item.demo === 'mode' ? (
                  <>
                    <span class="motion-mode" />
                    <span class="motion-square" />
                    <span class="motion-mode-blur" />
                  </>
                ) : item.demo === 'overlay' ? (
                  <>
                    <span class="motion-backdrop" />
                    <span class="motion-square" />
                  </>
                ) : (
                  <span class="motion-square" />
                )}
              </div>
              <dt class="mt-3 text-body font-medium text-ink">{item.name}</dt>
              <dd class="mt-1 text-body text-muted">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  /* Component specimens: not usable; a layer on top catches the pointer for Inspect mode */
  :global(.ds-specimen) {
    position: relative;
  }

  :global(.ds-specimen *) {
    pointer-events: none;
  }

  :global(.inspect-layer) {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: auto;
  }

  /* Inspect mode: dashed outlines show what can be inspected */
  #components[data-inspect='on'] :global(.inspect-layer) {
    cursor: crosshair;
  }

  #components[data-inspect='on'] :global(.ds-specimen :is(.button, .icon-control, .dropdown-trigger, .dropdown-menu, .tag, .text-link, .section-nav-link, .segmented, .comment-sidebar-card, .carousel-nav, .specular-button):not(.is-focus)) {
    outline: 1px dashed color-mix(in srgb, var(--color-accent) 50%, transparent);
    outline-offset: 2px;
  }

  /* Inspect overlay, in the style of Figma's dev mode. Above everything in the specimens,
     including the open dropdown menu (z-index 10100). */
  :global(.inspect-overlay) {
    position: fixed;
    inset: 0;
    z-index: 10200;
    pointer-events: none;
  }

  :global(.inspect-overlay[hidden]),
  :global(.inspect-overlay [hidden]),
  :global(.inspect-panel[hidden]) {
    display: none;
  }

  /* The selected element */
  :global(.inspect-box) {
    position: fixed;
    outline: 1px solid var(--color-accent);
  }

  /* Padding: a red line across each padded side, with its size in a badge */
  :global(.inspect-measure) {
    position: fixed;
    border-color: var(--color-measure);
    border-style: solid;
    border-width: 0;
  }

  :global(.inspect-measure[data-side='top']),
  :global(.inspect-measure[data-side='bottom']) {
    border-left-width: 1px;
  }

  :global(.inspect-measure[data-side='left']),
  :global(.inspect-measure[data-side='right']) {
    border-top-width: 1px;
  }

  :global(.inspect-badge) {
    position: fixed;
    padding: 2px var(--space-1);
    border-radius: var(--radius-base);
    background: var(--color-measure);
    color: var(--color-on-measure);
    font: var(--type-count);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* The callout's dotted leader and its pin on the element */
  :global(.inspect-leader) {
    position: fixed;
    border-top: 1px dashed var(--color-pin);
  }

  :global(.inspect-pin) {
    position: fixed;
    border-radius: var(--radius-pill);
    background: var(--color-pin);
    box-shadow: 0 0 0 2px var(--color-canvas);
  }

  /* The callout card */
  :global(.inspect-panel) {
    position: fixed;
    z-index: 10201;
    min-width: 14rem;
    max-width: 24rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-menu);
    background: var(--color-canvas);
    box-shadow: var(--shadow-floating);
    pointer-events: none;
  }

  :global(.inspect-swatch) {
    display: inline-block;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    border: var(--border-width) solid var(--color-hairline);
    border-radius: var(--radius-base);
  }

  .ds-mode-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  /* Bold (the font has no 500), so the part name stands above the rows */
  :global(.inspect-panel-title) {
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
    font: var(--type-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-body);
  }

  :global(.inspect-panel dl) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
    margin: 0;
    font: var(--type-compact);
    letter-spacing: var(--tracking-body);
  }

  :global(.inspect-panel dt) {
    color: var(--color-muted);
  }

  :global(.inspect-panel dd) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  :global(.inspect-panel-note) {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font: var(--type-compact);
    letter-spacing: var(--tracking-body);
  }

  :global(.inspect-panel dd.is-untokened) {
    color: var(--color-danger);
  }

  /* Motion previews: a square in a small stage, looping each animation with the site's real
     durations and easings. Still for visitors who prefer reduced motion. */
  /* Uses the standard preview card (showcase-card); this only sizes the stage */
  .motion-stage {
    --stage-pad: var(--space-6);
    position: relative;
    display: grid;
    place-items: center;
    height: 11rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .motion-stage {
      --stage-pad: var(--space-10);
    }
  }

  .motion-square {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-base);
    background: var(--color-ink);
  }

  /* Press: down in 0.15s, held, back up */
  .is-press .motion-square {
    animation: motion-press 2s ease infinite;
  }

  @keyframes motion-press {
    0%, 25% { transform: scale(1); }
    32.5%, 55% { transform: scale(0.92); }
    62.5%, 100% { transform: scale(1); }
  }

  /* Hover: fill to hover colour in 0.15s, and back */
  .is-hover .motion-square {
    background: var(--color-fill);
    animation: motion-hover 3s ease infinite;
  }

  @keyframes motion-hover {
    0%, 45% { background: var(--color-fill); }
    50%, 95% { background: var(--color-ink); }
    100% { background: var(--color-fill); }
  }

  /* Menus: the panel fades in (0.12s), then the highlight slides between options (0.2s) */
  .motion-menu {
    position: relative;
    display: grid;
    gap: var(--space-1);
    width: 6rem;
    padding: var(--space-1);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-menu);
    background: var(--color-canvas);
    box-shadow: var(--shadow-floating);
    animation: motion-menu 3s ease infinite;
  }

  .motion-menu-row {
    position: relative;
    height: 0.875rem;
    margin: var(--space-1) var(--space-2);
    border-radius: var(--radius-base);
    background: var(--color-fill);
  }

  .motion-menu-highlight {
    position: absolute;
    top: var(--space-1);
    left: var(--space-1);
    right: var(--space-1);
    height: calc(0.875rem + var(--space-2));
    border-radius: var(--radius-base);
    background: var(--color-hover-subtle);
    animation: motion-menu-highlight 3s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes motion-menu {
    0% { opacity: 0; transform: translateY(-2px); }
    4%, 90% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-2px); }
  }

  @keyframes motion-menu-highlight {
    0%, 30% { transform: translateY(0); }
    37%, 60% { transform: translateY(calc(100% + var(--space-1))); }
    67%, 100% { transform: translateY(calc(200% + var(--space-2))); }
  }

  /* Nav bar: the links' column folds away and returns (0.7s, ease in and out) */
  .motion-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: fit-content;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-hairline);
    border-radius: var(--radius-panel);
    background: var(--color-glass);
  }

  .motion-nav-logo {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }

  .motion-nav-links {
    display: flex;
    gap: var(--space-2);
    width: 5.5rem;
    overflow: hidden;
    animation: motion-nav 4s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  .motion-nav-links span {
    flex-shrink: 0;
    width: 1.5rem;
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--color-subtle);
  }

  .motion-nav-button {
    width: 2.5rem;
    height: 1rem;
    border-radius: var(--radius-base);
    background: var(--color-accent);
  }

  @keyframes motion-nav {
    0%, 20% { width: 5.5rem; opacity: 1; }
    37.5%, 70% { width: 0; opacity: 0; }
    87.5%, 100% { width: 5.5rem; opacity: 1; }
  }

  /* Reveal: rises 1.5rem and fades in (about 0.9s), then resets */
  .is-reveal .motion-square {
    animation: motion-reveal 3s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes motion-reveal {
    0% { opacity: 0; transform: translateY(1.5rem); }
    30%, 85% { opacity: 1; transform: none; }
    95%, 100% { opacity: 0; transform: translateY(1.5rem); }
  }

  /* Media overlay: a small tile grows to the centre as the backdrop fades in (0.46s), then back */
  .is-overlay {
    place-items: start;
  }

  .is-overlay::before {
    content: '';
    position: absolute;
    top: var(--stage-pad);
    left: var(--stage-pad);
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-base);
    background: var(--color-fill);
  }

  .motion-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
    animation: motion-backdrop 3s cubic-bezier(0.3, 0.7, 0.2, 1) infinite;
  }

  .is-overlay .motion-square {
    position: absolute;
    top: var(--stage-pad);
    left: var(--stage-pad);
    width: 1.5rem;
    height: 1.5rem;
    animation: motion-overlay 3s cubic-bezier(0.3, 0.7, 0.2, 1) infinite;
  }

  @keyframes motion-backdrop {
    0%, 15% { opacity: 0; }
    30%, 65% { opacity: 1; }
    80%, 100% { opacity: 0; }
  }

  @keyframes motion-overlay {
    0%, 15% { top: var(--stage-pad); left: var(--stage-pad); width: 1.5rem; height: 1.5rem; }
    30%, 65% { top: calc(50% - 2.25rem); left: calc(50% - 2.25rem); width: 4.5rem; height: 4.5rem; }
    80%, 100% { top: var(--stage-pad); left: var(--stage-pad); width: 1.5rem; height: 1.5rem; }
  }

  /* Colour mode: the new mode's colour rises behind a soft edge with a blur riding it (the
     site's theme-wipe, 1.1s ease in and out), holds, then fades back */
  .motion-mode,
  .motion-mode-blur {
    position: absolute;
    inset: 0;
    animation: motion-mode 4s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  .motion-mode {
    background: var(--color-ink);
    mask-image: linear-gradient(to top, #000 calc(var(--theme-wipe) - 35%), transparent var(--theme-wipe));
  }

  .is-mode .motion-square {
    position: relative;
    background: var(--color-fill);
  }

  .motion-mode-blur {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to top, transparent calc(var(--theme-wipe) - 40%), #000 calc(var(--theme-wipe) - 18%), transparent calc(var(--theme-wipe) + 4%));
  }

  @keyframes motion-mode {
    0%, 15% { --theme-wipe: -15%; opacity: 1; }
    42.5%, 85% { --theme-wipe: 150%; opacity: 1; }
    95% { --theme-wipe: 150%; opacity: 0; }
    100% { --theme-wipe: -15%; opacity: 0; }
  }

  /* Reduced motion: the same change as Reveal, but instant */
  .is-reduced .motion-square {
    animation: motion-reduced 3s step-end infinite;
  }

  @keyframes motion-reduced {
    0% { opacity: 0; }
    30% { opacity: 1; }
    85% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-stage *,
    .motion-stage::before {
      animation: none !important;
    }
  }

  /* Stand-ins for the media overlay and for media under a floating control */
  .media-demo {
    border-radius: var(--radius-base);
    background: center / cover no-repeat;
  }


  .overlay-demo .gallery-carousel-slide img {
    max-width: 100%;
    max-height: 18rem;
  }


  main :global(.border) {
    border-radius: var(--radius-base);
  }

  /* Rounder than the controls inside; not tied to the padding */
  main .showcase-card {
    border-radius: calc(var(--radius-base) + 1rem);
  }

  @media (min-width: 640px) {
    main .showcase-card {
      border-radius: calc(var(--radius-base) + 1.5rem);
    }
  }
</style>

<script type="application/json" id="design-tokens" set:html={JSON.stringify(tokenNames)} />

<script>
  import { attachDropdownHighlight } from '../lib/dropdown';
  import { startTokenInspector } from '../lib/token-inspector';

  document
    .querySelectorAll<HTMLElement>('[data-dropdown-preview]')
    .forEach((menu) => attachDropdownHighlight(menu));

  // Component previews are specimens: not usable, and inspectable in Inspect mode
  const components = document.getElementById('components');
  const specimens = [...(components?.querySelectorAll<HTMLElement>('.showcase-card, .overlay-demo, .media-demo') ?? [])];
  const inspector = startTokenInspector({
    specimens,
    tokens: JSON.parse(document.getElementById('design-tokens')?.textContent ?? '[]'),
    parts: [
      { selector: '.segmented-option', name: 'Segmented option' },
      { selector: '.segmented-thumb', name: 'Segmented thumb' },
      { selector: '.segmented', name: 'Segmented toggle' },
      { selector: '.specular-button', name: 'Primary button', exempt: 'Its WebGL shine reads the accent token at runtime; the shadow is the inset highlight that is part of the effect.' },
      { selector: '.button.is-secondary', name: 'Secondary button' },
      { selector: '.button.is-tertiary', name: 'Tertiary button' },
      { selector: '.button', name: 'Button' },
      { selector: '.icon-control', name: 'Icon control' },
      { selector: '.dropdown-trigger:not(.dropdown-native)', name: 'Dropdown trigger' },
      { selector: '.dropdown-option', name: 'Dropdown option' },
      { selector: '.dropdown-menu', name: 'Dropdown menu' },
      { selector: '.tag', name: 'Tag' },
      { selector: '.text-link', name: 'Link' },
      { selector: '.section-nav-link', name: 'Section nav link' },
      { selector: '.comment-sidebar-card-category-select', name: 'Comment category' },
      { selector: '.comment-sidebar-card-body-input', name: 'Comment edit field', exempt: 'The shadow is a 2px accent-soft ring, the same selection ring as an active card.' },
      { selector: '.comment-sidebar-card-error', name: 'Comment error', exempt: 'The border is the danger colour at 35%, mixed from its token.' },
      { selector: '.comment-sidebar-card-meta', name: 'Comment details' },
      { selector: '.comment-sidebar-card-title', name: 'Comment title' },
      { selector: '.comment-sidebar-card-body', name: 'Comment text' },
      { selector: '.comment-sidebar-card', name: 'Comment card', exempt: 'Hovered, the shadow is shadow-raised; active, it is a 2px accent-soft selection ring.' },
      { selector: '.carousel-dot', name: 'Slide dot' },
      { selector: '.carousel-controls', name: 'Slide dots' },
      { selector: '.carousel-nav', name: 'Carousel nav' },
      { selector: '.gallery-modal-description', name: 'Caption' },
      { selector: '.gallery-carousel-slide img', name: 'Image' },
    ],
  });

  const toggle = document.querySelector<HTMLElement>('[data-inspect-toggle]');
  const choices = [...(toggle?.querySelectorAll<HTMLButtonElement>('[data-inspect-choice]') ?? [])];
  choices.forEach((choice) =>
    choice.addEventListener('click', () => {
      const on = choice.dataset.inspectChoice === 'inspect';
      choices.forEach((each) => each.setAttribute('aria-pressed', String(each === choice)));
      if (components) components.dataset.inspect = on ? 'on' : 'off';
      inspector.setInspecting(on);
    }),
  );
</script>
