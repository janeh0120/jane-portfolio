                  [
                    { state: 'Default', card: '' },
                    { state: 'Hover', card: 'is-hover' },
                    { state: 'Active', card: 'is-active' },
                    { state: 'Admin review', card: '', meta: true },
                  ].map((cell) => (
                    <div>
                      <p class="mb-3 text-body text-subtle">{cell.state}</p>
                      <article class:list={['comment-sidebar-card comment-sidebar-card--readonly', cell.card]}>
