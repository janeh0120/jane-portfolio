                </div>
                <div>
                  <p class="mb-3 text-body text-subtle">Active</p>
                  <IconControl label="Close" icon="x" class="is-dismiss is-hover is-pressed" />
                </div>
                <div>
                  <p class="mb-3 text-body text-subtle">Focus</p>
