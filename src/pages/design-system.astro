---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SidebarNav from '../components/SidebarNav.astro';
import IconControl from '../components/IconControl.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import LeaveFeedbackButton from '../components/react/LeaveFeedbackButton';
import SpecularButton from '../components/react/SpecularButton';
import { site } from '../data/site';

const sections = [
  { id: 'colors', label: 'Colors' },
  { id: 'typography', label: 'Typography' },
  { id: 'layout', label: 'Layout' },
  { id: 'borders', label: 'Borders' },
  { id: 'radius', label: 'Radius' },
  { id: 'buttons', label: 'Buttons' },
  { id: 'icon-control', label: 'Icon control' },
  { id: 'dropdown', label: 'Dropdown' },
  { id: 'tag', label: 'Tag' },
  { id: 'links', label: 'Links' },
];

const dropdownOptions = ['Category', 'Accessibility', 'Content', 'Visual design', 'Bug'];

const colors = [
  { use: 'Page background', token: '--color-canvas', outline: true },
  { use: 'Primary text', token: '--color-ink' },
  { use: 'Secondary text', token: '--color-muted' },
  { use: 'Tertiary text', token: '--color-subtle' },
  { use: 'Dividers', token: '--color-line', outline: true },
  { use: 'Panels', token: '--color-surface' },
  { use: 'Outlines', token: '--color-border' },
  { use: 'Control fill', token: '--color-fill' },
  { use: 'Hover', token: '--color-hover' },
  { use: 'Subtle hover', token: '--color-hover-subtle', outline: true },
  { use: 'Floating surface', token: '--color-glass', outline: true },
  { use: 'Accent', token: '--color-accent' },
  { use: 'Selected · focus fill', token: '--color-accent-soft', outline: true },
  { use: 'Errors', token: '--color-danger' },
  { use: 'Error background', token: '--color-danger-soft', outline: true },
];

const typeStyles = [
  {
    className: 'hero-copy',
    label: 'Display',
    sample: site.hero.headline,
  },
  {
    className: 'heading',
    label: 'Heading',
    sample: 'A design community shouldn’t graduate without a shared experience.',
  },
  {
    className: 'subheading',
    label: 'Subheading',
    sample: 'Intuit Design System',
  },
  {
    className: 'text-body',
    label: 'Body',
    sample:
      'I love when design can bridge the intersection between solving technical and people problems.',
  },
];

const borders = [
  {
    name: 'Line',
    token: '--color-line',
    detail: '1px · portfolio dividers',
  },
  {
    name: 'Border',
    token: '--color-border',
    detail: '1px · inputs · cards',
  },
  {
    name: 'Border strong',
    token: '--color-border-strong',
    detail: '1px · higher contrast',
  },
];

const radii = [
  { name: 'None', token: '--radius-none', detail: '0 · full-bleed frames' },
  { name: 'Corner', token: '--radius-base', detail: '0.5rem · controls and cards' },
];

const widths = [
  { name: 'Site', px: 1400 },
  { name: 'Case study', px: 768 },
  { name: 'About', px: 672 },
];

const breakpoints = [
  { name: 'Mobile', px: 0 },
  { name: 'Tablet', px: 768 },
  { name: 'Comments stack', px: 900 },
  { name: 'Desktop', px: 1024 },
];

const sectionClass = 'scroll-mt-28 md:scroll-mt-32';
const sectionTitleClass = 'subheading text-ink';
---

<Layout title={`Design system | ${site.title}`} description="Color, type, and patterns used across this portfolio.">
  <Header />
  <main class="page-frame pb-24 pt-6 md:pt-8">
    <div class="grid gap-8 lg:grid-cols-[200px_1fr] lg:gap-20">
      <SidebarNav
        nav={sections.map((item) => ({ label: item.label, href: `#${item.id}` }))}
        ariaLabel="Design system sections"
      />

      <div class="section-stack min-w-0">
        <div>
          <h1 class="hero-copy text-ink">Design system</h1>
          <p class="mt-3 max-w-[58ch] text-body text-muted">
            Built with Astro, Tailwind, and React and adapted to light and dark mode.
          </p>
        </div>

    <section id="colors" class={sectionClass} aria-labelledby="colors-title">
      <h2 id="colors-title" class={sectionTitleClass}>Colors</h2>
      <ul class="mt-8 grid list-none grid-cols-1 gap-x-8 gap-y-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          colors.map((swatch) => (
            <li class="flex min-w-0 items-center gap-3">
              <div
                class:list={['size-10 shrink-0', swatch.outline && 'border border-border-strong']}
                style={`background: var(${swatch.token}); border-radius: var(--radius-base)`}
                aria-hidden="true"
              />
              <p class="text-body text-muted">{swatch.use}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="typography" class={sectionClass} aria-labelledby="typography-title">
      <h2 id="typography-title" class={sectionTitleClass}>Typography</h2>
      <div class="mt-8 grid gap-12">
        {
          typeStyles.map((item) => (
            <div>
              <p class="text-body font-medium text-muted">{item.label}</p>
              <div class:list={[item.className, 'mt-4 text-ink']}>{item.sample}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="layout" class={sectionClass} aria-labelledby="layout-title">
      <h2 id="layout-title" class={sectionTitleClass}>Layout</h2>
      <div class="mt-8 grid gap-16">
        <div>
          <p class="text-body font-medium text-muted">Page widths</p>
          <div class="mt-4 grid gap-3 border border-border bg-surface p-3 sm:p-4" aria-hidden="true">
            {
              widths.map((item) => (
                <div
                  class="border border-dashed border-border-strong bg-canvas flex justify-between gap-3 px-3 py-3 text-body"
                  style={`width: ${(item.px / 1400) * 100}%`}
                >
                  <span class="text-muted">{item.name}</span>
                  <span class="text-subtle">{item.px}px</span>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <p class="text-body font-medium text-muted">Breakpoints</p>
          <div class="mt-4 grid grid-cols-4 border border-border bg-surface" aria-hidden="true">
            {
              breakpoints.map((item, index) => (
                <div class:list={['px-3 py-3', index > 0 && 'border-l border-dashed border-border-strong']}>
                  <p class="text-body text-muted">{item.name}</p>
                  <p class="text-body text-subtle">{item.px === 0 ? '0' : `${item.px}px`}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <p class="text-body font-medium text-muted">Case study</p>
          <div class="mt-4 grid gap-6 sm:grid-cols-[2fr_1fr]">
            <div>
              <p class="mb-2 text-body text-subtle">Desktop</p>
              <div class="grid grid-cols-[72px_1fr] gap-3 border border-border bg-surface p-3 sm:grid-cols-[96px_1fr] sm:p-4" aria-hidden="true">
                <div class="border border-dashed border-border-strong bg-canvas px-2 py-6 text-center text-body text-subtle">Nav</div>
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-6 text-center text-body text-subtle">Article</div>
              </div>
            </div>
            <div>
              <p class="mb-2 text-body text-subtle">Mobile</p>
              <div class="grid gap-3 border border-border bg-surface p-3 sm:p-4" aria-hidden="true">
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-2 text-center text-body text-subtle">Nav</div>
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-6 text-center text-body text-subtle">Article</div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <p class="text-body font-medium text-muted">Comment mode</p>
          <div class="mt-4 grid gap-6 sm:grid-cols-[2fr_1fr]">
            <div>
              <p class="mb-2 text-body text-subtle">Desktop</p>
              <div class="grid grid-cols-[1fr_72px] gap-3 border border-border bg-surface p-3 sm:grid-cols-[1fr_96px] sm:p-4" aria-hidden="true">
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-6 text-center text-body text-subtle">Site</div>
                <div class="border border-dashed border-border-strong bg-canvas px-2 py-6 text-center text-body text-subtle">Comments</div>
              </div>
            </div>
            <div>
              <p class="mb-2 text-body text-subtle">Mobile</p>
              <div class="grid gap-3 border border-border bg-surface p-3 sm:p-4" aria-hidden="true">
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-6 text-center text-body text-subtle">Site</div>
                <div class="border border-dashed border-border-strong bg-canvas px-3 py-2 text-center text-body text-subtle">Comments</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="borders" class={sectionClass} aria-labelledby="borders-title">
      <h2 id="borders-title" class={sectionTitleClass}>Borders</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        The nav bar, comment cards, and page frame use a 0.5px border. Dividers and inputs stay
        1px.
      </p>
      <div
        class="mt-6 h-16 w-40 bg-canvas"
        style="border: var(--border-width) solid var(--color-hairline); border-radius: var(--radius-base)"
        aria-hidden="true"
      ></div>
      <ul class="mt-8 grid list-none grid-cols-2 gap-x-6 gap-y-10 p-0 sm:grid-cols-3">
        {
          borders.map((item) => (
            <li class="grid justify-items-start gap-4">
              <div>
                <p class="text-body font-medium text-muted">{item.name}</p>
                <p class="mt-1 text-body text-muted">{item.detail}</p>
              </div>
              <div
                class="size-20 bg-canvas"
                style={`border: 2px solid var(${item.token}); border-radius: var(--radius-base)`}
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="radius" class={sectionClass} aria-labelledby="radius-title">
      <h2 id="radius-title" class={sectionTitleClass}>Radius</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        Controls, cards, and media use one corner. A shell around a nested control adds its padding
        to that radius, so the two curves share a center. In comment mode the page frame corner is
        the nav radius plus the space between the frame edge and the nav.
      </p>
      <ul class="mt-8 grid list-none grid-cols-2 gap-x-6 gap-y-10 p-0 sm:grid-cols-3 lg:grid-cols-6">
        {
          radii.map((item) => (
            <li class="grid justify-items-start gap-4">
              <div>
                <p class="text-body font-medium text-muted">{item.name}</p>
                <p class="mt-1 text-body text-muted">{item.detail}</p>
              </div>
              <div
                class="size-20 bg-surface"
                style={`border-radius: var(${item.token})`}
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="buttons" class={sectionClass} aria-labelledby="buttons-title">
      <h2 id="buttons-title" class={sectionTitleClass}>Buttons</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        Leave feedback is the site's one call to action. Use it to invite visitors to comment on the
        page.
      </p>
      <div class="mt-8 showcase-card border border-border bg-surface p-6 sm:p-10">
        <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
          <div>
            <p class="mb-3 text-body text-subtle">Default</p>
            <LeaveFeedbackButton client:load />
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Hover</p>
            <LeaveFeedbackButton client:load previewState="hover" />
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Active</p>
            <LeaveFeedbackButton client:load previewState="active" />
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Focus</p>
            <LeaveFeedbackButton client:load previewState="focus" />
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Disabled</p>
            <LeaveFeedbackButton client:load previewState="disabled" />
          </div>
        </div>
      </div>
      <p class="mt-8 max-w-[58ch] text-body text-muted">
        Text buttons are for lower-emphasis actions, like Back. Use tertiary when the button sits in
        the page flow, and secondary when it floats over content.
      </p>
      <div class="mt-6 grid gap-10 showcase-card border border-border bg-surface p-6 sm:p-10 [&>div+div]:border-t [&>div+div]:border-line [&>div+div]:pt-10">
        <div>
          <p class="mb-5 text-body font-medium text-ink">Tertiary</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <button type="button" class="button is-tertiary">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <button type="button" class="button is-tertiary is-hover" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <button type="button" class="button is-tertiary is-hover is-pressed" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <button type="button" class="button is-tertiary is-focus" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
          </div>
        </div>
        <div>
          <p class="mb-5 text-body font-medium text-ink">Secondary</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <button type="button" class="button is-secondary">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <button type="button" class="button is-secondary is-hover" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <button type="button" class="button is-secondary is-hover is-pressed" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <button type="button" class="button is-secondary is-focus" tabindex="-1">
                <ArrowIcon direction="left" size="0.9em" />
                Back
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="icon-control" class={sectionClass} aria-labelledby="icon-control-title">
      <h2 id="icon-control-title" class={sectionTitleClass}>Icon control</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        For compact actions where the icon speaks for itself, like opening the menu. Use dismiss to
        close something, primary for the one main action in a surface, and destructive for actions
        that delete something.
      </p>
      <div class="mt-8 grid gap-10 showcase-card border border-border bg-surface p-6 sm:p-10 [&>div+div]:border-t [&>div+div]:border-line [&>div+div]:pt-10">
        <div>
          <p class="mb-5 text-body font-medium text-ink">Standard</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <IconControl label="Open menu" icon="menu" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <IconControl label="Open menu" icon="menu" class="is-hover" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <IconControl label="Open menu" icon="menu" class="is-hover is-pressed" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <IconControl label="Open menu" icon="menu" class="is-focus" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Selected</p>
              <IconControl label="Close menu" icon="x" aria-pressed="true" />
            </div>
          </div>
        </div>
        <div>
          <p class="mb-5 text-body font-medium text-ink">Dismiss</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <IconControl label="Close" icon="x" class="is-dismiss" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <IconControl label="Close" icon="x" class="is-dismiss is-hover" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <IconControl label="Close" icon="x" class="is-dismiss is-hover is-pressed" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <IconControl label="Close" icon="x" class="is-dismiss is-focus" />
            </div>
          </div>
        </div>
        <div>
          <p class="mb-5 text-body font-medium text-ink">Primary</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <IconControl label="Post comment" icon="arrow-right" class="is-primary" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <IconControl label="Post comment" icon="arrow-right" class="is-primary is-hover" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <IconControl label="Post comment" icon="arrow-right" class="is-primary is-hover is-pressed" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <IconControl label="Post comment" icon="arrow-right" class="is-primary is-focus" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Disabled</p>
              <IconControl label="Post comment" icon="arrow-right" class="is-primary" disabled />
            </div>
          </div>
        </div>
        <div>
          <p class="mb-5 text-body font-medium text-ink">Destructive</p>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] items-start gap-x-10 gap-y-10">
            <div>
              <p class="mb-3 text-body text-subtle">Default</p>
              <IconControl label="Delete comment" icon="x" class="is-dismiss is-destructive" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Hover</p>
              <IconControl label="Delete comment" icon="x" class="is-dismiss is-destructive is-hover" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Active</p>
              <IconControl label="Delete comment" icon="x" class="is-dismiss is-destructive is-hover is-pressed" />
            </div>
            <div>
              <p class="mb-3 text-body text-subtle">Focus</p>
              <IconControl label="Delete comment" icon="x" class="is-dismiss is-destructive is-focus" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="dropdown" class={sectionClass} aria-labelledby="dropdown-title">
      <h2 id="dropdown-title" class={sectionTitleClass}>Dropdown</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        For picking one option from a short list, like a comment's category or the color mode.
      </p>
      <div class="mt-8 showcase-card border border-border bg-surface p-6 sm:p-10">
        <div class="flex flex-wrap items-start gap-x-14 gap-y-10">
          <div>
            <p class="mb-3 text-body text-subtle">Default</p>
            <select class="dropdown-trigger" data-dropdown aria-label="Category">
              {dropdownOptions.map((option, index) => (
                <option value={index === 0 ? '' : option}>{option}</option>
              ))}
            </select>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Hover</p>
            <button type="button" class="dropdown-trigger is-hover" tabindex="-1">Category</button>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Active</p>
            <button type="button" class="dropdown-trigger is-pressed" tabindex="-1">Category</button>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Focus</p>
            <button type="button" class="dropdown-trigger is-focus" tabindex="-1">Category</button>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Disabled</p>
            <button type="button" class="dropdown-trigger" disabled>Category</button>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Open</p>
            <button type="button" class="dropdown-trigger" aria-expanded="true" tabindex="-1">
              Visual design
            </button>
            <div class="dropdown-menu relative mt-1.5" role="presentation" data-dropdown-preview>
              {dropdownOptions.map((option) => (
                <div
                  class:list={['dropdown-option', { 'is-active': option === 'Content' }]}
                  aria-selected={option === 'Visual design' ? 'true' : 'false'}
                >
                  <span class="dropdown-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <span>{option}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="tag" class={sectionClass} aria-labelledby="tag-title">
      <h2 id="tag-title" class={sectionTitleClass}>Tag</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        For showing a value that can't be changed, like a comment's category. Use count for a number
        next to a label, like the total on a tab.
      </p>
      <div class="mt-8 showcase-card border border-border bg-surface p-6 sm:p-10">
        <div class="flex flex-wrap items-start gap-x-14 gap-y-10">
          <div>
            <p class="mb-3 text-body text-subtle">Tag</p>
            <span class="tag">Accessibility</span>
          </div>
          <div>
            <p class="mb-3 text-body text-subtle">Count</p>
            <span class="tag is-count text-ink">6</span>
          </div>
        </div>
      </div>
    </section>

    <section id="links" class={sectionClass} aria-labelledby="links-title">
      <h2 id="links-title" class={sectionTitleClass}>Links</h2>
      <p class="mt-3 max-w-[58ch] text-body text-muted">
        For moving between pages in the header, footer, and body copy. Selected marks the page you're
        on, and copied confirms something was copied to the clipboard.
      </p>
