              <div class="grid grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] items-start gap-x-10 gap-y-10">
                {
                  [
                    { state: 'Default', card: '', body: '' },
                    { state: 'Hover', card: 'is-hover', body: '' },
                    { state: 'Text hover', card: 'is-hover', body: 'is-hover' },
                    { state: 'Active', card: 'is-active', body: '' },
                    { state: 'Editing', card: 'is-active is-editing-comment', body: '', editing: true },
                    { state: 'Error', card: 'is-active is-editing-comment', body: '', editing: true, error: true },
                  ].map((cell) => (
                    <div>
                      <p class="mb-3 text-body text-subtle">{cell.state}</p>
                      <article class:list={['comment-sidebar-card', cell.card]}>
                        <div class="comment-sidebar-card-header">
                          <button type="button" class="comment-sidebar-card-category-select" tabindex="-1">Visual design</button>
                          <IconControl label="Delete comment" icon="x" class="is-dismiss is-destructive comment-sidebar-card-delete" tabindex="-1" />
                        </div>
                        <p class="comment-sidebar-card-title">Hero image</p>
                        {cell.editing ? (
                          <textarea class="comment-sidebar-card-body-input" rows="3" tabindex="-1" readonly>{'The contrast on this caption is a little low.'}</textarea>
                        ) : (
                          <p class:list={['comment-sidebar-card-body', cell.body]}>The contrast on this caption is a little low.</p>
