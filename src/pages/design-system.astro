        <section id="comments" class={sectionClass} aria-labelledby="comments-title">
          <h3 id="comments-title" class={sectionTitleClass}>Comments</h3>
          <p class="mt-3 max-w-[58ch] text-body text-muted">
            A comment's category, the element it's about, and the text. Your own comments can be
