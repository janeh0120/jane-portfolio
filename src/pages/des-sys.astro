---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import { site } from '../data/site';

const email = site.email || 'janeh0120@gmail.com';
---

<CaseStudyLayout
  title="Design Systems"
  heading="Design and code shouldn't fall out of sync."
  role="Product Designer"
  team="Intuit Design Systems"
  timeline="Jan 2026 – Present"
  projectType="Product, Design Systems"
  commentId="case-study-des-sys"
>
  <section id="outline" data-comment-id="des-sys-outline" class="des-sys-outline">
    <p class="lead">
      Through working on a product, I became a customer of the Intuit Design System (IDS)—and
      started seeing where it fell short in real use.
    </p>
    <p>
      I identified gaps in the system, documented them clearly, and carried the fixes through so
      design and code could stay aligned for the teams relying on IDS.
    </p>
  </section>

  <section data-comment-id="des-sys-nda">
    <aside class="des-sys-disclaimer" role="note" aria-label="NDA notice">
      <p>
        I’m not able to publicize this work due to an NDA. If you’d like to learn more, please
        <a href={`mailto:${email}`}>contact me personally</a> for details.
      </p>
    </aside>
  </section>
</CaseStudyLayout>

<style>
  .des-sys-disclaimer {
    padding: 1rem 0;
    background: transparent;
  }

  .des-sys-disclaimer p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0;
  }

  .des-sys-disclaimer a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: opacity 0.15s ease;
  }

  .des-sys-disclaimer a:hover {
    opacity: 0.7;
  }

  .des-sys-outline p + p {
    margin-top: 1em;
  }
</style>
