---
// The Intuit design system audit, in Jane's own words from her draft (grammar fixes only): context,
// problems, the manual audit, the AI skill, the documentation opportunity, final solution, impact,
// and reflection. Visuals sit where they illustrate each point. This is the version the homepage card links to; /des-sys is the older combined one.
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import AuditSkillFlow from '../components/des-sys/AuditSkillFlow.astro';
import AuditReviewLoop from '../components/des-sys/AuditReviewLoop.astro';
import TokenCompare from '../components/des-sys/TokenCompare.astro';
import ProblemVisual from '../components/des-sys/ProblemVisual.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';

const nav = [
  { label: 'Context', href: '#context' },
  { label: 'Problem', href: '#problem' },
  { label: 'Solution', href: '#solution' },
  { label: 'Opportunity: AI', href: '#opportunity' },
  { label: 'New Solution', href: '#new-solution' },
  { label: 'Opportunity: Docs', href: '#opportunity-docs' },
  { label: 'Final Solution', href: '#final' },
  { label: 'Impact', href: '#impact' },
  { label: 'Reflection', href: '#reflection' },
];
---

<CaseStudyLayout
  title="Design System Audit"
  heading="Auditing an enterprise design system with AI"
  role="Product Design Intern"
  company="Intuit Design System"
  team="Sole designer, 1 developer, guidance from 2 designers"
  timeline="Jan – Mar 2026"
  projectType="Design Systems"
  nav={nav}
  commentId="case-study-des-sys-audit"
  heroImage={{
    src: 'images/case-study-heroes/dessys.png',
    alt: 'A checkbox component with its label annotated with the --text-primary colour and --font-weight-component tokens',
    wide: true,
  }}
>
  <section id="context" data-comment-id="des-sys-audit-context">
    <h2 class="section-label">Context</h2>
    <p class="heading text-ink">As an intern on the Intuit Design System team, I was tasked with auditing components to ensure token alignment between design and code.</p>
  </section>

  <section id="problem" data-comment-id="des-sys-audit-problem">
    <h2 class="section-label">Problem</h2>
    <ol>
      <li>
        <h3>Design handoff is less reliable</h3>
        <p>Handoff breaks down when components aren’t 1-to-1 between prototypes and implementation.</p>
        <ProblemVisual kind="handoff" />
      </li>
      <li>
        <h3>Hardcoded values bypass tokens</h3>
        <p>Hardcoded values in components skip tokens, so global theme updates never reach the UI.</p>
        <ProblemVisual kind="hardcoded" />
      </li>
    </ol>
  </section>

  <section id="solution" data-comment-id="des-sys-audit-solution">
    <h2 class="section-label">Solution</h2>
    <p class="heading text-ink">Manually auditing components for token misalignment between design and code can be slow and tedious.</p>
    <CaseStudyFigure
      src="images/case-studies/des-sys/manual-audit.webp"
      alt="The manual audit board: for each checkbox property (description text colour, selection label font weight, label to description gap, description font size), Figma inspect panels sit beside the matching code, with each mismatch highlighted and marked Change Design or Change Code"
      wide
    />
  </section>

  <section id="opportunity" data-comment-id="des-sys-audit-opportunity">
    <h2 class="section-label">Opportunity</h2>
    <p class="heading text-ink">How might we use AI to make auditing faster and less prone to missing misalignments?</p>
  </section>

  <section id="new-solution" data-comment-id="des-sys-audit-new-solution">
    <h2 class="section-label">New solution</h2>
    <p class="heading text-ink">I built an AI skill that checks a component’s code and design to point out inconsistencies.</p>
    <AuditSkillFlow />
  </section>

  <section id="opportunity-docs" data-comment-id="des-sys-audit-opportunity-docs">
    <h2 class="section-label">Opportunity</h2>
    <p class="heading text-ink">Design system alignment isn’t just about alignment between design and code, but also compliance with documentation.</p>
    <p>How might we refine skills to make recommendations on correct token usage based on design system documentation?</p>
    <TokenCompare />
  </section>

  <section id="final" data-comment-id="des-sys-audit-final">
    <h2 class="section-label">Final solution</h2>
    <!-- TODO(Jane): final solution copy. -->
    <AuditReviewLoop />
  </section>

  <section id="impact" data-comment-id="des-sys-audit-impact">
    <h2 class="section-label">Impact</h2>
    <!-- TODO(Jane): impact copy. -->
    <div class="case-study-stats">
      <div class="case-study-stat">
        <strong>355k+</strong>
        <span>instances of checkbox in Figma</span>
      </div>
      <div class="case-study-stat">
        <strong>143</strong>
        <span>business units use checkbox in code</span>
      </div>
      <div class="case-study-stat">
        <strong>164</strong>
        <span>design teams use checkbox</span>
      </div>
    </div>
  </section>

  <section id="reflection" data-comment-id="des-sys-audit-reflection">
    <h2 class="section-label">Reflection</h2>
    <!-- TODO(Jane): reflection and takeaways copy. -->
  </section>
</CaseStudyLayout>


