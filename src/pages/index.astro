---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LogoScrollIntro from '../components/LogoScrollIntro.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <LogoScrollIntro />
  <Header />
  <div class="home-intro-content" id="home-intro-content">
    <main class="section-stack">
      <section
        class="home-intro mx-auto grid w-full max-w-[1400px] gap-4 px-6 pt-10 md:gap-5 md:px-10 md:pt-14"
      >
        <Hero />
        <Experience />
      </section>
      <ProjectGrid />
    </main>
    <SiteFooter />
  </div>
</Layout>
