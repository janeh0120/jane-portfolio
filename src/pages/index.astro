---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LogoScrollIntro from '../components/LogoScrollIntro.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ProjectColumn from '../components/ProjectColumn.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  {/* <LogoScrollIntro /> */}
  <Header />
  <div class="home-intro-content" id="home-intro-content">
    <main>
      <section id="projects" class="home-layout page-frame" data-comment-id="project-grid">
        <div class="home-copy-pin">
          <div class="home-copy">
            <Hero />
            <Experience />
          </div>
        </div>
        <ProjectColumn />
      </section>
    </main>
    <SiteFooter />
  </div>
</Layout>

<style>
  .home-layout {
    --home-header-offset: 6.55rem;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* Intro and experience stay put, centred vertically, while the projects scroll past */
  .home-copy-pin {
    position: sticky;
    top: var(--home-header-offset);
    height: calc(100svh - var(--home-header-offset));
    display: flex;
    align-items: center;
  }

  .home-copy {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 3rem;
  }

  @media (max-width: 767px) {
    .home-layout {
      --home-header-offset: 5.55rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .home-copy-pin {
      position: static;
      height: auto;
    }

    .home-copy {
      gap: 1.5rem;
      padding-block: 0.35rem 0;
    }
  }
</style>
