---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LogoScrollIntro from '../components/LogoScrollIntro.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout edgeBlur="sides">
  {/* <LogoScrollIntro /> */}
  <Header />
  <div class="home-intro-content" id="home-intro-content">
    <main class="home-layout">
      <!-- Intro and experience, centred above the case studies -->
      <div class="home-intro page-frame">
        <Hero type="compact" />
        <Experience unlinked={['GWSK', 'Simple Ventures']} />
      </div>
      <section id="projects" data-comment-id="project-grid" aria-label="Case studies">
        <ProjectRow />
      </section>
    </main>
    <SiteFooter />
  </div>
</Layout>

<style>
  /* One column the width of the page (not of the row's content, which scrolls inside it) */
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    padding-block: var(--space-12);
  }

  /* The same width as the expanded nav bar (published by the header as --nav-bar-width), centred,
     with its text left-aligned so the intro lines up with the experience list. Narrower screens
     keep the page gutters. Above the side edge blur (z 8, below the footer's 10): the blur is for
     the cards passing the edges, never the intro. */
  .home-intro {
    position: relative;
    z-index: 9;
    max-width: var(--nav-bar-width, 30rem); /* design-tokens-ignore: matches the nav bar */
    display: grid;
    gap: var(--space-6);
  }

  /* The first card starts in line with the intro's left edge (the intro's width, as above,
     centred); the row's far end keeps its own gutter so the last card ends centred */
  #projects :global(.project-row) {
    --intro-width: min(var(--nav-bar-width, 30rem), 1400px, 100% - 3rem); /* design-tokens-ignore: the intro and .page-frame widths */
    padding-inline-start: calc((100% - var(--intro-width)) / 2);
    scroll-padding-inline-start: calc((100% - var(--intro-width)) / 2);
  }

  .home-intro :global(.home-hero) {
    max-width: none;
  }

  @media (max-width: 767px) {
    /* One column, in line with the intro on both sides */
    #projects :global(.project-row) {
      --intro-width: min(var(--nav-bar-width, 30rem), 100% - 2rem); /* design-tokens-ignore: the intro and .page-frame widths */
      padding-inline: calc((100% - var(--intro-width)) / 2);
    }

    .home-layout {
      gap: var(--space-10);
      padding-block: var(--space-8);
    }
  }
</style>

