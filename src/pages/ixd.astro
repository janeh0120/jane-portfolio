---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';

const img = (file: string) => `images/case-studies/ixd/${file}`;

const nav = [
  { label: 'Intro', href: '#intro' },
  { label: 'Exploration', href: '#exploration' },
  { label: 'Takeaways', href: '#takeaways' },
];
---

<CaseStudyLayout
  title="IXD"
  heading="A design community shouldn't graduate without a shared experience."
  role="Creative Director, Designer"
  team="RGD Student Awards Honourable Mention"
  teamLabel="Recognition"
  timeline="1 week"
  projectType="Brand, Community"
  nav={nav}
  commentId="case-study-ixd"
  heroImage={{
    src: 'images/case-study-heroes/ixdyes.png',
    alt: 'IXD year-end event experience concept collage',
    wide: true,
  }}
>
  <section id="intro" data-comment-id="ixd-intro">
    <h2>Intro</h2>
    <p class="heading text-ink">
      For the first time since COVID, my program didn’t have a year-end show. I took a hoodie design
      that won the popular vote among students in my program and used it to build a brand concept
      for a year-end show I’d run if our faculty doesn’t hold one.
    </p>
    <p class="heading text-ink">
      The concept stems from our collective struggle to explain what interaction design means to
      others. Its brand touchpoints consider not just the visual design, but how the audience
      interacts with it.
    </p>

    <div class="case-study-figure-row">
      <CaseStudyFigure
        src={img('hoodie-back.png')}
        alt="Black and white Sheridan IXD hoodies with please don't ask me what interaction design is printed on the back"
        caption="Hoodie design: the line that launched the system"
      />
      <CaseStudyFigure
        src={img('hoodie-award-pins.png')}
        alt="Students wearing Sheridan IXD hoodies with handmade award ribbons"
        caption="Award pins worn with the hoodies"
      />
    </div>

    <CaseStudyFigure
      src={img('tote-bag.mp4')}
      loop
      alt="Black tote bag with IXD lattice icons, pin, and Best in Show ribbon"
      caption="Tote bag for collecting pins and awards"
      wide
    />

    <div class="case-study-figure-row">
      <CaseStudyFigure
        src={img('name-tag.png')}
        alt="Name badge with skill radar chart on a Sheridan IXD sweatshirt"
        caption="Grad name tag"
      />
      <CaseStudyFigure
        src={img('portfolio-keychain.mp4')}
        loop
        alt="Portfolio keychain and ID holder clipped to jeans with ixd? yes tag"
        caption="Portfolio keychain + event tag"
      />
    </div>

    <CaseStudyFigure
      src={img('connect-the-dots.png')}
      alt="Connect the dots attendee cards in blue and grey with frosted thank-you overlays"
      caption="Connect-the-dots attendee cards"
      wide
    />
    <CaseStudyFigure
      src={img('graduation-directory-website.png')}
      alt="Laptop mockup of Sheridan IXD yes 2028 grad designer directory website"
      caption="New grad designer directory"
      wide
    />
    <CaseStudyFigure
      src={img('event-branding-grid.png')}
      alt="Grid of event branding posts for award ribbons, merch drop, and year end party"
      caption="Event branding system"
      wide
    />
    <CaseStudyFigure
      src={img('event-posters.png')}
      alt="Two wheatpaste-style posters for Sheridan IXD 2028 merch and year-end show"
      caption="Campaign posters"
      wide
    />
    <CaseStudyFigure
      src={img('sticker-sheet.mp4')}
      loop
      alt="IXD sticker sheet and year end party photo sticker"
      caption="Stickers and keepsakes"
      wide
    />
  </section>

  <section id="exploration" data-comment-id="ixd-exploration">
    <h2>Exploration</h2>
    <CaseStudyFigure
      src={img('hoodie-exploration.webp')}
      alt="IXD hoodie exploration with award ribbon and portfolio keychain mockup"
      caption="Early concept: hoodie challenge as the starting point"
      wide
    />
  </section>

  <section id="takeaways" data-comment-id="ixd-takeaways">
    <h2>Takeaways</h2>
    <p class="heading text-ink">
      Don’t wait for permission to create the kind of design you want to see. Design is a powerful
      tool for communicating a vision and supporting the causes I find meaningful.
    </p>
  </section>
</CaseStudyLayout>

<style>
  /* Match the inline feedback case study's statements (the page title's .heading style);
     overrides the shared case-study paragraph size */
  #intro .heading,
  #takeaways .heading {
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, calc(3.2vw - 2px), 2.375rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  #intro .heading + .heading {
    margin-top: 1.25rem;
  }

  /* Stack images with the same 1rem gap used between side-by-side images */
  #intro :global(:is(.case-study-figure, .case-study-figure-row) + :is(.case-study-figure, .case-study-figure-row)) {
    margin-top: 1rem;
  }

  #intro :global(.case-study-figure-row > .case-study-figure) {
    margin-top: 0;
  }
</style>
