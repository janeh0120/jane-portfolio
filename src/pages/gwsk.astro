---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';

const img = (file: string) => `images/case-studies/gwsk/${file}`;

const nav = [
  { label: 'Intro', href: '#intro' },
  { label: 'Visuals', href: '#visuals' },
  { label: 'Exploration', href: '#exploration' },
  { label: 'Reflection', href: '#reflection' },
];
---

<CaseStudyLayout
  title="GWSK"
  heading="A design studio shouldn't outgrow its identity."
  role="Design Intern"
  team="Design Intern, Stakeholder/PM"
  timeline="3.5 weeks"
  projectType="Brand Design, Web Design"
  nav={nav}
  commentId="case-study-gwsk"
  heroImage={{
    src: 'images/case study hero/gwsk.png',
    alt: 'GWSK redesigned website on desktop and mobile',
    wide: true,
  }}
>
  <section id="intro" data-comment-id="gwsk-intro">
    <h3>Intro</h3>
    <p class="lead">
      I collaborated with another intern to reimagine GWSK’s brand identity and website. We built a
      transit-inspired system that brought personality and consistency back to the studio.
    </p>
    <p class="lead">
      The result was a full brand system, reusable templates, and a redesigned site —
      <a
        href="https://gwsk.studio/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium underline decoration-ink/30 underline-offset-4"
      >
        gwsk.studio
      </a>.
    </p>
  </section>

  <section id="visuals" data-comment-id="gwsk-visuals">
    <h3>Visuals</h3>
    <p class="lead">
      Brutalist, smart, and accessible. Accent colours map to Double Diamond stages so the brand
      stays modular without feeling robotic.
    </p>
    <CaseStudyFigure
      src={img('brand-design-system.png')}
      alt="GWSK final brand design system in Figma with typography, colour, and layout grids"
      caption="Brand design system"
      wide
    />
    <CaseStudyFigure
      src={img('presentation-deck-cycle.png')}
      alt="GWSK presentation deck iterative process diagram"
      caption="Presentation deck — colour coded by design process"
      wide
    />
    <CaseStudyFigure
      src={img('website-hero.png')}
      alt="Final GWSK website redesign hero section"
      caption="Website redesign"
      wide
    />
    <CaseStudyFigure
      src={img('final-website-responsive.png')}
      alt="GWSK redesigned website on desktop and mobile"
      caption="Responsive website"
      wide
    />
  </section>

  <section id="exploration" data-comment-id="gwsk-exploration">
    <h3>Exploration</h3>
    <p class="lead">
      We started with moodboards from references like Pentagram, Teenage Engineering, and Bauhaus —
      looking for a language that felt systematic, but still human.
    </p>
    <CaseStudyFigure
      src={img('moodboard.png')}
      alt="GWSK brand moodboard with reference inspirations"
      caption="Moodboarding"
      wide
    />
    <p class="lead">
      From there I tested colour combinations for accessibility, so each process-stage accent stayed
      readable across the system.
    </p>
    <CaseStudyFigure
      src={img('brand-style-tile.png')}
      alt="GWSK brand style tile with transit-inspired colour system"
      caption="Colour accessibility testing"
      wide
    />
  </section>

  <section id="reflection" data-comment-id="gwsk-reflection">
    <h3>Reflection</h3>
    <p class="lead">
      Design process isn’t linear. Under a tight timeline we iterated between design and code,
      wearing both hats to see what was actually feasible.
    </p>
    <p class="lead">
      Next: usability testing before launch, then measure booking conversion and whether the brand
      actually communicates how GWSK works.
    </p>
  </section>
</CaseStudyLayout>
