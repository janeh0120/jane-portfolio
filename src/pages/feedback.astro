---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import FeedbackDemoReel from '../components/react/FeedbackDemoReel';

const img = (file: string) => `images/case-studies/feedback/${file}`;
const media = (file: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${img(file)}`;

const nav = [
  { label: 'Problem', href: '#problem' },
  { label: 'Solution', href: '#solution' },
  { label: 'Design decisions', href: '#decisions' },
];
---

<CaseStudyLayout
  title="Inline feedback"
  heading="Make inline comments on my portfolio"
  role="Product designer & engineer"
  team="Astro, React, Supabase, Vercel, Cursor"
  teamLabel="Built with"
  timeline="May 2026 – present"
  projectType="Product"
  nav={nav}
  commentId="case-study-feedback"
>
  <FeedbackDemoReel slot="hero" client:visible />

  <section id="problem" data-comment-id="feedback-need">
    <h2 class="section-label">Problem</h2>
    <p class="heading text-ink">
      Portfolio reviewers and I want to keep track of portfolio feedback inline, so I can remember
      where each comment was left and collect async feedback more easily.
    </p>
  </section>

  <section id="solution" data-comment-id="feedback-feature">
    <h2 class="section-label">Solution</h2>
    <h3 class="heading text-ink">Users can make and edit comments.</h3>
    <figure class="case-study-figure case-study-figure--wide feedback-video">
      <video
        class="feedback-video__media"
        src={media('user-view.mp4')}
        poster={media('user-view-poster.jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Leaving comments: selecting a section of the portfolio, writing a comment, and choosing a category"
      ></video>
    </figure>
    <h3 class="heading text-ink">I can review and resolve comments after making updates.</h3>
    <figure class="case-study-figure case-study-figure--wide feedback-video">
      <video
        class="feedback-video__media"
        src={media('admin-view.mp4')}
        poster={media('admin-view-poster.jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Admin review: selecting a comment highlights the section it was left on"
      ></video>
    </figure>
  </section>

  <section id="decisions" data-comment-id="feedback-decisions">
    <h2 class="section-label">Design decisions</h2>
    <ol>
      <li class="decision-row">
        <div class="decision-text">
          <h3>Guardrails</h3>
          <p>
            Curse words and comments under a minimum word count aren’t allowed. Comments are visible to me but stay anonymous.
          </p>
        </div>
        <figure class="case-study-figure decision-figure">
          <img
            src={media('error.webp')}
            alt="Comment composer showing a validation error: Comments need at least 3 characters"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
      <li class="decision-row">
        <div class="decision-text">
          <h3>Public commenting</h3>
          <p>
            I decided against making comments public to keep the scope narrow and focused on my
            problem statement. It would also be more complex to design around as I
            make updates, creating multiple versions.
          </p>
        </div>
        <figure class="case-study-figure decision-figure">
          <img
            src={media('likes.webp')}
            alt="Mockup of a public comment card with a 34-like count, illustrating what public comments could look like"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
      <li class="decision-row">
        <div class="decision-text">
          <h3>Web builder vs. fully custom</h3>
          <p>
            A web builder like Framer can’t give comments stable markup to anchor to, a server to keep
            keys private, or deploy hooks to pin each comment to a site version.
          </p>
        </div>
        <figure class="case-study-figure decision-figure">
          <img
            src={media('framer-vs-cursor.webp')}
            alt="Framer app icon versus Cursor app icon, comparing a web builder to building it myself"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
      <li class="decision-row">
        <div class="decision-text">
          <h3>Existing tools</h3>
          <p>
            <a
              href="https://www.agentation.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium underline decoration-ink/30 underline-offset-4"
            >
              Agentation
            </a> is a strong local tool for reviewing your own work and handing notes to an
            agent (copy-paste / MCP), but it doesn’t let visitors leave comments that persist, get
            reviewed in an admin view, and stay pinned to the version they were left on.
          </p>
        </div>
        <figure class="case-study-figure decision-figure">
          <img
            src={media('agentation.webp')}
            alt="Agentation documentation page showing its annotation and feedback-to-agent workflow"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
    </ol>
  </section>
</CaseStudyLayout>

<style>
  .feedback-video {
    padding: clamp(1rem, 5%, 2.5rem);
    border-radius: var(--radius-base);
    /* design-tokens-ignore: case study artwork, the blue matches the background image */
    background: #1e4fd6 url('/images/case-studies/feedback/blue-bg.jpg') center / cover;
  }

  .case-study-figure.feedback-video {
    margin-top: var(--space-4);
  }

  section .feedback-view-desc {
    margin-top: var(--space-1);
  }

  .feedback-video + h3 {
    margin-top: var(--space-12);
  }

  .feedback-video .feedback-video__media {
    aspect-ratio: 2766 / 1638;
    border-radius: calc(var(--radius-base) * 0.75);
    background: var(--color-surface);
    /* design-tokens-ignore: case study artwork, a blue-tinted shadow on the blue background */
    box-shadow: 0 12px 40px rgb(0 20 80 / 35%);
  }

  .decision-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .decision-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .decision-figure {
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .decision-figure {
      margin-top: 0;
    }
  }
</style>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('.feedback-video__media');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reduceMotion.matches) {
    videos.forEach((video) => (video.controls = true));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) void video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.4 },
    );
    videos.forEach((video) => observer.observe(video));
  }
</script>
