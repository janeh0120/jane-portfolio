---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';

const img = (file: string) => `images/case-studies/feedback/${file}`;
const media = (file: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${img(file)}`;

const nav = [
  { label: 'Problem', href: '#problem' },
  { label: 'Solution', href: '#solution' },
  { label: 'Design decisions', href: '#decisions' },
  { label: 'Next steps', href: '#next-steps' },
];
---

<CaseStudyLayout
  title="Inline feedback"
  heading="Converting user comments into code updates on my portfolio"
  team={['Product designer & engineer (me)']}
  detail={{ label: 'Built with', value: 'Astro, React, Supabase, Vercel, Cursor, Claude Code, GitHub' }}
  timeline="May – Nov 2026"
  projectType="Product"
  nav={nav}
  commentId="case-study-feedback"
>
  <CaseStudyFigure
    slot="hero"
    src="videos/feedback/feedback-loop.mp4"
    poster="images/case-study-heroes/feedback-loop-poster.jpg"
    alt="The feedback loop: a visitor comments on the intro, I open a PR from the admin sidebar and merge it on GitHub, and the intro updates on the site"
    loop
    wide
  />

  <section id="problem" data-comment-id="feedback-need">
    <h2 class="section-label">Problem</h2>
    <p class="heading text-ink">
      I want to make leaving feedback on my portfolio easier for visitors, and possible asynchronously.
    </p>
    <p class="heading text-ink">
      I want to make closing the feedback loop more seamless, from feedback to merged code.
    </p>
  </section>

  <!-- The solution videos have the blue background built in (rendered with a zooming camera) -->
  <section id="solution" data-comment-id="feedback-feature">
    <h2 class="section-label">Solution</h2>
    <h3 class="heading text-ink">Visitors can make and edit comments.</h3>
    <figure class="case-study-figure case-study-figure--wide feedback-video">
      <video
        class="feedback-video__media"
        src={media('user-view.mp4')}
        poster={media('user-view-poster.jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Leaving a comment: selecting the intro, writing a comment, choosing a category, then editing it in the sidebar"
      ></video>
    </figure>
    <h3 class="heading text-ink">I review comments and open a PR to apply them.</h3>
    <figure class="case-study-figure case-study-figure--wide feedback-video">
      <video
        class="feedback-video__media"
        src={media('admin-view.mp4')}
        poster={media('admin-view-poster.jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Admin review: editing the prompt for a comment, opening a PR, and the card changing to PR opened"
      ></video>
    </figure>
    <h3 class="heading text-ink">I preview each PR locally, then merge it on GitHub to make it live.</h3>
    <figure class="case-study-figure case-study-figure--wide feedback-video">
      <video
        class="feedback-video__media"
        src={media('github-merge.mp4')}
        poster={media('github-merge-poster.jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Merging the pull request on GitHub: confirming the merge, and the pull request changing from Open to Merged"
      ></video>
    </figure>
  </section>

  <section id="decisions" data-comment-id="feedback-decisions">
    <h2 class="section-label">Design decisions</h2>
    <ol>
      <li class="decision-row">
        <div>
          <h3>Guardrails</h3>
          <p>
            Curse words and comments under a minimum length aren’t allowed. Comments are visible to me but stay anonymous.
          </p>
        </div>
        <figure class="case-study-figure">
          <img
            src={media('error.webp')}
            alt="Comment composer showing a validation error: Comments need at least 3 characters"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
      <li class="decision-row">
        <div>
          <h3>Editing the prompt</h3>
          <p>
            I stay in the loop by being able to edit prompts and add more specifications, or
            iterate on the feedback to turn its language into a prompt.
          </p>
        </div>
        <figure class="case-study-figure">
          <img
            src={media('refine-prompt.webp')}
            alt="Admin comment card with the prompt for Claude open, edited to add: and keep the paragraph below it the same, above the Open PR button"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
      <li class="decision-row">
        <div>
          <h3>Existing tools</h3>
          <p>
            <a
              href="https://www.agentation.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium underline decoration-ink/30 underline-offset-4"
            >
              Agentation
            </a> is a strong local tool for reviewing your own work and handing notes to an
            agent (copy-paste / MCP), but it doesn’t let visitors leave comments that persist, get
            reviewed in an admin view, and stay pinned to the version they were left on.
          </p>
        </div>
        <figure class="case-study-figure">
          <img
            src={media('agentation.webp')}
            alt="Agentation documentation page showing its annotation and feedback-to-agent workflow"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </li>
    </ol>
  </section>

  <section id="next-steps" data-comment-id="feedback-next-steps">
    <h2 class="section-label">Next steps</h2>
    <p class="heading text-ink">
      Leaving feedback is secondary to viewing the work, so I want to encourage it without making it
      too prominent.
    </p>
    <p class="heading text-ink">
      I want to keep exploring how to promote this feature to visitors and increase conversion.
    </p>
  </section>
</CaseStudyLayout>

<style>
  /* The solution videos carry their own blue background, so the figure only sets spacing */
  .case-study-figure.feedback-video {
    margin-top: var(--space-4);
  }

  section .feedback-view-desc {
    margin-top: var(--space-1);
  }

  .feedback-video + h3 {
    margin-top: var(--space-12);
  }

</style>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('.feedback-video__media');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reduceMotion.matches) {
    videos.forEach((video) => (video.controls = true));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) void video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.4 },
    );
    videos.forEach((video) => observer.observe(video));
  }
</script>
