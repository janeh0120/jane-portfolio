---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AdminCommentReview from '../../components/AdminCommentReview.astro';
import { isAdminSession, isGitHubVerified } from '../../lib/admin-auth';
import {
  listArchivedComments,
  listCommentsByVersion,
  type PortfolioComment,
} from '../../lib/comments';
import { resolvePortfolioPreviewBase } from '../../lib/deploy-url';
import { latestPrRequests, shortCommentId } from '../../lib/pr-requests';
import { getVersionById, listVersions } from '../../lib/versions';

if (!isAdminSession(Astro.cookies)) return Astro.redirect('/admin/login');

const base = import.meta.env.BASE_URL;

let versions: Awaited<ReturnType<typeof listVersions>> = [];
let comments: PortfolioComment[] = [];
let prRequests: Awaited<ReturnType<typeof latestPrRequests>> = new Map();
let selectedVersion: Awaited<ReturnType<typeof getVersionById>> = null;
let error = '';

try {
  versions = await listVersions();
  const active = versions.find((item) => item.isActive) ?? versions[0] ?? null;
  selectedVersion = active ? await getVersionById(active.id) : null;

  const [activeComments, archivedComments] = await Promise.all([
    selectedVersion ? listCommentsByVersion(selectedVersion.id) : [],
    listArchivedComments(),
  ]);
  comments = [...activeComments, ...archivedComments];
  prRequests = await latestPrRequests(comments.map((item) => item.id));
} catch (e) {
  error =
    'Could not load version review. Check Supabase configuration and run the files in supabase/migrations.';
  console.error(e);
}

const frameBaseUrl = resolvePortfolioPreviewBase(
  selectedVersion?.deployUrl,
  Astro.url.origin,
  base,
);

const clientComments = comments.map((item) => {
  const pr = prRequests.get(item.id);
  return {
    id: item.id,
    shortId: shortCommentId(item.id),
    pageUrl: item.pageUrl,
    selector: item.selector,
    elementDisplayName: item.elementDisplayName || item.elementLabel,
    category: item.category ?? '',
    comment: item.comment,
    deviceType: item.deviceType,
    os: item.os,
    viewportWidth: item.viewportWidth,
    viewportHeight: item.viewportHeight ?? null,
    devicePixelRatio: item.devicePixelRatio ?? null,
    colorTheme: item.colorTheme ?? null,
    reducedMotion: item.reducedMotion ?? null,
    browser: item.browser ?? null,
    browserVersion: item.browserVersion ?? null,
    scrollY: item.scrollY,
    createdAt: item.createdAt.toISOString(),
    archivedAt: item.archivedAt?.toISOString() ?? null,
    archiveReason: item.archiveReason ?? null,
    pr: pr
      ? {
          status: pr.status,
          branch: pr.branch,
          sessionUrl: pr.sessionUrl,
          sentPrompt: pr.ownerPrompt,
        }
      : null,
  };
});

const githubVerified = isGitHubVerified(Astro.cookies);
---

<Layout title="Admin review" adminReview={!error}>
  {
    error ? (
      <main class="mx-auto max-w-4xl px-6 py-12 md:px-10">
        <h1 class="heading text-ink">Version review</h1>
        <p class="mt-6 text-body text-danger">{error}</p>
      </main>
    ) : selectedVersion ? (
      <AdminCommentReview
        comments={clientComments}
        frameBaseUrl={frameBaseUrl}
        githubVerified={githubVerified}
      />
    ) : (
      <main class="mx-auto max-w-4xl px-6 py-12 md:px-10">
        <h1 class="heading text-ink">Version review</h1>
        <p class="mt-6 text-body text-muted">
          No portfolio versions yet. Deploy the site or run the deploy hook to create one.
        </p>
      </main>
    )
  }
</Layout>
