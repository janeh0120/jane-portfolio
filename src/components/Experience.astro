---
import { site } from '../data/site';

const previous = site.experience.previous;
---

<section class="mx-auto max-w-[1400px] px-6 pb-20 pt-5 md:px-10 md:pb-28 md:pt-6" data-comment-id="experience">
  <p class="experience-copy max-w-2xl text-muted">
    Currently at
    <a
      href={site.experience.current.href}
      target="_blank"
      rel="noopener noreferrer"
      class="text-ink underline decoration-ink/25 underline-offset-[3px] transition hover:decoration-ink"
    >
      {site.experience.current.label}
    </a>
    previously at
    {
      previous.map((place, index) => (
        <>
          {index > 0 ? (index === previous.length - 1 ? ' and ' : ', ') : ' '}
          <a
            href={place.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink underline decoration-ink/25 underline-offset-[3px] transition hover:decoration-ink"
          >
            {place.label}
          </a>
        </>
      ))
    }.
    {site.experience.note && <> {site.experience.note}</>}
  </p>
</section>
