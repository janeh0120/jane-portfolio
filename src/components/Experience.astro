---
import { site } from '../data/site';

const linkClass = 'text-link text-body text-ink';
const { current, previous } = site.experience;
---

<section class="experience-list" data-comment-id="experience" aria-label="Experience">
  <div class="experience-block">
    <p class="text-body text-muted">Currently</p>
    <p class="text-body text-ink">
      <a href={current.href} target="_blank" rel="noopener noreferrer" class={linkClass}>{current.label}</a>
      {
        current.role ? (
          <span class="experience-role">, {current.role.toLowerCase()}</span>
        ) : null
      }
    </p>
  </div>

  <div class="experience-block">
    <p class="text-body text-muted">Previously</p>
    <ul class="experience-entries">
      {
        previous.map((place) => (
          <li class="text-body text-ink">
            <a href={place.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {place.label}
            </a>
            {place.role ? <span class="experience-role">, {place.role.toLowerCase()}</span> : null}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .experience-list {
    display: grid;
    gap: 1.35rem;
    max-width: 22rem;
  }

  .experience-block {
    display: grid;
    gap: 0.2rem;
  }

  .experience-entries {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }

  .experience-role {
    color: var(--color-muted);
  }
</style>
