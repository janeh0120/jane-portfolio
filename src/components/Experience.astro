---
import { site } from '../data/site';

const linkClass = 'text-link text-body text-ink';
const { current, previous } = site.experience;
---

<section class="experience-list max-w-2xl" data-comment-id="experience" aria-label="Experience">
  <div class="experience-block">
    <p class="text-body text-muted">Currently at:</p>
    <ul class="experience-entries">
      <li class="experience-entry text-body">
        <a href={current.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
          {current.label}
        </a>
        {current.role && <span class="experience-role text-muted">{current.role}</span>}
      </li>
    </ul>
  </div>

  <div class="experience-block">
    <p class="text-body text-muted">Previously at:</p>
    <ul class="experience-entries">
      {
        previous.map((place) => (
          <li class="experience-entry text-body">
            <a href={place.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {place.label}
            </a>
            {place.role && <span class="experience-role text-muted">{place.role}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .experience-list {
    display: grid;
    gap: 1.25rem;
  }

  .experience-block {
    display: grid;
    gap: 0;
  }

  .experience-entries {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .experience-entry {
    display: grid;
    grid-template-columns: minmax(7.5rem, max-content) minmax(0, 1fr);
    column-gap: 1rem;
    align-items: baseline;
  }

  .experience-role {
    font-style: normal;
  }

  @media (max-width: 480px) {
    .experience-entry {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
