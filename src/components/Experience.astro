---
import { site } from '../data/site';

interface Props {
  /** Labels of previous roles to list first, in order. */
  order?: string[];
}

const { order = [] } = Astro.props;
const { current, previous } = site.experience;
const rank = (label: string) => {
  const i = order.indexOf(label);
  return i === -1 ? order.length : i;
};
const sortedPrevious = [...previous].sort((a, b) => rank(a.label) - rank(b.label));
// Each year (or Currently / Previously, for roles without one) shows once, on the first row it covers.
const rows = [
  { ...current, when: current.years ?? 'Currently' },
  ...sortedPrevious.map((place) => ({ ...place, when: place.years ?? 'Previously' })),
].map((row, index, all) => ({ ...row, when: index > 0 && all[index - 1].when === row.when ? '' : row.when }));
---

<section class="experience-list" data-comment-id="experience" aria-label="Experience">
  <ul class="experience-rows">
    {
      rows.map((row) => (
        <li class="experience-row text-body">
          <span class="experience-when">{row.when}</span>
          <a href={row.href} target="_blank" rel="noopener noreferrer" class="experience-place text-link text-ink">
            {row.label}
          </a>
          {row.role ? <span class="experience-role">{row.role}</span> : null}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .experience-list {
    container-type: inline-size;
  }

  /* Narrow: label beside a stacked company and role */
  .experience-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--space-8);
    row-gap: var(--space-3);
  }

  .experience-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: auto auto;
    row-gap: var(--space-1);
    font: var(--type-compact);
  }

  .experience-when {
    grid-row: 1 / span 2;
    color: var(--color-subtle);
    font-variant-numeric: tabular-nums;
  }

  .experience-place {
    grid-column: 2;
    justify-self: start;
  }

  .experience-role {
    grid-column: 2;
    color: var(--color-muted);
  }

  /* Wide: label, company, and role on one line (the longest row needs about 26rem, so this holds
     at the homepage's nav-bar width) */
  @container (min-width: 26rem) {
    .experience-rows {
      grid-template-columns: max-content max-content minmax(0, 1fr);
      row-gap: var(--space-2);
    }

    .experience-row {
      grid-template-rows: auto;
    }

    .experience-when {
      grid-row: auto;
    }

    .experience-role {
      grid-column: 3;
    }
  }
</style>
