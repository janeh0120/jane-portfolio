---
import { Icon } from 'astro-icon/components';

interface Props {
  direction?: 'left' | 'right';
  class?: string;
  /** CSS size value, e.g. "14px" or "0.9em". Defaults to 1em. */
  size?: string;
}

const { direction = 'right', class: className, size } = Astro.props;
const name = direction === 'left' ? 'lucide:arrow-left' : 'lucide:arrow-right';
---

<Icon
  name={name}
  class:list={['arrow-icon', `arrow-icon--${direction}`, className]}
  aria-hidden="true"
  style={size ? `--arrow-size: ${size}` : undefined}
/>

<style>
  .arrow-icon {
    display: inline-block;
    flex-shrink: 0;
    width: var(--arrow-size, 1em);
    height: var(--arrow-size, 1em);
    vertical-align: -0.12em;
    color: currentColor;
  }
</style>
