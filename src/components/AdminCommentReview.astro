---
interface SerializedComment {
  id: string;
  pageUrl: string;
  selector: string;
  elementDisplayName: string;
  category: string;
  comment: string;
  deviceType: string;
  os: string;
  viewportWidth: number;
  scrollY: number;
  createdAt: string;
}

interface Props {
  adminKey: string;
  comments: SerializedComment[];
  frameBaseUrl: string;
}

const { adminKey, comments, frameBaseUrl } = Astro.props;
const reviewData = JSON.stringify({ adminKey, comments, frameBaseUrl }).replace(/</g, '\\u003c');
---

<div id="admin-site-shell" class="site-shell admin-review-shell">
  <div id="admin-site-canvas" class="site-canvas admin-review-canvas">
    <iframe
      id="admin-portfolio-frame"
      class="admin-review-frame"
      title="Portfolio preview"
      src={frameBaseUrl}
    ></iframe>
  </div>

  <aside class="comment-sidebar" id="admin-comment-sidebar" data-comment-ui aria-label="Comments">
    <div class="comment-sidebar-panel">
      <div class="comment-sidebar-header">
        <div class="comment-sidebar-header-row">
          <span class="comment-sidebar-title">Comments</span>
        </div>
        <div class="comment-sidebar-tabs" role="tablist" aria-label="Comment filter">
          <button
            type="button"
            id="admin-scope-page"
            class="comment-sidebar-tab is-active"
            role="tab"
            aria-selected="true"
          >
            This page
            <span class="tag is-count" id="admin-scope-page-count"></span>
          </button>
          <button
            type="button"
            id="admin-scope-all"
            class="comment-sidebar-tab"
            role="tab"
            aria-selected="false"
          >
            All pages
            <span class="tag is-count" id="admin-scope-all-count">{comments.length}</span>
          </button>
        </div>
      </div>
      <div class="comment-sidebar-list" id="admin-comment-list" role="tabpanel"></div>
    </div>
  </aside>
</div>

<div class="comment-mode-highlight" id="admin-highlight" hidden data-comment-ui></div>

<script type="application/json" id="admin-review-data" set:html={reviewData}></script>

<script>
  import { lucideSvg } from '../lib/lucide-svg';

  const { adminKey, comments, frameBaseUrl } = JSON.parse(
    document.getElementById('admin-review-data')?.textContent ?? '{}',
  );

  const CATEGORY_LABELS = {
    '': 'No category',
    accessibility: 'Accessibility',
    content: 'Content',
    'visual-design': 'Visual design',
    bug: 'Bug',
  };

  let commentItems = [...comments];

  const frame = document.getElementById('admin-portfolio-frame');
  const sidebarList = document.getElementById('admin-comment-list');
  const highlight = document.getElementById('admin-highlight');
  const scopePageBtn = document.getElementById('admin-scope-page');
  const scopeAllBtn = document.getElementById('admin-scope-all');
  const pageCountEl = document.getElementById('admin-scope-page-count');
  const allCountEl = document.getElementById('admin-scope-all-count');

  let scope = 'page';
  let activeCardId = null;
  let previewCardId = null;
  let pinnedComment = null;

  function categoryLabel(id) {
    return CATEGORY_LABELS[id] ?? 'No category';
  }

  function formatMeta(item) {
    const when = new Intl.DateTimeFormat('en-CA', {
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(item.createdAt));
    return `${when} · ${item.deviceType} · ${item.os} · ${item.viewportWidth}px`;
  }

  function pagePathFromUrl(pageUrl) {
    try {
      const url = new URL(pageUrl);
      return url.pathname + url.search;
    } catch {
      return '/';
    }
  }

  function currentFramePath() {
    if (!frame?.contentWindow) return '/';
    try {
      return frame.contentWindow.location.pathname + frame.contentWindow.location.search;
    } catch {
      return pagePathFromUrl(frame.src);
    }
  }

  function resolveFrameUrl(pageUrl) {
    const path = pagePathFromUrl(pageUrl);
    const base = frameBaseUrl.replace(/\/$/, '');
    if (path.startsWith('/admin') || path.startsWith('/api')) {
      return `${base}/`;
    }
    return `${base}${path.startsWith('/') ? path : `/${path}`}`;
  }

  function canAccessFrameDocument() {
    try {
      return Boolean(frame?.contentDocument);
    } catch {
      return false;
    }
  }

  function placeHighlight(element, mode) {
    if (!highlight || !frame) return;
    const frameRect = frame.getBoundingClientRect();
    const elRect = element.getBoundingClientRect();
    const top = Math.max(frameRect.top + elRect.top, frameRect.top);
    const left = Math.max(frameRect.left + elRect.left, frameRect.left);
    const bottom = Math.min(frameRect.top + elRect.bottom, frameRect.bottom);
    const right = Math.min(frameRect.left + elRect.right, frameRect.right);
    if (bottom <= top || right <= left) {
      highlight.hidden = true;
      return;
    }
    highlight.hidden = false;
    highlight.classList.toggle('is-pinned', mode === 'pinned');
    highlight.classList.toggle('is-preview', mode === 'preview');
    highlight.style.top = `${top}px`;
    highlight.style.left = `${left}px`;
    highlight.style.width = `${right - left}px`;
    highlight.style.height = `${bottom - top}px`;
  }

  function positionHighlightForElement(element) {
    placeHighlight(element, 'pinned');
  }

  function hideHighlight() {
    if (!highlight) return;
    highlight.hidden = true;
    highlight.classList.remove('is-pinned', 'is-preview');
  }

  function findFrameTarget(item) {
    if (!canAccessFrameDocument()) return null;
    const win = frame.contentWindow;
    let target = null;
    try {
      target = frame.contentDocument?.querySelector(item.selector);
    } catch {
      return null;
    }
    // Frame nodes belong to the iframe's realm, so the parent's HTMLElement never matches.
    return win && target instanceof win.HTMLElement ? target : null;
  }

  function tryHighlightComment(item) {
    const target = findFrameTarget(item);
    if (target) {
      positionHighlightForElement(target);
    } else {
      hideHighlight();
    }
  }

  function findScroller(element) {
    const doc = element.ownerDocument;
    const win = doc.defaultView;
    for (let node = element.parentElement; node && node !== doc.body; node = node.parentElement) {
      const { overflowY } = win.getComputedStyle(node);
      if (/(auto|scroll)/.test(overflowY) && node.scrollHeight > node.clientHeight) return node;
    }
    return doc.scrollingElement ?? doc.documentElement;
  }

  function scrollFrameToComment(item) {
    try {
      const doc = frame?.contentDocument;
      if (!doc) return;
      const target = findFrameTarget(item);
      if (!target) {
        const scroller = doc.getElementById('site-canvas') ?? doc.scrollingElement;
        scroller?.scrollTo({ top: item.scrollY, behavior: 'smooth' });
        return;
      }
      const scroller = findScroller(target);
      const isRoot = scroller === doc.scrollingElement || scroller === doc.documentElement;
      const view = isRoot
        ? { top: 0, bottom: doc.defaultView.innerHeight }
        : scroller.getBoundingClientRect();
      const rect = target.getBoundingClientRect();
      if (rect.top >= view.top && rect.bottom <= view.bottom) return;
      const viewHeight = view.bottom - view.top;
      const offset = rect.height < viewHeight ? (viewHeight - rect.height) / 2 : 24;
      scroller.scrollTo({
        top: scroller.scrollTop + rect.top - view.top - offset,
        behavior: 'smooth',
      });
    } catch {
      /* cross-origin: scroll may be blocked */
    }
  }

  function onFrameReady(item, { pin = true } = {}) {
    if (pin) {
      pinnedComment = item;
      trackPinnedHighlight();
    }
    scrollFrameToComment(item);
  }

  // The page animates elements (intro, wheel) without scroll events, so follow the target per frame.
  let trackingFrame = 0;

  function trackPinnedHighlight() {
    cancelAnimationFrame(trackingFrame);
    const tick = () => {
      if (!pinnedComment) return;
      if (previewCardId === null) tryHighlightComment(pinnedComment);
      trackingFrame = requestAnimationFrame(tick);
    };
    tick();
  }

  function navigateToComment(item, { pin = true } = {}) {
    if (!frame) return;
    const targetUrl = resolveFrameUrl(item.pageUrl);
    let samePage = false;

    try {
      samePage = frame.contentWindow?.location.pathname === new URL(targetUrl).pathname;
    } catch {
      samePage = frame.src === targetUrl;
    }

    if (samePage && canAccessFrameDocument()) {
      onFrameReady(item, { pin });
      return;
    }

    const handleLoad = () => {
      frame?.removeEventListener('load', handleLoad);
      onFrameReady(item, { pin });
    };

    frame.addEventListener('load', handleLoad);
    frame.src = targetUrl;
  }

  async function deleteComment(id) {
    if (!window.confirm('Delete this comment permanently?')) return;

    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'x-admin-secret': adminKey,
        },
        body: JSON.stringify({ adminKey }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.error || 'Could not delete comment.');
      }

      commentItems = commentItems.filter((item) => item.id !== id);
      if (activeCardId === id) activeCardId = null;
      if (pinnedComment?.id === id) {
        pinnedComment = null;
        hideHighlight();
      }
      renderSidebar();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not delete comment.');
    }
  }

  function pageComments() {
    const path = currentFramePath();
    return commentItems.filter((item) => pagePathFromUrl(item.pageUrl) === path);
  }

  function renderSidebar() {
    if (!sidebarList) return;
    const onPage = pageComments();
    const items = scope === 'all' ? commentItems : onPage;
    if (pageCountEl) pageCountEl.textContent = String(onPage.length);
    if (allCountEl) allCountEl.textContent = String(commentItems.length);
    sidebarList.innerHTML = '';

    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'comment-sidebar-empty';
      empty.textContent =
        scope === 'page' ? 'No comments on this page.' : 'No comments yet.';
      sidebarList.appendChild(empty);
      return;
    }

    for (const item of [...items].reverse()) {
      const card = document.createElement('article');
      card.className = `comment-sidebar-card comment-sidebar-card--readonly${activeCardId === item.id ? ' is-active' : ''}`;
      card.dataset.commentId = item.id;

      const header = document.createElement('div');
      header.className = 'comment-sidebar-card-header';

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'icon-control is-dismiss is-destructive inline-flex comment-sidebar-card-delete';
      deleteBtn.setAttribute('aria-label', 'Delete comment');
      deleteBtn.innerHTML = lucideSvg('x', 14);
      deleteBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        void deleteComment(item.id);
      });

      const title = document.createElement('p');
      title.className = 'comment-sidebar-card-title';
      title.textContent = item.elementDisplayName;

      if (item.category) {
        const category = document.createElement('span');
        category.className = 'tag comment-sidebar-card-category-label';
        category.textContent = categoryLabel(item.category);
        header.append(category, deleteBtn);
        card.append(header, title);
      } else {
        header.classList.add('has-title');
        header.append(title, deleteBtn);
        card.appendChild(header);
      }

      const body = document.createElement('p');
      body.className = 'comment-sidebar-card-body';
      body.textContent = item.comment;
      card.appendChild(body);

      const meta = document.createElement('p');
      meta.className = 'comment-sidebar-card-meta';
      meta.textContent = formatMeta(item);
      card.appendChild(meta);

      card.addEventListener('click', () => {
        activeCardId = item.id;
        previewCardId = null;
        navigateToComment(item, { pin: true });
        renderSidebar();
      });

      card.addEventListener('mouseenter', () => {
        previewCardId = item.id;
        const target = findFrameTarget(item);
        if (target) placeHighlight(target, 'preview');
      });

      card.addEventListener('mouseleave', () => {
        if (previewCardId === item.id) {
          previewCardId = null;
          if (pinnedComment) tryHighlightComment(pinnedComment);
          else hideHighlight();
        }
      });

      sidebarList.appendChild(card);
    }
  }

  function setScope(next) {
    scope = next;
    scopePageBtn?.classList.toggle('is-active', next === 'page');
    scopeAllBtn?.classList.toggle('is-active', next === 'all');
    scopePageBtn?.setAttribute('aria-selected', String(next === 'page'));
    scopeAllBtn?.setAttribute('aria-selected', String(next === 'all'));
    renderSidebar();
  }

  scopePageBtn?.addEventListener('click', () => setScope('page'));
  scopeAllBtn?.addEventListener('click', () => setScope('all'));

  frame?.addEventListener('load', renderSidebar);

  document.body.classList.add('comment-view-comment');
  renderSidebar();
</script>
