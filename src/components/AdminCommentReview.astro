---
interface SerializedComment {
  id: string;
  pageUrl: string;
  selector: string;
  elementDisplayName: string;
  category: string;
  comment: string;
  deviceType: string;
  os: string;
  viewportWidth: number;
  viewportHeight: number | null;
  devicePixelRatio: number | null;
  colorTheme: string | null;
  reducedMotion: boolean | null;
  browser: string | null;
  browserVersion: number | null;
  scrollY: number;
  createdAt: string;
  shortId: string;
  archivedAt: string | null;
  archiveReason: string | null;
  pr: { status: string; branch: string; sessionUrl: string | null } | null;
}

interface Props {
  comments: SerializedComment[];
  frameBaseUrl: string;
  githubVerified: boolean;
}

const { comments, frameBaseUrl, githubVerified } = Astro.props;
const reviewData = JSON.stringify({ comments, frameBaseUrl, githubVerified }).replace(/</g, '\\u003c');
const activeCount = comments.filter((item) => !item.archivedAt).length;
---

<div id="admin-site-shell" class="site-shell admin-review-shell">
  <div id="admin-site-canvas" class="site-canvas admin-review-canvas">
    <iframe
      id="admin-portfolio-frame"
      class="admin-review-frame"
      title="Portfolio preview"
      src={frameBaseUrl}
      referrerpolicy="no-referrer"
    ></iframe>
  </div>

  <aside class="comment-sidebar" id="admin-comment-sidebar" data-comment-ui aria-label="Comments">
    <div class="comment-sidebar-panel">
      <div class="comment-sidebar-header">
        <div class="comment-sidebar-header-row">
          <span class="comment-sidebar-title">Comments</span>
          <form method="post" action="/api/auth/logout">
            <button type="submit" class="button is-tertiary">Sign out</button>
          </form>
        </div>
        <div class="segmented" role="group" aria-label="Comment status">
          <span class="segmented-thumb" aria-hidden="true"></span>
          <button type="button" id="admin-status-active" class="segmented-option" aria-pressed="true">Active</button>
          <button type="button" id="admin-status-archived" class="segmented-option" aria-pressed="false">Archived</button>
        </div>
        <div class="comment-sidebar-tabs" role="tablist" aria-label="Comment filter">
          <button
            type="button"
            id="admin-scope-page"
            class="comment-sidebar-tab is-active"
            role="tab"
            aria-selected="true"
          >
            This page
            <span class="tag is-count" id="admin-scope-page-count"></span>
          </button>
          <button
            type="button"
            id="admin-scope-all"
            class="comment-sidebar-tab"
            role="tab"
            aria-selected="false"
          >
            All pages
            <span class="tag is-count" id="admin-scope-all-count">{activeCount}</span>
          </button>
        </div>
      </div>
      <div class="comment-sidebar-list" id="admin-comment-list" role="tabpanel"></div>
    </div>
  </aside>
</div>

<div class="comment-mode-highlight" id="admin-highlight" hidden data-comment-ui></div>

<script type="application/json" id="admin-review-data" set:html={reviewData}></script>

<script>
  import { enhanceSelect } from '../lib/dropdown';
  import { lucideSvg } from '../lib/lucide-svg';

  const { comments, frameBaseUrl, githubVerified } = JSON.parse(
    document.getElementById('admin-review-data')?.textContent ?? '{}',
  );

  const CATEGORY_LABELS = {
    '': 'No category',
    accessibility: 'Accessibility',
    content: 'Content',
    'visual-design': 'Visual design',
    bug: 'Bug',
  };

  const ARCHIVE_LABELS = {
    'not-feedback': 'Not feedback',
    resolved: 'Resolved',
  };

  const OS_LABELS = { ios: 'iOS', android: 'Android', macos: 'macOS', other: 'Other OS' };

  const REPO_URL = 'https://github.com/janeh0120/jane-portfolio';

  let commentItems = [...comments];

  const frame = document.getElementById('admin-portfolio-frame');
  const sidebarList = document.getElementById('admin-comment-list');
  const highlight = document.getElementById('admin-highlight');
  const scopePageBtn = document.getElementById('admin-scope-page');
  const scopeAllBtn = document.getElementById('admin-scope-all');
  const pageCountEl = document.getElementById('admin-scope-page-count');
  const allCountEl = document.getElementById('admin-scope-all-count');
  const statusActiveBtn = document.getElementById('admin-status-active');
  const statusArchivedBtn = document.getElementById('admin-status-archived');

  let scope = 'page';
  let status = 'active';
  let confirmCardId = null;
  let submittingId = null;
  const noteDrafts = new Map();
  const cardErrors = new Map();
  let activeCardId = null;
  let previewCardId = null;
  let pinnedComment = null;

  function categoryLabel(id) {
    return CATEGORY_LABELS[id] ?? 'No category';
  }

  function formatMeta(item) {
    const when = new Intl.DateTimeFormat('en-CA', {
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(item.createdAt));
    return [when, item.deviceType, ...deviceDetails(item)].join(' · ');
  }

  // Comments from before browser capture have an unreliable OS, so it's left out for those.
  function deviceDetails(item) {
    if (!item.browser) return [`${item.viewportWidth}px`];
    const browser = item.browserVersion ? `${item.browser} ${item.browserVersion}` : item.browser;
    const size = item.viewportHeight
      ? `${item.viewportWidth}×${item.viewportHeight}`
      : `${item.viewportWidth}px`;
    return [browser, OS_LABELS[item.os] ?? item.os, size];
  }

  function contextSummary(item) {
    const details = [
      `Page: ${pagePathFromUrl(item.pageUrl)}`,
      `Element: ${item.elementDisplayName}`,
      `Device: ${[item.deviceType, ...deviceDetails(item)].join(' · ')}`,
    ];
    if (item.browser) {
      const display = [
        item.colorTheme && `${item.colorTheme} mode`,
        item.devicePixelRatio && `${item.devicePixelRatio}x`,
        item.reducedMotion === true && 'reduced motion',
      ].filter(Boolean);
      if (display.length > 0) details.push(`Display: ${display.join(' · ')}`);
    } else {
      details.push('Browser and screen height: not captured');
    }
    return details;
  }

  function pagePathFromUrl(pageUrl) {
    try {
      const url = new URL(pageUrl);
      return url.pathname + url.search;
    } catch {
      return '/';
    }
  }

  function currentFramePath() {
    if (!frame?.contentWindow) return '/';
    try {
      return frame.contentWindow.location.pathname + frame.contentWindow.location.search;
    } catch {
      return pagePathFromUrl(frame.src);
    }
  }

  function resolveFrameUrl(pageUrl) {
    const path = pagePathFromUrl(pageUrl);
    const base = frameBaseUrl.replace(/\/$/, '');
    if (path.startsWith('/admin') || path.startsWith('/api')) {
      return `${base}/`;
    }
    return `${base}${path.startsWith('/') ? path : `/${path}`}`;
  }

  function canAccessFrameDocument() {
    try {
      return Boolean(frame?.contentDocument);
    } catch {
      return false;
    }
  }

  function placeHighlight(element, mode) {
    if (!highlight || !frame) return;
    const frameRect = frame.getBoundingClientRect();
    const elRect = element.getBoundingClientRect();
    const top = Math.max(frameRect.top + elRect.top, frameRect.top);
    const left = Math.max(frameRect.left + elRect.left, frameRect.left);
    const bottom = Math.min(frameRect.top + elRect.bottom, frameRect.bottom);
    const right = Math.min(frameRect.left + elRect.right, frameRect.right);
    if (bottom <= top || right <= left) {
      highlight.hidden = true;
      return;
    }
    highlight.hidden = false;
    highlight.classList.toggle('is-pinned', mode === 'pinned');
    highlight.classList.toggle('is-preview', mode === 'preview');
    highlight.style.top = `${top}px`;
    highlight.style.left = `${left}px`;
    highlight.style.width = `${right - left}px`;
    highlight.style.height = `${bottom - top}px`;
  }

  function positionHighlightForElement(element) {
    placeHighlight(element, 'pinned');
  }

  function hideHighlight() {
    if (!highlight) return;
    highlight.hidden = true;
    highlight.classList.remove('is-pinned', 'is-preview');
  }

  function findFrameTarget(item) {
    if (!canAccessFrameDocument()) return null;
    const win = frame.contentWindow;
    let target = null;
    try {
      target = frame.contentDocument?.querySelector(item.selector);
    } catch {
      return null;
    }
    // Frame nodes belong to the iframe's realm, so the parent's HTMLElement never matches.
    return win && target instanceof win.HTMLElement ? target : null;
  }

  function tryHighlightComment(item) {
    const target = findFrameTarget(item);
    if (target) {
      positionHighlightForElement(target);
    } else {
      hideHighlight();
    }
  }

  function findScroller(element) {
    const doc = element.ownerDocument;
    const win = doc.defaultView;
    for (let node = element.parentElement; node && node !== doc.body; node = node.parentElement) {
      const { overflowY } = win.getComputedStyle(node);
      if (/(auto|scroll)/.test(overflowY) && node.scrollHeight > node.clientHeight) return node;
    }
    return doc.scrollingElement ?? doc.documentElement;
  }

  function scrollFrameToComment(item) {
    try {
      const doc = frame?.contentDocument;
      if (!doc) return;
      const target = findFrameTarget(item);
      if (!target) {
        const scroller = doc.getElementById('site-canvas') ?? doc.scrollingElement;
        scroller?.scrollTo({ top: item.scrollY, behavior: 'smooth' });
        return;
      }
      const scroller = findScroller(target);
      const isRoot = scroller === doc.scrollingElement || scroller === doc.documentElement;
      const view = isRoot
        ? { top: 0, bottom: doc.defaultView.innerHeight }
        : scroller.getBoundingClientRect();
      const rect = target.getBoundingClientRect();
      if (rect.top >= view.top && rect.bottom <= view.bottom) return;
      const viewHeight = view.bottom - view.top;
      const offset = rect.height < viewHeight ? (viewHeight - rect.height) / 2 : 24;
      scroller.scrollTo({
        top: scroller.scrollTop + rect.top - view.top - offset,
        behavior: 'smooth',
      });
    } catch {
      /* cross-origin: scroll may be blocked */
    }
  }

  function onFrameReady(item, { pin = true } = {}) {
    if (pin) {
      pinnedComment = item;
      trackPinnedHighlight();
    }
    scrollFrameToComment(item);
  }

  // The page animates elements (intro, wheel) without scroll events, so follow the target per frame.
  let trackingFrame = 0;

  function trackPinnedHighlight() {
    cancelAnimationFrame(trackingFrame);
    const tick = () => {
      if (!pinnedComment) return;
      if (previewCardId === null) tryHighlightComment(pinnedComment);
      trackingFrame = requestAnimationFrame(tick);
    };
    tick();
  }

  function navigateToComment(item, { pin = true } = {}) {
    if (!frame) return;
    const targetUrl = resolveFrameUrl(item.pageUrl);
    let samePage = false;

    try {
      samePage = frame.contentWindow?.location.pathname === new URL(targetUrl).pathname;
    } catch {
      samePage = frame.src === targetUrl;
    }

    if (samePage && canAccessFrameDocument()) {
      onFrameReady(item, { pin });
      return;
    }

    const handleLoad = () => {
      frame?.removeEventListener('load', handleLoad);
      onFrameReady(item, { pin });
    };

    frame.addEventListener('load', handleLoad);
    frame.src = targetUrl;
  }

  async function deleteComment(id) {
    if (!window.confirm('Delete this comment permanently?')) return;

    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
        },
        body: '{}',
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.error || 'Could not delete comment.');
      }

      commentItems = commentItems.filter((item) => item.id !== id);
      if (activeCardId === id) activeCardId = null;
      if (pinnedComment?.id === id) {
        pinnedComment = null;
        hideHighlight();
      }
      renderSidebar();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not delete comment.');
    }
  }

  function clearSelection(id) {
    if (activeCardId === id) activeCardId = null;
    if (confirmCardId === id) confirmCardId = null;
    if (pinnedComment?.id === id) {
      pinnedComment = null;
      hideHighlight();
    }
  }

  async function archiveComment(item, reason) {
    cardErrors.delete(item.id);
    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(item.id)}/archive`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Could not archive comment.');
      item.archivedAt = data.archivedAt;
      item.archiveReason = data.reason;
      clearSelection(item.id);
    } catch (error) {
      cardErrors.set(item.id, error instanceof Error ? error.message : 'Could not archive comment.');
    }
    renderSidebar();
  }

  async function restoreComment(item) {
    cardErrors.delete(item.id);
    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(item.id)}/archive`, {
        method: 'DELETE',
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Could not restore comment.');
      item.archivedAt = null;
      item.archiveReason = null;
      clearSelection(item.id);
    } catch (error) {
      cardErrors.set(item.id, error instanceof Error ? error.message : 'Could not restore comment.');
    }
    renderSidebar();
  }

  async function openPr(item) {
    if (submittingId) return;
    submittingId = item.id;
    cardErrors.delete(item.id);
    renderSidebar();
    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(item.id)}/open-pr`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          reviewedComment: item.comment,
          note: noteDrafts.get(item.id) ?? '',
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Could not open a PR.');
      item.pr = { status: 'requested', branch: data.branch, sessionUrl: data.sessionUrl };
      noteDrafts.delete(item.id);
      confirmCardId = null;
    } catch (error) {
      cardErrors.set(item.id, error instanceof Error ? error.message : 'Could not open a PR.');
    }
    submittingId = null;
    renderSidebar();
  }

  function textButton(label, variant, onClick) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `button ${variant}`;
    button.textContent = label;
    button.addEventListener('click', onClick);
    return button;
  }

  function textLink(label, href) {
    const link = document.createElement('a');
    link.className = 'text-link';
    link.href = href;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = label;
    return link;
  }

  function archiveSelect(item, parent) {
    const select = document.createElement('select');
    select.className = 'dropdown-trigger';
    select.setAttribute('aria-label', 'Archive comment');
    const placeholder = new Option('Archive', '', true, true);
    placeholder.disabled = true;
    select.add(placeholder);
    for (const [value, label] of Object.entries(ARCHIVE_LABELS)) {
      select.add(new Option(label, value));
    }
    select.addEventListener('change', () => void archiveComment(item, select.value));
    parent.appendChild(select);
    enhanceSelect(select);
  }

  function renderActions(item) {
    const actions = document.createElement('div');
    actions.className = 'comment-sidebar-card-actions';
    actions.addEventListener('click', (event) => event.stopPropagation());

    if (item.archivedAt) {
      actions.appendChild(
        textButton('Restore', 'is-tertiary', () => void restoreComment(item)),
      );
      return actions;
    }

    if (item.pr?.status === 'requested') {
      const tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = 'PR requested';
      actions.appendChild(tag);
      if (item.pr.sessionUrl) actions.appendChild(textLink('Claude session', item.pr.sessionUrl));
      actions.appendChild(textLink('Branch', `${REPO_URL}/tree/${item.pr.branch}`));
      const copy = textButton('Copy preview command', 'is-tertiary', async () => {
        await navigator.clipboard.writeText(`npm run preview:pr ${item.shortId}`);
        copy.textContent = 'Copied';
      });
      actions.appendChild(copy);
    } else if (confirmCardId !== item.id) {
      actions.appendChild(
        textButton('Open PR', 'is-secondary', () => {
          confirmCardId = item.id;
          renderSidebar();
        }),
      );
    }

    archiveSelect(item, actions);
    return actions;
  }

  function renderConfirm(item) {
    const panel = document.createElement('div');
    panel.className = 'comment-sidebar-card-confirm';
    panel.addEventListener('click', (event) => event.stopPropagation());

    const intro = document.createElement('p');
    intro.className = 'comment-sidebar-card-title';
    intro.textContent = 'Claude will get this comment and:';
    panel.appendChild(intro);

    for (const line of contextSummary(item)) {
      const detail = document.createElement('p');
      detail.className = 'comment-sidebar-card-meta';
      detail.textContent = line;
      panel.appendChild(detail);
    }

    const noteId = `admin-note-${item.id}`;
    const label = document.createElement('label');
    label.className = 'comment-sidebar-card-title';
    label.htmlFor = noteId;
    label.textContent = 'Note to Claude (optional)';
    const note = document.createElement('textarea');
    note.id = noteId;
    note.className = 'comment-sidebar-card-body-input';
    note.rows = 2;
    note.maxLength = 2000;
    note.value = noteDrafts.get(item.id) ?? '';
    note.addEventListener('input', () => noteDrafts.set(item.id, note.value));
    panel.append(label, note);

    const row = document.createElement('div');
    row.className = 'comment-sidebar-card-confirm-actions';
    row.appendChild(
      textButton('Cancel', 'is-tertiary', () => {
        confirmCardId = null;
        cardErrors.delete(item.id);
        renderSidebar();
      }),
    );

    if (githubVerified) {
      const submit = textButton(
        submittingId === item.id ? 'Opening…' : 'Open PR',
        'is-secondary',
        () => void openPr(item),
      );
      submit.disabled = submittingId !== null;
      row.appendChild(submit);
    } else {
      const signIn = document.createElement('a');
      signIn.className = 'button is-secondary';
      signIn.href = `/api/auth/github/start?comment=${encodeURIComponent(item.id)}`;
      signIn.textContent = 'Sign in with GitHub';
      row.appendChild(signIn);
    }
    panel.appendChild(row);
    return panel;
  }

  function statusComments() {
    return commentItems.filter((item) =>
      status === 'archived' ? Boolean(item.archivedAt) : !item.archivedAt,
    );
  }

  function pageComments() {
    const path = currentFramePath();
    return statusComments().filter((item) => pagePathFromUrl(item.pageUrl) === path);
  }

  function renderSidebar() {
    if (!sidebarList) return;
    const onPage = pageComments();
    const all = statusComments();
    const items = scope === 'all' ? all : onPage;
    if (pageCountEl) pageCountEl.textContent = String(onPage.length);
    if (allCountEl) allCountEl.textContent = String(all.length);
    sidebarList.innerHTML = '';

    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'comment-sidebar-empty';
      const noun = status === 'archived' ? 'archived comments' : 'comments';
      empty.textContent = scope === 'page' ? `No ${noun} on this page.` : `No ${noun} yet.`;
      sidebarList.appendChild(empty);
      return;
    }

    for (const item of [...items].reverse()) {
      const card = document.createElement('article');
      card.className = `comment-sidebar-card comment-sidebar-card--readonly${activeCardId === item.id ? ' is-active' : ''}`;
      card.dataset.commentId = item.id;

      const header = document.createElement('div');
      header.className = 'comment-sidebar-card-header';

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'icon-control is-dismiss is-destructive inline-flex comment-sidebar-card-delete';
      deleteBtn.setAttribute('aria-label', 'Delete comment');
      deleteBtn.innerHTML = lucideSvg('x', 14);
      deleteBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        void deleteComment(item.id);
      });

      const title = document.createElement('p');
      title.className = 'comment-sidebar-card-title';
      title.textContent = item.elementDisplayName;

      const statusTag = item.archivedAt ? ARCHIVE_LABELS[item.archiveReason] : '';

      if (item.category || statusTag) {
        const category = document.createElement('span');
        category.className = 'tag comment-sidebar-card-category-label';
        category.textContent = statusTag || categoryLabel(item.category);
        header.append(category, deleteBtn);
        card.append(header, title);
      } else {
        header.classList.add('has-title');
        header.append(title, deleteBtn);
        card.appendChild(header);
      }

      const body = document.createElement('p');
      body.className = 'comment-sidebar-card-body';
      body.textContent = item.comment;
      card.appendChild(body);

      const meta = document.createElement('p');
      meta.className = 'comment-sidebar-card-meta';
      meta.textContent = formatMeta(item);
      card.appendChild(meta);

      card.appendChild(renderActions(item));
      if (confirmCardId === item.id && !item.archivedAt) card.appendChild(renderConfirm(item));

      const cardError = cardErrors.get(item.id);
      if (cardError) {
        const errorEl = document.createElement('p');
        errorEl.className = 'comment-sidebar-card-error';
        errorEl.setAttribute('role', 'alert');
        errorEl.textContent = cardError;
        card.appendChild(errorEl);
      }

      card.addEventListener('click', () => {
        activeCardId = item.id;
        previewCardId = null;
        navigateToComment(item, { pin: true });
        renderSidebar();
      });

      card.addEventListener('mouseenter', () => {
        previewCardId = item.id;
        const target = findFrameTarget(item);
        if (target) placeHighlight(target, 'preview');
      });

      card.addEventListener('mouseleave', () => {
        if (previewCardId === item.id) {
          previewCardId = null;
          if (pinnedComment) tryHighlightComment(pinnedComment);
          else hideHighlight();
        }
      });

      sidebarList.appendChild(card);
    }
  }

  function setScope(next) {
    scope = next;
    scopePageBtn?.classList.toggle('is-active', next === 'page');
    scopeAllBtn?.classList.toggle('is-active', next === 'all');
    scopePageBtn?.setAttribute('aria-selected', String(next === 'page'));
    scopeAllBtn?.setAttribute('aria-selected', String(next === 'all'));
    renderSidebar();
  }

  function setStatus(next) {
    status = next;
    statusActiveBtn?.setAttribute('aria-pressed', String(next === 'active'));
    statusArchivedBtn?.setAttribute('aria-pressed', String(next === 'archived'));
    activeCardId = null;
    pinnedComment = null;
    hideHighlight();
    renderSidebar();
  }

  statusActiveBtn?.addEventListener('click', () => setStatus('active'));
  statusArchivedBtn?.addEventListener('click', () => setStatus('archived'));
  scopePageBtn?.addEventListener('click', () => setScope('page'));
  scopeAllBtn?.addEventListener('click', () => setScope('all'));

  frame?.addEventListener('load', renderSidebar);

  document.body.classList.add('comment-view-comment');

  // Coming back from GitHub sign-in: reopen the comment you were about to act on.
  const reopenId = new URLSearchParams(window.location.search).get('open');
  if (reopenId && commentItems.some((item) => item.id === reopenId && !item.archivedAt)) {
    confirmCardId = reopenId;
    setScope('all');
    history.replaceState(null, '', window.location.pathname);
  } else {
    renderSidebar();
  }
</script>
