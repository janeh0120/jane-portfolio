---
import { site } from '../data/site';

interface Props {
  subhead?: string;
  /** Which type-ramp style the intro uses: Intro (Brand) or Compact (homepage, matching the experience list). */
  type?: 'intro' | 'compact';
}

const { subhead = site.hero.subhead, type = 'intro' } = Astro.props;
const intro = [site.hero.headline, subhead].filter(Boolean).join(' ');
---

<div class="home-hero">
  <h1 class:list={['text-ink', type === 'compact' ? 'text-compact' : 'text-intro']} data-comment-id="hero-intro">
    {intro}
  </h1>
</div>

<style>
  .home-hero {
    max-width: 28rem;
  }
</style>
