---
import { site } from '../data/site';

const linkClass =
  'social-link w-fit text-meta text-ink underline decoration-ink/40 underline-offset-[3px] transition hover:decoration-ink';
---

<div class="social-links flex flex-col items-start gap-3" data-comment-id="social-links">
  {
    site.footer.links.map((link) => {
      if ('type' in link && link.type === 'email') {
        return site.email ? (
          <button
            type="button"
            class:list={['copy-email', linkClass, 'bg-transparent p-0 text-left']}
            data-email={site.email}
            data-default-label={link.label}
            aria-label={link.label}
          >
            <span class="copy-email-label">{link.label}</span>
          </button>
        ) : null;
      }

      const href = site.links[link.hrefKey];

      return (
        <a href={href} target="_blank" rel="noopener noreferrer" class={linkClass}>
          {link.label}
        </a>
      );
    })
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('.copy-email-label');

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      const defaultLabel = btn.getAttribute('data-default-label') ?? 'Email';
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        btn.setAttribute('aria-label', 'Email copied');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          btn.setAttribute('aria-label', defaultLabel);
          if (label) label.textContent = defaultLabel;
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
