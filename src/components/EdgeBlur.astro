---
/**
 * Progressive blur at the top or bottom edge of the page.
 * Six stacked backdrop-blur layers at doubling strengths, each masked to its own overlapping band,
 * so content softens smoothly as it scrolls under an edge. The page's existing grain (body::after)
 * shows through, giving the grainy look — no extra grain layer, which read as a darker bar.
 *
 * Rendered as the first (top) and last (bottom) child of the page's scroll container and made
 * sticky there, so it matches that container exactly: its width, its rounded corners in comment
 * mode, and it never covers the comments sidebar beside it.
 * Purely decorative: pointer-events none, and browsers without backdrop-filter simply show nothing.
 */
interface Props {
  edge: 'top' | 'bottom';
}

const { edge } = Astro.props;
const layers = [1, 2, 4, 8, 16, 32];
---

<div class:list={['edge-blur', `edge-blur--${edge}`]} aria-hidden="true">
  {layers.map((px) => <div class="edge-blur-layer" style={`--blur: ${px}px`} />)}
</div>

<style>
  .edge-blur {
    position: sticky;
    display: block;
    width: 100%;
    height: var(--edge-height);
    /* above page content and the homepage lens (z 5), below the footer (z 10) and nav (z 50) */
    z-index: 8;
    pointer-events: none;
  }

  /* Sticky to the top of the scroll container without taking up space in the page flow */
  .edge-blur--top {
    --edge-height: clamp(6rem, 14vh, 9rem);
    --edge-direction: 0deg; /* strongest at the very top */
    top: 0;
    margin-bottom: calc(-1 * var(--edge-height));
  }

  .edge-blur--bottom {
    --edge-height: clamp(4.5rem, 10vh, 7rem);
    --edge-direction: 180deg;
    bottom: 0;
    margin-top: calc(-1 * var(--edge-height));
  }

  .edge-blur-layer {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
  }

  /* Each layer covers its own slice; slices overlap so the blur ramps smoothly toward the edge */
  .edge-blur-layer:nth-child(1) {
    mask-image: linear-gradient(var(--edge-direction), transparent 12.5%, #000 25%, #000 37.5%, transparent 50%);
  }
  .edge-blur-layer:nth-child(2) {
    mask-image: linear-gradient(var(--edge-direction), transparent 25%, #000 37.5%, #000 50%, transparent 62.5%);
  }
  .edge-blur-layer:nth-child(3) {
    mask-image: linear-gradient(var(--edge-direction), transparent 37.5%, #000 50%, #000 62.5%, transparent 75%);
  }
  .edge-blur-layer:nth-child(4) {
    mask-image: linear-gradient(var(--edge-direction), transparent 50%, #000 62.5%, #000 75%, transparent 87.5%);
  }
  .edge-blur-layer:nth-child(5) {
    mask-image: linear-gradient(var(--edge-direction), transparent 62.5%, #000 75%, #000 87.5%, transparent);
  }
  .edge-blur-layer:nth-child(6) {
    mask-image: linear-gradient(var(--edge-direction), transparent 75%, #000 87.5%, #000);
  }
</style>
