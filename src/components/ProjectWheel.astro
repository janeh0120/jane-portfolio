---
import { site } from '../data/site';
import { formatProjectTags } from '../utils/tags';

const base = import.meta.env.BASE_URL;
const projects = site.projects;

function commentId(project: (typeof projects)[number]) {
  return project.slug
    ? `project-${project.slug}`
    : `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
}
---

<div
  class="project-wheel"
  data-project-wheel
  style={`--wheel-count: ${projects.length}`}
>
  <div class="project-wheel-scene">
    <div class="project-wheel-rotor" data-wheel-rotor>
      {
        projects.map((project, index) => {
          const href = project.href ?? (project.slug ? `${base}${project.slug}` : undefined);
          const external = Boolean(href?.startsWith('http'));
          const imageSrc = `${base}${project.image}`;
          return (
            <article
              class="wheel-card"
              style={`--i: ${index}`}
              data-comment-id={commentId(project)}
            >
              {project.comingSoon || !href ? (
                <div class="wheel-card-link">
                  <div class="project-card-media">
                    <img src={imageSrc} alt={project.title} class="wheel-card-image" />
                  </div>
                  <p class="text-body text-muted">{formatProjectTags(project.tags)}</p>
                  <h3 class="subheading text-ink">{project.title}</h3>
                </div>
              ) : (
                <a
                  href={href}
                  class="wheel-card-link"
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <div class="project-card-media">
                    <img src={imageSrc} alt="" class="wheel-card-image" />
                  </div>
                  <p class="text-body text-muted">{formatProjectTags(project.tags)}</p>
                  <h3 class="subheading text-ink">{project.title}</h3>
                </a>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .project-wheel {
    --wheel-step: 24deg;
    --wheel-radius: 920px;
    position: relative;
    min-height: 0;
    height: 100%;
    overflow: visible;
  }

  .project-wheel-scene {
    position: absolute;
    inset: 0;
  }

  .project-wheel-rotor {
    position: absolute;
    top: 50%;
    left: 0;
    width: min(100%, 24rem);
    height: 0;
  }

  .wheel-card {
    --angle: calc(var(--i) * var(--wheel-step) + var(--circle-turn, 0deg));
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    transform-origin: center center;
    transform: translate(
        calc(var(--wheel-radius) * (1 - cos(var(--angle)))),
        calc(var(--wheel-radius) * sin(var(--angle)))
      )
      translateY(-50%) rotate(calc(var(--angle) * -1));
  }

  .wheel-card-link {
    display: grid;
    gap: 0.2rem;
    color: inherit;
    text-decoration: none;
  }

  .wheel-card-link .project-card-media {
    margin-bottom: 0.4rem;
  }

  .wheel-card-link p {
    line-height: 1.3;
  }

  .wheel-card-image {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
    display: block;
  }

  .wheel-card-link:hover .wheel-card-image {
    opacity: 0.92;
  }

  .wheel-card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 767px) {
    .project-wheel {
      height: auto;
      min-height: 0;
      width: 100%;
    }

    .project-wheel-scene {
      position: static;
      perspective: none;
    }

    .project-wheel-rotor {
      position: static;
      width: 100%;
      height: auto;
      transform: none;
    }

    .wheel-card {
      position: relative;
      width: 100%;
      margin-bottom: 2.25rem;
      transform: none;
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: reduce) {
    .project-wheel {
      height: auto;
      overflow: visible;
    }

    .project-wheel-scene {
      position: static;
      display: block;
      perspective: none;
    }

    .project-wheel-rotor {
      height: auto;
      width: 100%;
      transform: none !important;
    }

    .wheel-card {
      position: relative;
      top: auto;
      margin-bottom: 2.5rem;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (min-width: 768px) and (scripting: none) {
    .project-wheel {
      height: auto;
      overflow: visible;
    }

    .project-wheel-scene {
      position: static;
      display: block;
      perspective: none;
    }

    .project-wheel-rotor {
      height: auto;
      transform: none;
    }

    .wheel-card {
      position: relative;
      margin-bottom: 2.5rem;
      transform: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wheel = document.querySelector<HTMLElement>('[data-project-wheel]');
  const rotor = wheel?.querySelector<HTMLElement>('[data-wheel-rotor]');
  const stage = document.querySelector<HTMLElement>('[data-home-stage]');
  const cards = wheel ? [...wheel.querySelectorAll<HTMLElement>('.wheel-card')] : [];

  function stepDegrees() {
    if (!wheel) return 24;
    const raw = getComputedStyle(wheel).getPropertyValue('--wheel-step');
    const value = parseFloat(raw);
    return Number.isFinite(value) ? value : 24;
  }

  const wide = window.matchMedia('(min-width: 768px)');

  function clearWheelStyles() {
    rotor?.style.removeProperty('--circle-turn');
    cards.forEach((card) => {
      card.style.zIndex = '';
      card.style.pointerEvents = '';
      card.style.transform = '';
      card.querySelector<HTMLElement>('.wheel-card-link')?.style.removeProperty('opacity');
      card.querySelectorAll<HTMLElement>('p, h3').forEach((node) => {
        node.style.opacity = '';
      });
    });
  }

  function update() {
    if (!wheel || !rotor || !stage || cards.length < 2) return;
    if (!wide.matches) {
      clearWheelStyles();
      return;
    }
    cards.forEach((card) => {
      card.style.transform = '';
    });
    const canvas = document.getElementById('site-canvas');
    const scroller = canvas ?? document.documentElement;
    const viewTop = canvas ? canvas.getBoundingClientRect().top : 0;
    const viewHeight = canvas ? canvas.clientHeight : window.innerHeight;
    const stageRect = stage.getBoundingClientRect();
    const stageTop = stageRect.top - viewTop + scroller.scrollTop;
    const pin = stage.querySelector<HTMLElement>('.home-stage-pin');
    const stick = pin ? parseFloat(getComputedStyle(pin).top) || 0 : 0;
    const travel = Math.max(stage.offsetHeight - viewHeight, 1);
    const progress = Math.min(1, Math.max(0, (scroller.scrollTop - (stageTop - stick)) / travel));
    const step = stepDegrees();
    const spin = -progress * (cards.length - 1) * step;
    rotor.style.setProperty('--circle-turn', `${spin}deg`);

    cards.forEach((card, index) => {
      let delta = index * step + spin;
      delta = ((delta % 360) + 360) % 360;
      if (delta > 180) delta -= 360;
      const distance = Math.abs(delta);
      const face = card.querySelector<HTMLElement>('.wheel-card-link');
      const opacity = distance < 28 ? 1 : Math.max(0, 1 - (distance - 28) / 52);
      if (face) face.style.opacity = opacity.toFixed(3);
      card.style.zIndex = String(100 - Math.round(distance));
      card.style.pointerEvents = distance < 14 ? 'auto' : 'none';
    });
  }

  if (wheel && rotor && stage) {
    const canvas = document.getElementById('site-canvas');
    let frame = 0;
    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    };
    (canvas ?? window).addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    update();

    if (!reduceMotion && window.location.hash === '#projects') {
      stage.scrollIntoView({ block: 'start' });
      update();
    }
  }
</script>
