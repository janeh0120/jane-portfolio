---
/**
 * Homepage projects as a straight vertical column that scrolls with the page.
 * A WebGL lens (src/lib/project-lens.ts) warps the images as they pass the top and bottom of the
 * screen. The lens is progressive enhancement: this column is complete, readable HTML on its own,
 * and the lens only ever takes over an image once it has proven it can draw it.
 */
import { site } from '../data/site';
import { formatProjectTags } from '../utils/tags';
import FeedbackDemoReel from './react/FeedbackDemoReel';

const base = import.meta.env.BASE_URL;
const projects = site.projects;

function commentId(project: (typeof projects)[number]) {
  return project.slug
    ? `project-${project.slug}`
    : `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
}
---

<div class="project-column" data-project-column>
  {
    projects.map((project) => {
      const href = project.href ?? (project.slug ? `${base}${project.slug}` : undefined);
      const external = Boolean(href?.startsWith('http'));
      const imageSrc = `${base}${project.image}`;
      const media = (
        <div class="project-card-media" data-lens-src={imageSrc}>
          {project.slug === 'feedback' ? (
            <FeedbackDemoReel client:visible aspect="16/10" />
          ) : (
            <img src={imageSrc} alt={href ? '' : project.title} class="project-column-image" />
          )}
        </div>
      );
      const caption = (
        <div class="project-column-caption" data-lens-caption>
          <p class="text-body text-muted">{formatProjectTags(project.tags)}</p>
          <h3 class="subheading text-ink">{project.title}</h3>
        </div>
      );
      return (
        <article class="project-column-card" data-comment-id={commentId(project)}>
          {project.comingSoon || !href ? (
            <div class="project-column-link">
              {media}
              {caption}
            </div>
          ) : (
            <a
              href={href}
              class="project-column-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {media}
              {caption}
            </a>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .project-column {
    display: grid;
    gap: clamp(3rem, 9svh, 6rem);
    /* room above and below so every card can scroll all the way through the top and bottom lens */
    padding-block: 18svh 32svh;
  }

  .project-column-link {
    display: grid;
    gap: 0.2rem;
    color: inherit;
    text-decoration: none;
  }

  .project-column-link .project-card-media {
    margin-bottom: 0.4rem;
  }

  .project-column-link p {
    line-height: 1.3;
  }

  .project-column-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-column-caption {
    display: grid;
    gap: 0.2rem;
    transition: opacity 0.25s ease;
  }

  .project-column-link:hover .project-column-image,
  .project-column-link:hover :global(.feedback-demo-reel) {
    opacity: 0.92;
  }

  .project-column-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 767px) {
    .project-column {
      gap: 2.25rem;
      padding-block: 0 2rem;
    }
  }
</style>

<script>
  // Progressive enhancement: the lens loads after the page is up, only where it can run well,
  // and any failure (download, WebGL, shader, runtime) leaves the plain HTML column in place.
  const column = document.querySelector<HTMLElement>('[data-project-column]');
  const wide = window.matchMedia('(min-width: 768px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  async function enhance() {
    if (!column || !wide.matches || reduceMotion.matches) return;
    try {
      const { startProjectLens } = await import('../lib/project-lens');
      startProjectLens(column);
    } catch (error) {
      console.warn('Lens effect unavailable; showing the standard layout.', error);
    }
  }

  const whenIdle = (fn: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200);

  if (document.readyState === 'complete') whenIdle(enhance);
  else window.addEventListener('load', () => whenIdle(enhance), { once: true });
</script>
