---
/**
 * Homepage projects as a straight vertical column that scrolls with the page.
 * A WebGL lens (src/lib/project-lens.ts) warps the images as they pass the top and bottom of the
 * screen. The lens is progressive enhancement: this column is complete, readable HTML on its own,
 * and the lens only ever takes over an image once it has proven it can draw it.
 */
import { site } from '../data/site';
import { formatProjectTags } from '../utils/tags';

const base = import.meta.env.BASE_URL;
const projects = site.projects;

function commentId(project: (typeof projects)[number]) {
  return project.slug
    ? `project-${project.slug}`
    : `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
}
---

<div class="project-column" data-project-column>
  {
    projects.map((project) => {
      const href = project.href ?? (project.slug ? `${base}${project.slug}` : undefined);
      const external = Boolean(href?.startsWith('http'));
      const imageSrc = `${base}${project.image}`;
      const media = (
        <div class="project-card-media" data-lens-src={imageSrc}>
          {/* Stills only: the lens swaps any card touching the top/bottom zones for a flat image, and at
              typical viewport heights a card never clears both, so live demos here would never be seen. */}
          <img src={imageSrc} alt={href ? '' : project.title} class="project-column-image" />
        </div>
      );
      const caption = (
        <div class="project-column-caption" data-lens-caption>
          <p class="text-body text-muted">{formatProjectTags(project.tags)}</p>
          <h3 class="subheading text-ink">{project.title}</h3>
        </div>
      );
      return (
        <article class="project-column-card" data-comment-id={commentId(project)}>
          {project.comingSoon || !href ? (
            <div class="project-column-link">
              {media}
              {caption}
            </div>
          ) : (
            <a
              href={href}
              class="project-column-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {media}
              {caption}
            </a>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .project-column {
    display: grid;
    gap: clamp(3rem, 9svh, 6rem);
    /* room above and below so every card can scroll all the way through the top and bottom lens */
    padding-block: 18svh 32svh;
  }

  .project-column-link {
    display: grid;
    gap: 0.2rem;
    color: inherit;
    text-decoration: none;
  }

  .project-column-link .project-card-media {
    margin-bottom: 0.4rem;
  }

  .project-column-link p {
    line-height: 1.3;
  }

  .project-column-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-column-caption {
    display: grid;
    gap: 0.2rem;
    transition: opacity 0.25s ease;
  }

  .project-column-link:hover .project-column-image {
    opacity: 0.92;
  }

  .project-column-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 767px) {
    .project-column {
      gap: 2.25rem;
      padding-block: 0 2rem;
    }
  }
</style>

<script>
  import { enhanceWithLens } from '../lib/lens-enhance';

  enhanceWithLens(document.querySelector<HTMLElement>('[data-project-column]'));
</script>
