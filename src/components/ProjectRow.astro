---
/**
 * Homepage projects as one horizontal row that scrolls sideways. From 768px up, the mouse wheel
 * moves it across while the pointer is over it (anywhere else the page scrolls down as usual), and
 * glass arrow controls appear on hover to centre the previous or next card. Without JavaScript it
 * is a plain sideways scroller and the arrows stay hidden.
 * A WebGL lens (src/lib/project-lens.ts) warps the images as they pass the left and right edges of
 * the screen. It is progressive enhancement: the row is complete, readable HTML on its own.
 */
import { site } from '../data/site';
import { formatProjectTags } from '../utils/tags';
import IconControl from './IconControl.astro';

const base = import.meta.env.BASE_URL;
const projects = site.projects;

function commentId(project: (typeof projects)[number]) {
  return project.slug
    ? `project-${project.slug}`
    : `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
}
---

<div class="project-row-frame" data-project-row-frame>
<div class="project-row" data-project-row role="region" aria-label="Case studies">
  {
    projects.map((project) => {
      const href = project.href ?? (project.slug ? `${base}${project.slug}` : undefined);
      const external = Boolean(href?.startsWith('http'));
      const imageSrc = `${base}${project.image}`;
      const media = (
        <div class="project-card-media" data-lens-src={imageSrc}>
          {project.video ? (
            <video
              src={`${base}${project.video}`}
              poster={imageSrc}
              class="project-row-image"
              data-card-video
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              aria-hidden={href ? 'true' : undefined}
              aria-label={href ? undefined : project.title}
            />
          ) : (
            <img src={imageSrc} alt={href ? '' : project.title} class="project-row-image" draggable="false" />
          )}
          {project.logo ? (
            <img src={`${base}${project.logo}`} alt="" class="project-row-logo" data-lens-logo draggable="false" />
          ) : null}
        </div>
      );
      const caption = (
        <div class="project-row-caption" data-lens-caption>
          <p class="text-body text-muted">{formatProjectTags(project.tags)}</p>
          <h3 class="subheading text-ink">{project.title}</h3>
        </div>
      );
      return (
        <article class="project-row-card" data-comment-id={commentId(project)}>
          {project.comingSoon || !href ? (
            <div class="project-row-link">
              {media}
              {caption}
            </div>
          ) : (
            <a
              href={href}
              class="project-row-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {media}
              {caption}
            </a>
          )}
        </article>
      );
    })
  }
</div>
<IconControl
  label="Previous case study"
  icon="arrow-left"
  class="is-glass project-row-arrow project-row-arrow--prev"
  data-row-step="-1"
  hidden
/>
<IconControl
  label="Next case study"
  icon="arrow-right"
  class="is-glass project-row-arrow project-row-arrow--next"
  data-row-step="1"
  hidden
/>
</div>

<style>
  /* Full width, padded by half the space beside one card, so the first card sits centred on load
     and the last is centred when the row reaches its end (padding % is of the row's width) */
  /* Cards grow past 36rem on wide screens (up to 52rem) while their 16:10 image still fits below
     the intro, so tall, wide screens aren't left with empty space under the row */
  .project-row-frame {
    --card-width: clamp(16rem, 36vw, max(36rem, min(52rem, (100vh - 30rem) * 1.6))); /* design-tokens-ignore: card width, not spacing */
    position: relative;
  }

  .project-row {
    --row-gutter: calc((100% - var(--card-width)) / 2);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--card-width);
    gap: var(--space-8);
    padding-inline: var(--row-gutter);
    padding-block: var(--space-2) var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--row-gutter);
    scrollbar-width: none;
  }

  .project-row::-webkit-scrollbar {
    display: none;
  }

  /* When the wheel moves the row (the script below), snapping would pull each small step back to a
     card; the arrows do the centring instead */
  .project-row.is-wheel {
    scroll-snap-type: none;
  }

  /* Arrows sit at the screen edges, centred on the card images (16:10, below the row's top
     padding), above the side edge blur (z 8). They fade in while the row is hovered or one of them
     has keyboard focus. */
  .project-row-arrow {
    position: absolute;
    top: calc(var(--space-2) + var(--card-width) * 0.3125); /* design-tokens-ignore: half a 16:10 image's height */
    z-index: 9;
    translate: 0 -50%;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-150) var(--ease-standard),
      color var(--duration-150) var(--ease-standard),
      background var(--duration-150) var(--ease-standard),
      transform var(--duration-150) var(--ease-standard);
  }

  .project-row-arrow--prev {
    left: var(--space-6);
  }

  .project-row-arrow--next {
    right: var(--space-6);
  }

  .project-row-frame:hover .project-row-arrow:not(:disabled),
  .project-row-frame:has(.project-row-arrow:focus-visible) .project-row-arrow:not(:disabled) {
    opacity: 1;
    pointer-events: auto;
  }

  .project-row-card {
    scroll-snap-align: center;
    min-width: 0;
  }

  .project-row-link {
    display: grid;
    gap: var(--space-1);
    color: inherit;
    text-decoration: none;
  }

  .project-row-link .project-card-media {
    position: relative;
    margin-bottom: var(--space-2);
  }

  /* In percentages so it scales with the card and the lens's copy of the image (which draws the
     logo in at these proportions) still lines up after a resize. Top is a % of the height, so
     6.4% of a 16:10 card matches 4% of its width. */
  .project-row-logo {
    position: absolute;
    top: 6.4%; /* design-tokens-ignore: proportional to the card, see above */
    left: 4%; /* design-tokens-ignore: proportional to the card, see above */
    width: 14%;
    height: auto;
  }

  .project-row-link p {
    font: var(--type-compact);
  }

  .project-row-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-row-caption {
    display: grid;
    gap: var(--space-1);
    transition: opacity var(--duration-200) var(--ease-standard);
  }

  .project-row-link:hover .project-row-image {
    opacity: 0.92;
  }

  .project-row-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Phones: one column that scrolls with the page instead of a sideways row */
  @media (max-width: 767px) {
    .project-row {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      padding-inline: 0;
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .project-row-arrow {
      display: none;
    }
  }
</style>

<script>
  import { enhanceWithLens } from '../lib/lens-enhance';

  enhanceWithLens(document.querySelector<HTMLElement>('[data-project-row]'), { axis: 'x' });

  // From 768px up: the mouse wheel moves the row across while the pointer is over it, and the arrows
  // centre the previous or next card. Phones stack the cards in a column, so none of this runs.
  function enhanceRow() {
    const frame = document.querySelector<HTMLElement>('[data-project-row-frame]');
    const row = frame?.querySelector<HTMLElement>('[data-project-row]');
    if (!frame || !row) return;
    const arrows = [...frame.querySelectorAll<HTMLButtonElement>('[data-row-step]')];
    const cards = [...row.querySelectorAll<HTMLElement>('.project-row-card')];
    const wide = window.matchMedia('(min-width: 768px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const maxScroll = () => row.scrollWidth - row.clientWidth;

    // Where the row stops with each card centred, clamped to the ends (the first card starts in
    // line with the intro, so its stop is the start of the row)
    const stops = () => {
      const max = maxScroll();
      const stopsList = cards.map((card) =>
        Math.round(Math.min(max, Math.max(0, card.offsetLeft + card.offsetWidth / 2 - row.clientWidth / 2))),
      );
      return [...new Set(stopsList)].sort((a, b) => a - b);
    };

    const syncArrows = () => {
      const at = row.scrollLeft;
      const list = stops();
      arrows.forEach((arrow) => {
        const step = Number(arrow.dataset.rowStep);
        arrow.disabled = step < 0 ? !list.some((stop) => stop < at - 2) : !list.some((stop) => stop > at + 2);
      });
    };

    const update = () => {
      row.classList.toggle('is-wheel', wide.matches);
      arrows.forEach((arrow) => (arrow.hidden = !wide.matches));
      syncArrows();
    };

    // Vertical wheel turns become sideways movement until the row reaches its end in that
    // direction; from there the page carries on scrolling, so the row never traps the pointer.
    // Sideways swipes and pinch-zoom are left to the browser.
    row.addEventListener(
      'wheel',
      (event) => {
        if (!wide.matches || event.ctrlKey || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        const delta = event.deltaMode === 1 ? event.deltaY * 16 : event.deltaMode === 2 ? event.deltaY * row.clientWidth : event.deltaY;
        const max = maxScroll();
        if ((delta < 0 && row.scrollLeft <= 0) || (delta > 0 && row.scrollLeft >= max - 1)) return;
        event.preventDefault();
        row.scrollLeft = Math.min(max, Math.max(0, row.scrollLeft + delta));
      },
      { passive: false },
    );

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => {
        const step = Number(arrow.dataset.rowStep);
        const at = row.scrollLeft;
        const list = stops();
        const target = step < 0 ? list.filter((stop) => stop < at - 2).pop() : list.find((stop) => stop > at + 2);
        if (target === undefined) return;
        row.scrollTo({ left: target, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      }),
    );

    row.addEventListener('scroll', syncArrows, { passive: true });
    wide.addEventListener('change', update);
    window.addEventListener('resize', syncArrows);
    row.querySelectorAll('img').forEach((img) => img.addEventListener('load', syncArrows, { once: true }));
    update();
  }

  enhanceRow();

  // Card reels show their poster until they can be seen. Nothing downloads before then, and a reel
  // only plays while it is on screen, the tab is open, and the lens isn't drawing that card.
  function startCardVideos() {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const syncs = [...document.querySelectorAll<HTMLVideoElement>('[data-card-video]')].map((video) => {
      const media = video.parentElement!;
      let inView = false;
      const sync = () => {
        const play = inView && !document.hidden && !reduceMotion.matches && media.style.opacity !== '0';
        if (play && video.paused) video.play().catch(() => {}); // e.g. low power mode: the poster stays
        else if (!play && !video.paused) video.pause();
      };
      new IntersectionObserver(
        ([entry]) => {
          // Coming into view, a reel starts again from the beginning rather than mid-way
          if (entry.isIntersecting && !inView && video.currentTime > 0) video.currentTime = 0;
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.25 },
      ).observe(video);
      new MutationObserver(sync).observe(media, { attributes: true, attributeFilter: ['style'] });
      return sync;
    });

    const syncAll = () => syncs.forEach((sync) => sync());
    document.addEventListener('visibilitychange', syncAll);
    reduceMotion.addEventListener('change', syncAll);
  }

  // After the page has loaded, and late enough for the lens to claim the cards at the screen edges,
  // so their reels are never fetched for nothing.
  const startSoon = () => setTimeout(startCardVideos, 800);
  if (document.readyState === 'complete') startSoon();
  else window.addEventListener('load', startSoon, { once: true });
</script>
