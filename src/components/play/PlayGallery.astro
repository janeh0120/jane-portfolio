---
import { galleryItems } from '../../lib/play-gallery';
import ArrowIcon from '../ArrowIcon.astro';

const base = import.meta.env.BASE_URL;

function mediaSrc(path: string) {
  if (path.startsWith('data:') || path.startsWith('http')) return path;
  return `${base}${path}`;
}

function isVideo(path: string) {
  return /\.(mp4|webm|mov|m4v)$/i.test(path);
}
---

<section class="gallery-section">
  <div class="gallery-grid" id="gallery-grid">
    {
      galleryItems.map((item) => {
        const first = item.images[0];
        const preview = item.thumb ?? first;
        const previewIsVideo = !item.thumb && isVideo(first);
        return (
          <button
            type="button"
            class:list={['gallery-item', item.images.length > 1 && 'carousel']}
            data-gallery-id={item.id}
            data-lens-src={previewIsVideo ? undefined : mediaSrc(preview)}
            aria-label={`Open ${item.title}`}
          >
            {previewIsVideo ? (
              <video
                src={mediaSrc(first)}
                muted
                playsinline
                preload="metadata"
                aria-label={item.title}
              />
            ) : (
              <img
                src={mediaSrc(preview)}
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            )}
          </button>
        );
      })
    }
  </div>
</section>

<div class="gallery-modal" id="gallery-modal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="gallery-modal-content">
    <button type="button" class="gallery-modal-close" id="gallery-modal-close" aria-label="Close">
      ×
    </button>

    <div class="gallery-carousel-container">
      <div class="gallery-carousel" id="carousel-slides" />
      <div class="carousel-controls-wrap" id="carousel-controls" hidden>
        <button type="button" class="carousel-arrow prev" id="carousel-prev" aria-label="Previous slide">
          <ArrowIcon direction="left" size="18px" />
        </button>
        <div class="carousel-controls" id="carousel-dots" />
        <button type="button" class="carousel-arrow next" id="carousel-next" aria-label="Next slide">
          <ArrowIcon direction="right" size="18px" />
        </button>
      </div>
    </div>

    <p class="gallery-modal-description" id="modal-description" />
    <div class="gallery-mode-toggle" id="modal-mode-toggle" role="group" aria-label="Illustration colour mode" hidden>
      <span class="gallery-mode-thumb" aria-hidden="true"></span>
      <button type="button" class="gallery-mode-option" data-mode-choice="light" aria-pressed="true">Light</button>
      <button type="button" class="gallery-mode-option" data-mode-choice="dark" aria-pressed="false">Dark</button>
    </div>
  </div>
</div>

<script>
  import { enhanceWithLens } from '../../lib/lens-enhance';

  // Same top/bottom lens warp as the homepage, toned down; the gallery is complete without it.
  enhanceWithLens(document.getElementById('gallery-grid'), { strength: 0.4 });
</script>

<script define:vars={{ galleryItems, base }}>
  function resolveSrc(path) {
    if (path.startsWith('data:') || path.startsWith('http')) return path;
    return `${base}${path}`;
  }

  function isVideo(path) {
    return /\.(mp4|webm|mov|m4v)$/i.test(path);
  }

  let currentItemId = null;
  let currentSlideIndex = 0;

  const modal = document.getElementById('gallery-modal');
  const carouselSlides = document.getElementById('carousel-slides');
  const carouselDots = document.getElementById('carousel-dots');
  const carouselControls = document.getElementById('carousel-controls');
  const modalDescription = document.getElementById('modal-description');
  const modeToggle = document.getElementById('modal-mode-toggle');
  const modeButtons = modeToggle ? [...modeToggle.querySelectorAll('[data-mode-choice]')] : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let modeTouched = false;
  let modeHintTimer = 0;

  // Light/dark toggle for items with dark versions: follows the site's colour mode, flips once
  // on its own as a hint, and the viewer can switch it any time (like the /brand page).
  const siteMode = () => (document.documentElement.classList.contains('theme-dark') ? 'dark' : 'light');

  function setMode(mode) {
    if (!modal) return;
    modal.dataset.mode = mode;
    modeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.modeChoice === mode)));
  }

  modeButtons.forEach((button) =>
    button.addEventListener('click', () => {
      modeTouched = true;
      setMode(button.dataset.modeChoice);
    }),
  );

  new MutationObserver(() => {
    if (modeToggle && !modeToggle.hidden) setMode(siteMode());
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  function pauseAllVideos() {
    carouselSlides?.querySelectorAll('video').forEach((video) => {
      video.pause();
    });
  }

  function playActiveVideo() {
    const slides = carouselSlides?.querySelectorAll('.gallery-carousel-slide');
    const active = slides?.[currentSlideIndex];
    const video = active?.querySelector('video');
    if (video) {
      video.currentTime = 0;
      void video.play().catch(() => {});
    }
  }

  function updateCarousel() {
    if (!carouselSlides) return;
    carouselSlides.style.transform = `translateX(-${currentSlideIndex * 100}%)`;
    carouselDots?.querySelectorAll('.carousel-dot').forEach((dot, index) => {
      dot.classList.toggle('active', index === currentSlideIndex);
    });
    pauseAllVideos();
    playActiveVideo();
  }

  function goToSlide(index) {
    const item = galleryItems.find((i) => i.id === currentItemId);
    if (!item) return;
    currentSlideIndex = index;
    updateCarousel();
  }

  function nextSlide() {
    const item = galleryItems.find((i) => i.id === currentItemId);
    if (!item) return;
    currentSlideIndex = (currentSlideIndex + 1) % item.images.length;
    updateCarousel();
  }

  function previousSlide() {
    const item = galleryItems.find((i) => i.id === currentItemId);
    if (!item) return;
    currentSlideIndex = (currentSlideIndex - 1 + item.images.length) % item.images.length;
    updateCarousel();
  }

  function openGallery(itemId) {
    const item = galleryItems.find((i) => i.id === itemId);
    if (!item || !modal || !carouselSlides) return;

    currentItemId = itemId;
    currentSlideIndex = 0;

    carouselSlides.innerHTML = '';
    carouselDots.innerHTML = '';
    const themed = Array.isArray(item.darkImages) && item.darkImages.length === item.images.length;

    item.images.forEach((media, index) => {
      const slide = document.createElement('div');
      slide.className = 'gallery-carousel-slide';
      const darkMedia = themed ? item.darkImages[index] : null;
      if (isVideo(media)) {
        slide.innerHTML = `<video src="${resolveSrc(media)}" muted playsinline loop controls preload="metadata"></video>`;
      } else if (darkMedia) {
        slide.innerHTML = `<div class="gallery-themed"><img class="gallery-mode-light" src="${resolveSrc(media)}" alt="Slide ${index + 1}"><img class="gallery-mode-dark" src="${resolveSrc(darkMedia)}" alt=""></div>`;
      } else {
        slide.innerHTML = `<img src="${resolveSrc(media)}" alt="Slide ${index + 1}">`;
      }
      carouselSlides.appendChild(slide);

      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = `carousel-dot${index === 0 ? ' active' : ''}`;
      dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
      dot.addEventListener('click', () => goToSlide(index));
      carouselDots?.appendChild(dot);
    });

    if (carouselControls) {
      carouselControls.hidden = item.images.length <= 1;
    }

    if (modalDescription) modalDescription.textContent = item.description;

    clearTimeout(modeHintTimer);
    if (modeToggle) modeToggle.hidden = !themed;
    if (themed) {
      modeTouched = false;
      setMode(siteMode());
      if (!reduceMotion) {
        modeHintTimer = setTimeout(() => {
          if (!modeTouched && currentItemId === itemId) setMode(modal.dataset.mode === 'dark' ? 'light' : 'dark');
        }, 1000);
      }
    } else {
      delete modal.dataset.mode;
    }

    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    updateCarousel();
  }

  function closeGallery() {
    clearTimeout(modeHintTimer);
    pauseAllVideos();
    modal?.classList.remove('active');
    modal?.setAttribute('aria-hidden', 'true');
    currentItemId = null;
    currentSlideIndex = 0;
  }

  document.querySelectorAll('[data-gallery-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = Number(button.getAttribute('data-gallery-id'));
      openGallery(id);
    });
  });

  document.getElementById('gallery-modal-close')?.addEventListener('click', closeGallery);
  document.getElementById('carousel-prev')?.addEventListener('click', previousSlide);
  document.getElementById('carousel-next')?.addEventListener('click', nextSlide);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeGallery();
  });

  document.addEventListener('keydown', (event) => {
    if (!modal?.classList.contains('active')) return;
    if (event.key === 'Escape') closeGallery();
    if (event.key === 'ArrowRight') nextSlide();
    if (event.key === 'ArrowLeft') previousSlide();
  });
</script>
