---
import { site } from '../data/site';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="mx-auto max-w-[1400px] px-6 pb-24 md:px-10 md:pb-32" data-comment-id="project-grid">
  <div id="project-grid" class="grid gap-x-8 gap-y-12 md:grid-cols-2 md:gap-x-10 md:gap-y-16">
    {site.projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
