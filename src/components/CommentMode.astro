<div data-comment-ui>
  <button
    type="button"
    class="comment-mode-toggle"
    id="comment-mode-toggle"
    aria-pressed="false"
  >
    Leave feedback
  </button>

  <aside class="comment-sidebar" id="comment-sidebar" data-comment-ui aria-label="Comments">
    <div class="comment-sidebar-panel">
      <div class="comment-sidebar-header">
        <div class="comment-sidebar-header-row">
          <span class="comment-sidebar-title">Comments</span>
          <div id="comment-sidebar-toggle-anchor" class="comment-sidebar-toggle-anchor" data-comment-ui></div>
        </div>
        <!-- Public "All" comments UI — re-enable via PUBLIC_COMMENTS_ENABLED in the script below -->
        <div class="comment-sidebar-tabs" id="comment-sidebar-tabs" role="tablist" aria-label="Comment list" hidden>
          <button
            type="button"
            id="comment-scope-mine"
            class="comment-sidebar-tab is-active"
            role="tab"
            aria-selected="true"
            aria-controls="comment-sidebar-list"
          >
            Mine
          </button>
          <button
            type="button"
            id="comment-scope-all"
            class="comment-sidebar-tab"
            role="tab"
            aria-selected="false"
            aria-controls="comment-sidebar-list"
          >
            All
          </button>
        </div>
      </div>
      <div class="comment-sidebar-list" id="comment-sidebar-list" role="tabpanel"></div>
    </div>
  </aside>

  <div class="comment-mode-highlights" id="comment-highlights" aria-hidden="true"></div>

  <div class="comment-popover" id="comment-popover" hidden data-comment-ui>
    <div class="comment-popover-card">
      <div class="comment-popover-body">
        <div class="comment-popover-compose">
          <div class="comment-popover-chips" id="comment-target-chips"></div>
          <textarea
            id="comment-text"
            rows="1"
            placeholder="Leave feedback…"
            maxlength="2000"
          ></textarea>
        </div>
        <div class="comment-popover-footer">
          <select
            id="comment-category-select"
            class="comment-popover-category-select"
            aria-label="Comment category (optional)"
          ></select>
          <button type="button" class="comment-popover-send" id="comment-submit" aria-label="Post comment">
            ↑
          </button>
        </div>
      </div>
      <p class="comment-popover-status" id="comment-status" aria-live="polite" hidden></p>
    </div>
  </div>
</div>

<script>
  import {
    getCommentTargetLabel,
    getElementLabel,
    getStableSelector,
    isSelectableElement,
  } from '../utils/element-selector';
  import { validateComment } from '../lib/comment-validation';

  const CATEGORIES = [
    { id: '', label: 'Category' },
    { id: 'accessibility', label: 'Accessibility' },
    { id: 'content', label: 'Content' },
    { id: 'visual-design', label: 'Visual design' },
    { id: 'bug', label: 'Bug' },
  ] as const;

  type CategoryId = (typeof CATEGORIES)[number]['id'];

  type SessionComment = {
    id: string;
    pageUrl: string;
    selector: string;
    elementLabel: string;
    elementDisplayName: string;
    category: CategoryId;
    comment: string;
    createdAt: string;
    savedToServer: boolean;
  };

  type GlobalComment = {
    id: string;
    pageUrl: string;
    selector: string;
    elementLabel: string;
    elementDisplayName: string;
    category: CategoryId;
    comment: string;
    createdAt: string;
    upvoteCount: number;
  };

  const STORAGE_KEY = 'portfolio-session-comments';
  const VISITOR_ID_KEY = 'portfolio-visitor-id';
  const UPVOTED_KEY = 'portfolio-upvoted-comments';
  const SINGLE_LINE_HEIGHT = 22;
  const POPOVER_WIDTH = 360;
  /** Set true to show Mine/All tabs and let visitors browse public comments. */
  const PUBLIC_COMMENTS_ENABLED = false;

  const configuredApi = import.meta.env.PUBLIC_COMMENT_API_URL ?? '';
  const siteBase = import.meta.env.BASE_URL;
  const apiRoot = configuredApi || siteBase;
  const commentsUrl = new URL('api/comments', window.location.origin + apiRoot).href;

  function commentItemUrl(id: string) {
    return new URL(`api/comments/${id}`, window.location.origin + apiRoot).href;
  }

  async function patchCommentOnServer(
    id: string,
    patch: { comment?: string; category?: CategoryId },
  ) {
    const response = await fetch(commentItemUrl(id), {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...patch, visitorId: getVisitorId() }),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(data.error || 'Could not update comment.');
    }
  }

  async function deleteCommentOnServer(id: string) {
    const response = await fetch(commentItemUrl(id), {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ visitorId: getVisitorId() }),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(data.error || 'Could not delete comment.');
    }
  }

  const modeToggleBtn = document.getElementById('comment-mode-toggle');
  const sidebar = document.getElementById('comment-sidebar');
  const sidebarList = document.getElementById('comment-sidebar-list');
  const highlightsRoot = document.getElementById('comment-highlights');
  const popover = document.getElementById('comment-popover');
  const chipsEl = document.getElementById('comment-target-chips');
  const categoriesEl = document.getElementById('comment-category-select') as HTMLSelectElement | null;
  const commentText = document.getElementById('comment-text') as HTMLTextAreaElement | null;
  const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('comment-status');
  const scopeMineBtn = document.getElementById('comment-scope-mine');
  const scopeAllBtn = document.getElementById('comment-scope-all');
  const scopeTabs = document.getElementById('comment-sidebar-tabs');
  const siteShell = document.getElementById('site-shell');
  const siteCanvas = document.getElementById('site-canvas');

  const SELECTOR_SEP = '\n';

  let mode: 'view' | 'comment' = 'view';
  let sidebarScope: 'mine' | 'all' = 'mine';
  let globalComments: GlobalComment[] = [];
  let globalLoading = false;
  let composing = false;
  let hoveredElement: HTMLElement | null = null;
  let selectedTargets: HTMLElement[] = [];
  let selectedCategory: CategoryId = '';
  let sessionComments: SessionComment[] = [];
  let activeCardId: string | null = null;
  let previewCardId: string | null = null;
  let editingCommentId: string | null = null;
  let editCommentErrorId: string | null = null;
  let editCommentErrorMessage = '';
  let pinnedTarget: HTMLElement | null = null;
  let sidebarInteracting = false;

  if (PUBLIC_COMMENTS_ENABLED) {
    scopeTabs?.removeAttribute('hidden');
  } else {
    scopeTabs?.setAttribute('hidden', '');
    sidebarScope = 'mine';
  }

  function getPageScrollY(): number {
    return siteCanvas?.scrollTop ?? window.scrollY;
  }

  function setSidebarInteracting(next: boolean) {
    sidebarInteracting = next;
    document.body.classList.toggle('comment-sidebar-interacting', next);
  }

  function canSelectOnCanvas(): boolean {
    return mode === 'comment' && !sidebarInteracting && !editingCommentId;
  }

  function splitSelectors(selector: string): string[] {
    return selector
      .split(SELECTOR_SEP)
      .map((part) => part.trim())
      .filter(Boolean);
  }

  function resolveTarget(selector: string): HTMLElement | null {
    const primary = splitSelectors(selector)[0];
    if (!primary) return null;
    const target = document.querySelector(primary);
    return target instanceof HTMLElement ? target : null;
  }

  function resolveTargets(selector: string): HTMLElement[] {
    const targets: HTMLElement[] = [];
    for (const part of splitSelectors(selector)) {
      const target = document.querySelector(part);
      if (target instanceof HTMLElement) targets.push(target);
    }
    return targets;
  }

  function getShortTag(element: HTMLElement): string {
    return element.tagName.toLowerCase();
  }

  function getSelectionMeta() {
    const selectors = selectedTargets.map((el) => getStableSelector(el));
    const tags = selectedTargets.map((el) => getShortTag(el));
    const labels = selectedTargets.map((el) => getElementLabel(el));
    const displayNames = selectedTargets.map((el) => getCommentTargetLabel(el));

    return {
      selector: selectors.join(SELECTOR_SEP),
      elementLabel: labels.join(' · '),
      elementDisplayName:
        tags.length <= 1
          ? displayNames[0] ?? tags[0] ?? ''
          : tags.map((tag) => `<${tag}>`).join(' · '),
    };
  }

  function categoryLabel(id: CategoryId): string {
    if (!id) return 'No category';
    return CATEGORIES.find((item) => item.id === id)?.label ?? 'No category';
  }

  function getVisitorId(): string {
    let id = localStorage.getItem(VISITOR_ID_KEY);
    if (!id) {
      id = crypto.randomUUID();
      localStorage.setItem(VISITOR_ID_KEY, id);
    }
    return id;
  }

  function getUpvotedIds(): Set<string> {
    try {
      const raw = localStorage.getItem(UPVOTED_KEY);
      return new Set(raw ? (JSON.parse(raw) as string[]) : []);
    } catch {
      return new Set();
    }
  }

  function markUpvoted(commentId: string) {
    const ids = getUpvotedIds();
    ids.add(commentId);
    localStorage.setItem(UPVOTED_KEY, JSON.stringify([...ids]));
  }

  function mapGlobalComment(raw: Record<string, unknown>): GlobalComment {
    return {
      id: String(raw.id),
      pageUrl: String(raw.pageUrl),
      selector: String(raw.selector),
      elementLabel: String(raw.elementLabel),
      elementDisplayName: String(raw.elementDisplayName ?? raw.elementLabel),
      category: (String(raw.category ?? '') || '') as CategoryId,
      comment: String(raw.comment),
      createdAt: String(raw.createdAt),
      upvoteCount: Number(raw.upvoteCount ?? 0),
    };
  }

  async function fetchGlobalComments() {
    if (globalLoading) return;
    globalLoading = true;

    const pageUrl = window.location.href.split('#')[0];
    const url = new URL(commentsUrl);
    url.searchParams.set('public', '1');
    url.searchParams.set('pageUrl', pageUrl);

    try {
      const response = await fetch(url.href);
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Could not load comments.');
      globalComments = Array.isArray(data.comments)
        ? data.comments.map((item: Record<string, unknown>) => mapGlobalComment(item))
        : [];
    } catch {
      globalComments = [];
    } finally {
      globalLoading = false;
      if (sidebarScope === 'all') renderSidebar();
    }
  }

  async function upvoteComment(commentId: string) {
    if (getUpvotedIds().has(commentId)) return;

    const upvoteUrl = new URL(`api/comments/${commentId}/upvote`, window.location.origin + apiRoot).href;

    try {
      const response = await fetch(upvoteUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ voterFingerprint: getVisitorId() }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error();

      markUpvoted(commentId);
      const entry = globalComments.find((item) => item.id === commentId);
      if (entry) entry.upvoteCount = Number(data.upvoteCount ?? entry.upvoteCount + 1);
      renderSidebar();
    } catch {
      /* ignore */
    }
  }

  function setSidebarScope(next: 'mine' | 'all') {
    if (!PUBLIC_COMMENTS_ENABLED && next === 'all') return;

    sidebarScope = next;
    scopeMineBtn?.classList.toggle('is-active', next === 'mine');
    scopeAllBtn?.classList.toggle('is-active', next === 'all');
    scopeMineBtn?.setAttribute('aria-selected', String(next === 'mine'));
    scopeAllBtn?.setAttribute('aria-selected', String(next === 'all'));

    if (next === 'all') {
      void fetchGlobalComments();
    } else {
      renderSidebar();
    }
  }

  function loadSessionComments(): SessionComment[] {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return [];

      const items = JSON.parse(raw) as SessionComment[];
      const saved = items.filter((item) => item.savedToServer === true);

      if (saved.length !== items.length) {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      }

      return saved;
    } catch {
      sessionStorage.removeItem(STORAGE_KEY);
      return [];
    }
  }

  function saveSessionComments() {
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(sessionComments));
  }

  function pageComments(): SessionComment[] {
    const pageUrl = window.location.href.split('#')[0];
    return sessionComments.filter((item) => item.pageUrl === pageUrl);
  }

  function setStatus(message: string, type = '') {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.className = `comment-popover-status${type ? ` ${type}` : ''}`;
    statusEl.hidden = !message;
    if (message && composing) {
      requestAnimationFrame(() => positionPopover());
    }
  }

  function getSidebarOffset(): number {
    if (mode !== 'comment' || !sidebar) return 0;
    const rect = sidebar.getBoundingClientRect();
    return rect.width > 0 && rect.left < window.innerWidth ? rect.width + 10 : 0;
  }

  function positionBox(element: HTMLElement, box: HTMLElement) {
    const rect = element.getBoundingClientRect();
    box.style.top = `${rect.top}px`;
    box.style.left = `${rect.left}px`;
    box.style.width = `${rect.width}px`;
    box.style.height = `${rect.height}px`;
  }

  function clearHighlightBoxes() {
    if (highlightsRoot) highlightsRoot.replaceChildren();
  }

  function ensureHighlightBoxes(count: number) {
    if (!highlightsRoot) return [];
    while (highlightsRoot.children.length < count) {
      const box = document.createElement('div');
      box.className = 'comment-mode-highlight';
      highlightsRoot.appendChild(box);
    }
    while (highlightsRoot.children.length > count) {
      highlightsRoot.lastElementChild?.remove();
    }
    return Array.from(highlightsRoot.children) as HTMLElement[];
  }

  function positionHighlight(
    element: HTMLElement,
    options: { pinned?: boolean; preview?: boolean } = {},
  ) {
    positionHighlights([element], options);
  }

  function positionHighlights(
    elements: HTMLElement[],
    options: { pinned?: boolean; preview?: boolean } = {},
  ) {
    const { pinned = false, preview = false } = options;
    const boxes = ensureHighlightBoxes(elements.length);
    boxes.forEach((box, index) => {
      const element = elements[index];
      if (!element) return;
      box.hidden = false;
      box.classList.toggle('is-pinned', pinned);
      box.classList.toggle('is-preview', preview && !pinned);
      positionBox(element, box);
    });
  }

  function hideHighlight() {
    clearHighlightBoxes();
    pinnedTarget = null;
  }

  function syncSelectionHighlights() {
    if (!composing || selectedTargets.length === 0) {
      if (!activeCardId && !previewCardId) hideHighlight();
      return;
    }
    positionHighlights(selectedTargets, { pinned: true });
  }

  function renderTargetChips() {
    if (!chipsEl) return;
    chipsEl.replaceChildren();

    selectedTargets.forEach((element, index) => {
      const tag = getShortTag(element);
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'comment-popover-chip';
      chip.title = getCommentTargetLabel(element);
      chip.setAttribute('aria-label', `Remove ${tag} from selection`);

      const label = document.createElement('span');
      label.className = 'comment-popover-chip-label';
      label.textContent = tag;

      const remove = document.createElement('span');
      remove.className = 'comment-popover-chip-remove';
      remove.setAttribute('aria-hidden', 'true');
      remove.innerHTML =
        '<svg viewBox="0 0 12 12" width="10" height="10" fill="none"><path d="M3 3l6 6M9 3 3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';

      chip.append(label, remove);
      chip.addEventListener('mousedown', (event) => event.preventDefault());
      chip.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        removeTargetAt(index);
      });
      chipsEl.appendChild(chip);
    });
  }

  function updatePinnedHighlight() {
    if (!activeCardId) return;
    const item = sessionComments.find((entry) => entry.id === activeCardId);
    if (!item) return;

    const targets = resolveTargets(item.selector);
    if (targets.length === 0) return;

    pinnedTarget = targets[0] ?? null;
    positionHighlights(targets, { pinned: true });
  }

  function previewCommentTarget(item: SessionComment) {
    if (activeCardId === item.id) return;

    const targets = resolveTargets(item.selector);
    if (targets.length === 0) return;

    previewCardId = item.id;
    positionHighlights(targets, { preview: true });
  }

  function clearPreviewHighlight() {
    previewCardId = null;
    if (activeCardId) {
      updatePinnedHighlight();
      return;
    }
    if (composing) {
      syncSelectionHighlights();
      return;
    }
    hideHighlight();
  }

  function pinCommentTarget(item: SessionComment) {
    const targets = resolveTargets(item.selector);
    const target = targets[0];
    if (!target) return;

    activeCardId = item.id;
    previewCardId = null;
    pinnedTarget = target;

    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    window.setTimeout(() => {
      positionHighlights(targets, { pinned: true });
    }, 300);
  }

  function positionPopover() {
    if (!popover || selectedTargets.length === 0) return;

    const anchor = selectedTargets[selectedTargets.length - 1] ?? selectedTargets[0];
    if (!anchor) return;

    const rect = anchor.getBoundingClientRect();
    const sidebarOffset = getSidebarOffset();
    const margin = 12;
    const gap = 10;
    const maxRight = window.innerWidth - sidebarOffset - margin;
    const popWidth = Math.min(POPOVER_WIDTH, maxRight - margin);
    const popHeight = popover.getBoundingClientRect().height || 160;

    let top = rect.bottom + gap;
    let left = rect.left;

    if (left + popWidth > maxRight) {
      left = maxRight - popWidth;
    }
    if (left < margin) left = margin;

    if (top + popHeight > window.innerHeight - margin) {
      top = rect.top - popHeight - gap;
    }
    if (top < margin) top = margin;

    popover.style.top = `${top}px`;
    popover.style.left = `${left}px`;
    popover.style.width = `${popWidth}px`;
    popover.hidden = false;
  }

  function resizeTextarea() {
    if (!commentText) return;
    commentText.style.height = 'auto';
    const scrollHeight = commentText.scrollHeight;
    const nextHeight = Math.min(Math.max(SINGLE_LINE_HEIGHT, scrollHeight), 120);

    commentText.style.height = `${nextHeight}px`;

    if (composing) positionPopover();
  }

  function clearSelection() {
    for (const element of selectedTargets) {
      element.classList.remove('comment-mode-selected');
    }
    selectedTargets = [];
  }

  function removeTargetAt(index: number) {
    const element = selectedTargets[index];
    if (!element) return;

    if (selectedTargets.length === 1) {
      closeComposer();
      return;
    }

    element.classList.remove('comment-mode-selected');
    selectedTargets = selectedTargets.filter((_, i) => i !== index);
    renderTargetChips();
    syncSelectionHighlights();
    positionPopover();
  }

  function addOrToggleTarget(element: HTMLElement, toggle: boolean) {
    const existingIndex = selectedTargets.indexOf(element);

    if (existingIndex >= 0) {
      if (toggle || selectedTargets.length > 1) {
        removeTargetAt(existingIndex);
      }
      return;
    }

    selectedTargets.push(element);
    element.classList.add('comment-mode-selected');
    renderTargetChips();
    syncSelectionHighlights();
    positionPopover();
  }

  function createCategorySelect(value: CategoryId, className: string): HTMLSelectElement {
    const select = document.createElement('select');
    select.className = className;

    for (const category of CATEGORIES) {
      const option = document.createElement('option');
      option.value = category.id;
      option.textContent = category.label;
      option.selected = category.id === value;
      select.appendChild(option);
    }

    select.addEventListener('mousedown', (event) => event.stopPropagation());
    select.addEventListener('click', (event) => event.stopPropagation());
    return select;
  }

  function syncCategorySelectWidth() {
    if (!categoriesEl) return;

    const label = categoriesEl.options[categoriesEl.selectedIndex]?.textContent ?? '';
    const probe = document.createElement('span');
    const styles = getComputedStyle(categoriesEl);

    probe.textContent = label;
    probe.style.cssText = [
      'position:absolute',
      'visibility:hidden',
      'white-space:nowrap',
      `font-family:${styles.fontFamily}`,
      `font-size:${styles.fontSize}`,
      `font-weight:${styles.fontWeight}`,
      `letter-spacing:${styles.letterSpacing}`,
    ].join(';');

    document.body.appendChild(probe);
    const textWidth = probe.getBoundingClientRect().width;
    probe.remove();

    // left pad 6 + text + gap 2 + chevron 12 + right pad 4
    categoriesEl.style.width = `${Math.ceil(textWidth + 24)}px`;
  }

  function initCategorySelect() {
    if (!categoriesEl || categoriesEl.options.length > 0) return;

    for (const category of CATEGORIES) {
      const option = document.createElement('option');
      option.value = category.id;
      option.textContent = category.label;
      categoriesEl.appendChild(option);
    }

    categoriesEl.addEventListener('change', () => {
      selectedCategory = categoriesEl.value as CategoryId;
      syncCategorySelectWidth();
    });

    syncCategorySelectWidth();
  }

  function resetCategorySelect() {
    if (!categoriesEl) return;
    categoriesEl.value = '';
    selectedCategory = '';
    syncCategorySelectWidth();
  }

  async function deleteComment(id: string) {
    const entry = sessionComments.find((item) => item.id === id);
    if (!entry) return;

    try {
      if (entry.savedToServer) {
        await deleteCommentOnServer(id);
      }

      sessionComments = sessionComments.filter((item) => item.id !== id);
      globalComments = globalComments.filter((item) => item.id !== id);
      saveSessionComments();

      if (activeCardId === id) {
        activeCardId = null;
        hideHighlight();
      }
      if (editingCommentId === id) {
        editingCommentId = null;
        setSidebarInteracting(false);
      }

      renderSidebar();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not delete comment.');
    }
  }

  async function updateCommentCategory(
    id: string,
    category: CategoryId,
    revertSelect?: HTMLSelectElement,
    previous?: CategoryId,
  ) {
    const entry = sessionComments.find((item) => item.id === id);
    if (!entry) return;

    try {
      await patchCommentOnServer(id, { category });
      entry.category = category;
      saveSessionComments();

      const global = globalComments.find((item) => item.id === id);
      if (global) global.category = category;
    } catch (error) {
      if (revertSelect && previous !== undefined) revertSelect.value = previous;
      window.alert(error instanceof Error ? error.message : 'Could not update category.');
    }
  }

  async function finishCommentTextEdit(id: string, value: string) {
    const entry = sessionComments.find((item) => item.id === id);
    if (!entry) return;

    const next = value.trim();
    if (!next) {
      cancelCommentTextEdit();
      return;
    }

    if (next === entry.comment) {
      editingCommentId = null;
      editCommentErrorId = null;
      editCommentErrorMessage = '';
      setSidebarInteracting(false);
      renderSidebar();
      return;
    }

    const validation = validateComment(next);
    if (!validation.ok) {
      editCommentErrorId = id;
      editCommentErrorMessage = validation.message;
      editingCommentId = id;
      setSidebarInteracting(true);
      renderSidebar();
      return;
    }

    try {
      await patchCommentOnServer(id, { comment: next });
      entry.comment = next;
      saveSessionComments();

      const global = globalComments.find((item) => item.id === id);
      if (global) global.comment = next;

      editingCommentId = null;
      editCommentErrorId = null;
      editCommentErrorMessage = '';
      setSidebarInteracting(false);
      renderSidebar();
    } catch (error) {
      editCommentErrorId = id;
      editCommentErrorMessage =
        error instanceof Error ? error.message : 'Could not update comment.';
      editingCommentId = id;
      setSidebarInteracting(true);
      renderSidebar();
    }
  }

  function cancelCommentTextEdit() {
    editingCommentId = null;
    editCommentErrorId = null;
    editCommentErrorMessage = '';
    setSidebarInteracting(false);
    renderSidebar();
  }

  function renderGlobalSidebar() {
    if (!sidebarList) return;

    sidebarList.innerHTML = '';

    if (globalLoading) {
      const loading = document.createElement('p');
      loading.className = 'comment-sidebar-empty';
      loading.textContent = 'Loading comments…';
      sidebarList.appendChild(loading);
      return;
    }

    if (globalComments.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'comment-sidebar-empty';
      empty.textContent = 'No comments on this page yet.';
      sidebarList.appendChild(empty);
      return;
    }

    const upvoted = getUpvotedIds();

    for (const item of globalComments) {
      const card = document.createElement('article');
      card.className = `comment-sidebar-card comment-sidebar-card--readonly${activeCardId === item.id ? ' is-active' : ''}`;
      card.dataset.commentId = item.id;

      const header = document.createElement('div');
      header.className = 'comment-sidebar-card-header';

      const category = document.createElement('span');
      category.className = 'comment-sidebar-card-category-label';
      category.textContent = categoryLabel(item.category);

      const upvoteBtn = document.createElement('button');
      upvoteBtn.type = 'button';
      upvoteBtn.className = 'comment-sidebar-card-upvote';
      upvoteBtn.disabled = upvoted.has(item.id);
      upvoteBtn.textContent = upvoted.has(item.id)
        ? `+1 · ${item.upvoteCount}`
        : `+1 · ${item.upvoteCount}`;
      upvoteBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        void upvoteComment(item.id);
      });

      header.append(category, upvoteBtn);
      card.appendChild(header);

      const title = document.createElement('p');
      title.className = 'comment-sidebar-card-title';
      title.textContent = item.elementDisplayName;
      title.addEventListener('click', (event) => {
        event.stopPropagation();
        pinGlobalTarget(item);
        renderSidebar();
      });
      card.appendChild(title);

      const body = document.createElement('p');
      body.className = 'comment-sidebar-card-body';
      body.textContent = item.comment;
      card.appendChild(body);

      card.addEventListener('mouseenter', () => previewGlobalTarget(item));
      card.addEventListener('mouseleave', () => {
        if (previewCardId === item.id) clearPreviewHighlight();
      });

      sidebarList.appendChild(card);
    }
  }

  function pinGlobalTarget(item: GlobalComment) {
    activeCardId = item.id;
    previewCardId = null;
    const target = resolveTarget(item.selector);
    if (target) {
      pinnedTarget = target;
      positionHighlight(target, { pinned: true });
    } else {
      pinnedTarget = null;
      hideHighlight();
    }
  }

  function previewGlobalTarget(item: GlobalComment) {
    previewCardId = item.id;
    const target = resolveTarget(item.selector);
    if (target) positionHighlight(target, { preview: true });
    else hideHighlight();
  }

  function renderSidebar() {
    if (sidebarScope === 'all') {
      renderGlobalSidebar();
      return;
    }

    if (!sidebarList) return;

    const items = pageComments();
    sidebarList.innerHTML = '';

    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'comment-sidebar-empty';
      empty.textContent = 'Click any section on the page to leave feedback.';
      sidebarList.appendChild(empty);
      return;
    }

    for (const item of [...items].reverse()) {
      const isEditingComment = editingCommentId === item.id;
      const card = document.createElement('article');
      card.className = `comment-sidebar-card${activeCardId === item.id ? ' is-active' : ''}${isEditingComment ? ' is-editing-comment' : ''}`;
      card.dataset.commentId = item.id;

      const header = document.createElement('div');
      header.className = 'comment-sidebar-card-header';

      const categorySelect = createCategorySelect(
        item.category,
        'comment-sidebar-card-category-select',
      );
      categorySelect.addEventListener('change', () => {
        const previous = item.category;
        void updateCommentCategory(
          item.id,
          categorySelect.value as CategoryId,
          categorySelect,
          previous,
        );
      });

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'comment-sidebar-card-delete';
      deleteBtn.setAttribute('aria-label', 'Delete comment');
      deleteBtn.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;
      deleteBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        void deleteComment(item.id);
      });

      header.append(categorySelect, deleteBtn);
      card.appendChild(header);

      const title = document.createElement('p');
      title.className = 'comment-sidebar-card-title';
      title.textContent = item.elementDisplayName;
      title.addEventListener('click', (event) => {
        event.stopPropagation();
        pinCommentTarget(item);
        renderSidebar();
      });
      card.appendChild(title);

      if (isEditingComment) {
        const textarea = document.createElement('textarea');
        textarea.className = 'comment-sidebar-card-body-input';
        textarea.value = item.comment;
        textarea.maxLength = 2000;
        textarea.rows = 3;
        textarea.addEventListener('click', (event) => event.stopPropagation());
        textarea.addEventListener('input', () => {
          if (editCommentErrorId === item.id) {
            editCommentErrorId = null;
            editCommentErrorMessage = '';
          }
        });
        textarea.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            cancelCommentTextEdit();
          }
          if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            void finishCommentTextEdit(item.id, textarea.value);
          }
        });
        textarea.addEventListener('blur', () => {
          void finishCommentTextEdit(item.id, textarea.value);
        });
        card.appendChild(textarea);
        if (editCommentErrorId === item.id && editCommentErrorMessage) {
          const error = document.createElement('p');
          error.className = 'comment-sidebar-card-error';
          error.textContent = editCommentErrorMessage;
          card.appendChild(error);
        }
        window.requestAnimationFrame(() => {
          textarea.focus();
          textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        });
      } else {
        const body = document.createElement('p');
        body.className = 'comment-sidebar-card-body';
        body.textContent = item.comment;
        body.title = 'Click to edit';
        body.addEventListener('click', (event) => {
          event.stopPropagation();
          editingCommentId = item.id;
          setSidebarInteracting(true);
          renderSidebar();
        });
        card.appendChild(body);
      }

      card.addEventListener('mouseenter', () => previewCommentTarget(item));
      card.addEventListener('mouseleave', () => {
        if (previewCardId === item.id) clearPreviewHighlight();
      });

      sidebarList.appendChild(card);
    }
  }

  function openComposer(element: HTMLElement) {
    if (!popover || !commentText) return;

    clearSelection();
    selectedTargets = [element];
    selectedCategory = '';
    element.classList.add('comment-mode-selected');

    composing = true;
    hoveredElement = null;

    renderTargetChips();
    positionHighlights(selectedTargets, { pinned: true });
    commentText.value = '';
    resizeTextarea();
    resetCategorySelect();
    setStatus('');
    positionPopover();
    commentText.focus();
  }

  function closeComposer() {
    if (!popover) return;
    composing = false;
    popover.hidden = true;
    hideHighlight();
    clearSelection();
    if (chipsEl) chipsEl.replaceChildren();
    setStatus('');
  }

  const CLOSE_ICON = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;

  function updateModeToggle(next: 'view' | 'comment') {
    if (!modeToggleBtn) return;

    const isComment = next === 'comment';
    modeToggleBtn.setAttribute('aria-pressed', String(isComment));
    modeToggleBtn.classList.toggle('is-icon', isComment);

    if (isComment) {
      modeToggleBtn.setAttribute('aria-label', 'Exit feedback');
      modeToggleBtn.title = 'Exit feedback';
      modeToggleBtn.innerHTML = CLOSE_ICON;
    } else {
      modeToggleBtn.removeAttribute('aria-label');
      modeToggleBtn.removeAttribute('title');
      modeToggleBtn.textContent = 'Leave feedback';
    }
  }

  function setMode(next: 'view' | 'comment', options: { animate?: boolean } = {}) {
    const { animate = true } = options;
    const toggle = modeToggleBtn;
    const fromRect =
      animate && toggle && toggle.isConnected ? toggle.getBoundingClientRect() : undefined;
    const preservedScroll = getPageScrollY();

    mode = next;
    document.body.classList.toggle('comment-view-only', next === 'view');
    document.body.classList.toggle('comment-view-comment', next === 'comment');
    document.body.classList.toggle('comment-mode-active', next === 'comment');
    updateModeToggle(next);

    if (next === 'view') {
      hoveredElement = null;
      activeCardId = null;
      previewCardId = null;
      editingCommentId = null;
      setSidebarInteracting(false);
      closeComposer();
      hideHighlight();
    } else {
      renderSidebar();
    }

    window.requestAnimationFrame(() => {
      if (siteCanvas) siteCanvas.scrollTop = preservedScroll;
      placeToggle(next === 'view' ? 'header' : 'sidebar', fromRect);
    });
  }

  function elementUnderPointer(event: MouseEvent): HTMLElement | null {
    if (highlightsRoot) highlightsRoot.style.pointerEvents = 'none';
    popover?.style.setProperty('pointer-events', 'none');
    const raw = document.elementFromPoint(event.clientX, event.clientY);
    if (highlightsRoot) highlightsRoot.style.pointerEvents = '';
    popover?.style.removeProperty('pointer-events');

    if (!(raw instanceof Element)) return null;
    if (raw.closest('[data-comment-ui]')) return null;
    if (sidebar?.contains(raw)) return null;
    if (siteCanvas && (raw === siteCanvas || !siteCanvas.contains(raw))) return null;

    let current: Element | null = raw;
    while (current) {
      if (current === siteCanvas) break;
      if (isSelectableElement(current)) return current;
      current = current.parentElement;
    }
    return null;
  }

  function clearHoverHighlight() {
    hoveredElement = null;
    if (!activeCardId && !composing && !previewCardId) hideHighlight();
  }

  function isCommentUiTarget(target: EventTarget | null): boolean {
    return target instanceof Element && Boolean(
      target.closest('[data-comment-ui]') || (sidebar && sidebar.contains(target)),
    );
  }

  function addSessionComment(serverId: string, comment: string) {
    const meta = getSelectionMeta();
    const entry: SessionComment = {
      id: serverId,
      pageUrl: window.location.href.split('#')[0],
      selector: meta.selector,
      elementLabel: meta.elementLabel,
      elementDisplayName: meta.elementDisplayName,
      category: selectedCategory,
      comment,
      createdAt: new Date().toISOString(),
      savedToServer: true,
    };

    sessionComments.push(entry);
    saveSessionComments();
    activeCardId = entry.id;
    renderSidebar();
  }

  function placeToggle(location: 'header' | 'sidebar', fromRect?: DOMRect) {
    const toggle = modeToggleBtn;
    const anchor =
      location === 'sidebar'
        ? document.getElementById('comment-sidebar-toggle-anchor')
        : document.getElementById('comment-toggle-anchor');

    if (!toggle || !anchor) return;

    const shouldAnimate = Boolean(fromRect);

    if (toggle.parentElement !== anchor) {
      anchor.appendChild(toggle);
    }

    if (!shouldAnimate || !fromRect) return;

    const last = toggle.getBoundingClientRect();
    const dx = fromRect.left - last.left;
    const dy = fromRect.top - last.top;

    if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;

    toggle.classList.add('is-animating');
    toggle.style.transition = 'none';
    toggle.style.transform = `translate(${dx}px, ${dy}px)`;

    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        toggle.style.transition = 'transform 0.32s cubic-bezier(0.4, 0, 0.2, 1)';
        toggle.style.transform = '';
      });
    });

    const cleanup = () => {
      toggle.classList.remove('is-animating');
      toggle.style.transition = '';
      toggle.style.transform = '';
    };

    toggle.addEventListener('transitionend', cleanup, { once: true });
    window.setTimeout(cleanup, 400);
  }

  modeToggleBtn?.addEventListener('click', () => {
    setMode(mode === 'comment' ? 'view' : 'comment');
  });
  if (PUBLIC_COMMENTS_ENABLED) {
    scopeMineBtn?.addEventListener('click', () => setSidebarScope('mine'));
    scopeAllBtn?.addEventListener('click', () => setSidebarScope('all'));
  }

  sidebar?.addEventListener('mouseenter', () => {
    setSidebarInteracting(true);
    clearHoverHighlight();
  });
  sidebar?.addEventListener('mouseleave', () => {
    if (!editingCommentId) setSidebarInteracting(false);
  });
  sidebar?.addEventListener('focusin', () => setSidebarInteracting(true));
  sidebar?.addEventListener('focusout', (event) => {
    if (editingCommentId) return;
    const related = event.relatedTarget;
    if (related instanceof Node && sidebar?.contains(related)) return;
    setSidebarInteracting(false);
  });

  document.addEventListener(
    'mousemove',
    (event) => {
      if (mode !== 'comment' || composing || editingCommentId) return;
      if (isCommentUiTarget(event.target) || sidebarInteracting) {
        clearHoverHighlight();
        return;
      }
      if (!canSelectOnCanvas()) return;

      const element = elementUnderPointer(event);
      if (element === hoveredElement) return;
      hoveredElement = element;
      if (element) positionHighlight(element, { preview: true });
      else if (!activeCardId) hideHighlight();
    },
    true,
  );

  document.addEventListener(
    'click',
    (event) => {
      if (mode !== 'comment' || sidebarInteracting || editingCommentId) return;
      if (isCommentUiTarget(event.target)) return;

      const element = elementUnderPointer(event);
      const multi = event.metaKey || event.ctrlKey;

      if (composing) {
        if (!element) return;
        event.preventDefault();
        event.stopPropagation();
        addOrToggleTarget(element, multi || selectedTargets.includes(element));
        commentText?.focus();
        return;
      }

      if (!element) return;
      event.preventDefault();
      event.stopPropagation();
      activeCardId = null;
      openComposer(element);
    },
    true,
  );

  document.addEventListener(
    'mousedown',
    (event) => {
      if (!composing) return;
      if (isCommentUiTarget(event.target)) return;

      const element = elementUnderPointer(event);
      if (element) return;
      if (selectedTargets.some((target) => target.contains(event.target as Node))) return;
      closeComposer();
    },
    true,
  );

  commentText?.addEventListener('input', () => {
    resizeTextarea();
    if (statusEl?.classList.contains('error')) setStatus('');
  });

  commentText?.addEventListener('blur', (event) => {
    if (!composing) return;
    const related = event.relatedTarget;
    if (related instanceof Node && popover?.contains(related)) return;
    // Keep composer open on blur so multi-select clicks can add targets.
    // Dismissal is handled by mousedown outside selectable content.
  });

  commentText?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      submitBtn?.click();
    }
  });

  window.addEventListener(
    'scroll',
    () => {
      if (composing && selectedTargets.length > 0) {
        syncSelectionHighlights();
        positionPopover();
      } else if (activeCardId) {
        updatePinnedHighlight();
      } else if (previewCardId) {
        const item = sessionComments.find((entry) => entry.id === previewCardId);
        if (item) previewCommentTarget(item);
      }
    },
    true,
  );

  siteCanvas?.addEventListener('scroll', () => {
    if (composing && selectedTargets.length > 0) {
      syncSelectionHighlights();
      positionPopover();
    } else if (activeCardId) {
      updatePinnedHighlight();
    } else if (previewCardId) {
      const item = sessionComments.find((entry) => entry.id === previewCardId);
      if (item) previewCommentTarget(item);
    }
  });

  window.addEventListener('resize', () => {
    if (composing && selectedTargets.length > 0) {
      syncSelectionHighlights();
      positionPopover();
    } else if (activeCardId) {
      updatePinnedHighlight();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (composing) closeComposer();
      else if (mode === 'comment') setMode('view');
    }
  });

  submitBtn?.addEventListener('click', async () => {
    if (!commentText || selectedTargets.length === 0) return;
    const comment = commentText.value.trim();
    if (!comment) {
      setStatus('Write a comment first', 'error');
      return;
    }

    const validation = validateComment(comment);
    if (!validation.ok) {
      setStatus(validation.message, 'error');
      return;
    }

    const meta = getSelectionMeta();
    submitBtn.disabled = true;
    setStatus('');

    try {
      const response = await fetch(commentsUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          comment,
          selector: meta.selector,
          elementLabel: meta.elementLabel,
          elementDisplayName: meta.elementDisplayName,
          category: selectedCategory,
          pageUrl: window.location.href.split('#')[0],
          viewportWidth: window.innerWidth,
          scrollY: getPageScrollY(),
          visitorId: getVisitorId(),
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || 'Could not save comment.');
      }

      addSessionComment(data.id, comment);
      closeComposer();
      const savedTargets = resolveTargets(meta.selector);
      if (savedTargets.length > 0) {
        positionHighlights(savedTargets, { pinned: true });
      }
    } catch (error) {
      setStatus(
        error instanceof Error
          ? error.message
          : 'Could not save comment. Please try again.',
        'error',
      );
    } finally {
      submitBtn.disabled = false;
    }
  });

  if (siteShell && sidebar && sidebar.parentElement !== siteShell) {
    siteShell.appendChild(sidebar);
  }

  placeToggle('header');
  sessionComments = loadSessionComments();
  initCategorySelect();
  setMode('view', { animate: false });
</script>
