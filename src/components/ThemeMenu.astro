---
import { Icon } from 'astro-icon/components';

const options = [
  { id: 'dark', label: 'Dark', icon: 'lucide:moon' },
  { id: 'light', label: 'Light', icon: 'lucide:sun' },
  { id: 'system', label: 'System', icon: 'lucide:monitor' },
] as const;
---

<div class="theme-menu" data-theme-menu data-theme="system">
  <button
    type="button"
    class="theme-menu-button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu-list"
  >
    <span class="theme-menu-icons" aria-hidden="true">
      {
        options.map((option) => (
          <span class="theme-menu-glyph" data-theme-glyph={option.id}>
            <Icon name={option.icon} />
          </span>
        ))
      }
    </span>
    <span data-theme-label>System</span>
  </button>
  <div class="dropdown-menu theme-menu-popover" id="theme-menu-list" role="menu" hidden>
    {
      options.map((option) => (
        <button
          type="button"
          class="dropdown-option"
          role="menuitemradio"
          data-theme-choice={option.id}
          aria-checked="false"
        >
          <span class="dropdown-check" aria-hidden="true">
            <Icon name="lucide:check" />
          </span>
          <Icon name={option.icon} class="theme-menu-option-icon" aria-hidden="true" />
          {option.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .theme-menu {
    position: relative;
  }

  .theme-menu-button,
  .theme-menu-option {
    font: inherit;
    color: var(--color-ink);
    cursor: pointer;
  }

  .theme-menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: none;
    border-radius: var(--radius-card);
    background: var(--color-surface-strong);
    padding: 0.45rem 0.9rem 0.45rem 0.75rem;
  }

  .theme-menu-button:hover,
  .theme-menu-button[aria-expanded='true'] {
    background: var(--color-border-strong);
  }

  .theme-menu-button:focus-visible,
  .theme-menu-option:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-menu-icons :global(svg),
  .theme-menu-option :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .theme-menu-glyph {
    display: none;
  }

  .theme-menu[data-theme='dark'] [data-theme-glyph='dark'],
  .theme-menu[data-theme='light'] [data-theme-glyph='light'],
  .theme-menu[data-theme='system'] [data-theme-glyph='system'] {
    display: block;
  }

  .theme-menu-popover {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.55rem);
    z-index: 30;
    min-width: 11.5rem;
  }

  .theme-menu-popover[hidden] {
    display: none;
  }
</style>

<script>
  import { attachDropdownHighlight } from '../lib/dropdown';

  const labels: Record<string, string> = {
    dark: 'Dark',
    light: 'Light',
    system: 'System',
  };

  function currentTheme() {
    const theme = document.documentElement.dataset.theme;
    return theme === 'light' || theme === 'dark' || theme === 'system' ? theme : 'system';
  }

  document.querySelectorAll<HTMLElement>('[data-theme-menu]').forEach((menu) => {
    const button = menu.querySelector<HTMLButtonElement>('.theme-menu-button');
    const popover = menu.querySelector<HTMLElement>('.theme-menu-popover');
    const label = menu.querySelector<HTMLElement>('[data-theme-label]');
    const options = menu.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
    if (!button || !popover || !label) return;
    attachDropdownHighlight(popover);

    function paint() {
      const theme = currentTheme();
      menu.dataset.theme = theme;
      label.textContent = labels[theme];
      button.setAttribute('aria-label', `Color mode, ${labels[theme]}`);
      options.forEach((option) => {
        option.setAttribute('aria-checked', String(option.dataset.themeChoice === theme));
      });
    }

    function setOpen(open: boolean) {
      button.setAttribute('aria-expanded', String(open));
      popover.hidden = !open;
    }

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const choice = option.dataset.themeChoice;
        const setTheme = (window as Window & { __setTheme?: (theme: string) => void }).__setTheme;
        if (choice && setTheme) setTheme(choice);
        paint();
        setOpen(false);
        button.focus();
      });
    });

    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    const media = window.matchMedia('(prefers-color-scheme: dark)');
    media.addEventListener('change', paint);
    paint();
  });
</script>
