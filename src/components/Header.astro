---
import { site } from '../data/site';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import IconControl from './IconControl.astro';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base.slice(0, -1) : base;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function resolveHref(href: string) {
  if (href.startsWith('/#')) return `${root}${href}`;
  if (href.startsWith('/')) return `${root}${href}`;
  return href;
}

function isActive(href: string) {
  if (href === '/about') return pathname.endsWith('/about');
  if (href === '/play') return pathname.endsWith('/play');
  if (href === '/history') return pathname.endsWith('/history');
  return false;
}

const linkClass = (href: string) =>
  ['text-link text-body text-ink', isActive(href) && 'is-active'].filter(Boolean).join(' ');
---

<header class="site-header sticky top-0 z-50 bg-canvas/85 backdrop-blur-sm" data-comment-ui>
  <div
    class="relative mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-6 py-6 md:px-10 md:py-8"
  >
    <a
      href={base}
      class="nav-logo inline-flex shrink-0 items-center transition hover:opacity-70"
      aria-label={`${site.name} home`}
    >
      <span
        class="nav-logo-mark block h-6 w-6 shrink-0 bg-ink"
        data-logo-target
        style={`mask: url('${base}${site.logo}') center / contain no-repeat; -webkit-mask: url('${base}${site.logo}') center / contain no-repeat;`}
      ></span>
    </a>

    <div class="header-actions flex shrink-0 items-center gap-5 md:gap-8">
      <nav
        class="main-nav hidden items-center gap-5 md:flex md:gap-7"
        aria-label="Main"
        data-comment-id="main-nav"
      >
        {
          site.nav.map((item) => (
            <a
              href={resolveHref(item.href)}
              class={linkClass(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {item.external && <ExternalLinkIcon />}
            </a>
          ))
        }
      </nav>
      <div id="comment-toggle-anchor" class="comment-toggle-anchor" data-comment-ui></div>
      <IconControl
        id="mobile-nav-toggle"
        class="mobile-nav-toggle md:hidden"
        label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        data-comment-ui
      >
        <Icon name="lucide:menu" class="mobile-nav-icon-open" aria-hidden="true" />
        <Icon name="lucide:x" class="mobile-nav-icon-close hidden" aria-hidden="true" />
      </IconControl>
    </div>
  </div>

  <nav
    id="mobile-nav-panel"
    class="mobile-nav-panel bg-canvas/95 px-6 backdrop-blur-sm"
    aria-label="Main"
    aria-hidden="true"
    data-comment-ui
  >
    <ul class="mobile-nav-panel-inner flex flex-col gap-1 py-4">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={resolveHref(item.href)}
              class:list={[
                'mobile-nav-link text-link block px-0 py-3 text-body text-ink',
                isActive(item.href) && 'is-active',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              tabindex="-1"
            >
              {item.label}
              {item.external && <ExternalLinkIcon />}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  @media (max-width: 767px) {
    .mobile-nav-panel {
      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;
      transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mobile-nav-panel.is-open {
      grid-template-rows: 1fr;
    }

    .mobile-nav-panel-inner {
      min-height: 0;
      overflow: hidden;
      opacity: 0;
      transform: translateY(-0.75rem);
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mobile-nav-panel.is-open .mobile-nav-panel-inner {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .mobile-nav-panel {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-panel,
    .mobile-nav-panel-inner {
      transition: none;
    }

    .mobile-nav-panel-inner {
      transform: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const openIcon = toggle?.querySelector('.mobile-nav-icon-open');
  const closeIcon = toggle?.querySelector('.mobile-nav-icon-close');

  function setLinksTabbable(open: boolean) {
    panel?.querySelectorAll('a').forEach((link) => {
      if (open) link.removeAttribute('tabindex');
      else link.setAttribute('tabindex', '-1');
    });
  }

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', String(!open));
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.classList.toggle('mobile-nav-open', open);
    setLinksTabbable(open);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
