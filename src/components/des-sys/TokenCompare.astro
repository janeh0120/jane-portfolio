---
// Case study illustration (/des-sys-audit): the documentation opportunity. The checkbox label used
// text-secondary in both design and code, so they matched, but the design system docs call for
// text-primary, so both changed. A Before/After toggle shows the fix; Inspect mode's callouts
// (src/styles/inspect.css) name each side's token.
//
// Without JavaScript the toggle stays hidden and the "before" state shows; the caption states the fix.
import '../../styles/inspect.css';

const texture = `${import.meta.env.BASE_URL}images/case-studies/des-sys/pink-texture.webp`;

const before = '--color-text-secondary';
const after = '--color-text-primary';

const sides = ['Design', 'Code'];
---

<figure class="token-compare" data-state="before" data-token-compare>
  <div class="token-compare-head">
    <p class="token-compare-title">Checkbox label</p>
    <div class="segmented" role="group" aria-label="Show the checkbox label before or after the fix" hidden>
      <span class="segmented-thumb" aria-hidden="true"></span>
      <button type="button" class="segmented-option" data-state-choice="before" aria-pressed="true">Before</button>
      <button type="button" class="segmented-option" data-state-choice="after" aria-pressed="false">After</button>
    </div>
  </div>

  <div class="token-compare-doc">
    <span class="token-compare-doc-source">Documentation · Intuit Design System MCP</span>
    <span class="token-compare-doc-rule">Checkbox label text should use text-primary.</span>
  </div>

  <div class="token-compare-cols">
    {
      sides.map((side) => (
        <div class="token-compare-col">
          <div class="token-compare-col-head">
            <p class="token-compare-side">{side}</p>
            <span class="tag" data-when="before">Wrong token</span>
            <span class="tag" data-when="after">Matches docs</span>
          </div>

          <div class="token-compare-stage" aria-hidden="true">
            <img src={texture} alt="" loading="lazy" decoding="async" />
            <div class="token-compare-component">
              <span class="token-compare-checkbox">
                <span class="token-compare-box" />
                <span class="token-compare-label">
                  Mango
                  <span class="token-compare-leader" />
                </span>
              </span>
              <div class="inspect-panel">
                <span class="inspect-panel-title">Checkbox label</span>
                <dl>
                  <dt>Text</dt>
                  <dd>
                    <span class="inspect-swatch" />
                    <span class="is-flagged" data-when="before">{before}</span>
                    <span data-when="after">{after}</span>
                  </dd>
                </dl>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <figcaption>
    Before, the text used text-secondary in both design and code. According to the design system docs
    it should use text-primary, so I changed both design and code.
  </figcaption>
</figure>

<script>
  // Turn on each figure's Before/After toggle. Without this, the figure shows "before".
  document.querySelectorAll<HTMLElement>('[data-token-compare]').forEach((figure) => {
    const toggle = figure.querySelector<HTMLElement>('.segmented');
    if (!toggle) return;
    const options = toggle.querySelectorAll<HTMLButtonElement>('[data-state-choice]');
    options.forEach((option) => {
      option.addEventListener('click', () => {
        figure.dataset.state = option.dataset.stateChoice;
        options.forEach((o) => o.setAttribute('aria-pressed', String(o === option)));
      });
    });
    toggle.hidden = false;
  });
</script>

<style>
  .token-compare {
    margin: var(--space-8) 0 0;
  }

  .token-compare-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .token-compare p.token-compare-title {
    margin: 0;
    font: var(--type-label);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink);
  }

  /* The guidance both sides are checked against: dashed, as reference material */
  .token-compare-doc {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-base);
    font: var(--type-compact);
    letter-spacing: var(--tracking-body);
  }

  .token-compare-doc-source {
    color: var(--color-subtle);
  }

  .token-compare-doc-rule {
    color: var(--color-ink);
  }

  /* Design and code side by side, the comparison is the point; stacked on phones */
  .token-compare-cols {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .token-compare-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .token-compare-col {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
  }

  .token-compare-col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .token-compare p.token-compare-side {
    margin: 0;
    font: var(--type-label);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink);
  }

  .token-compare-stage {
    container-type: inline-size;
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(var(--space-24) * 3);
    overflow: hidden;
    border-radius: var(--radius-base);
  }

  .token-compare-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .token-compare-component {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-8);
    max-width: 90cqw;
  }

  .token-compare-checkbox {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: var(--space-2);
  }

  .token-compare-box {
    flex: none;
    width: var(--space-5);
    height: var(--space-5);
    background: var(--color-white);
    border: calc(var(--border-width) * 3) solid var(--color-neutral-500);
    /* Half the base radius, so a small box reads as a rounded square, not a circle */
    border-radius: calc(var(--radius-base) / 2);
  }

  /* The label's colour is the one thing that changes. Palette neutrals, since the checkbox depicts
     fixed UI on the textured background */
  .token-compare-label {
    position: relative;
    font: var(--type-subheading);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-body);
    color: var(--color-neutral-900);
    /* The label being compared, selected as in Inspect mode */
    outline: 1px solid var(--color-accent);
    outline-offset: var(--space-1);
  }

  .token-compare[data-state='before'] .token-compare-label {
    color: var(--color-neutral-500);
  }

  .token-compare-leader {
    position: absolute;
    left: 50%;
    top: calc(100% + var(--space-1));
    height: calc(var(--space-8) - var(--space-1));
    border-left: 1px dashed var(--color-pin);
  }

  .token-compare .inspect-panel {
    position: relative;
    z-index: auto;
    width: max-content;
    min-width: 0;
    max-width: 100%;
  }

  .token-compare .inspect-panel-title {
    display: block;
  }

  .token-compare .inspect-panel dl {
    gap: var(--space-1) var(--space-3);
  }

  /* The ink swatch sits on a dark callout in dark mode, so it needs a visible edge */
  .token-compare .inspect-swatch {
    background: var(--color-neutral-900);
    border-color: var(--color-border-strong);
  }

  .token-compare[data-state='before'] .inspect-swatch {
    background: var(--color-neutral-500);
  }

  .token-compare .is-flagged {
    color: var(--color-danger);
  }

  .token-compare[data-state='before'] [data-when='after'],
  .token-compare[data-state='after'] [data-when='before'] {
    display: none;
  }

  .token-compare figcaption {
    margin-top: var(--space-2);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-muted);
  }
</style>
