---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

interface Props {
  showSocials?: boolean;
}

const { showSocials = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base.slice(0, -1) : base;

function resolveHref(href: string) {
  if (href.startsWith('http://') || href.startsWith('https://')) return href;
  if (href.startsWith('/')) return `${root}${href}`;
  return href;
}

const caseStudyLinks = site.projects
  .filter((project) => !project.comingSoon)
  .map((project) => ({
    label: project.name,
    href: `/${project.slug}`,
    external: false,
  }));

const otherLinks = site.nav
  .filter((item) => item.label !== 'Projects')
  .map((item) => ({
    label: item.label,
    href: item.href,
    external: Boolean(item.external) || item.href.startsWith('http'),
  }));

const pageLinks = [...caseStudyLinks, ...otherLinks];
---

<footer data-comment-id="site-footer">
  <div class="mx-auto flex max-w-[1400px] flex-col gap-8 px-6 py-10 md:px-10 md:py-12">
    <nav
      class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium"
      aria-label="Footer"
      data-comment-id="footer-nav"
    >
      {
        pageLinks.map((item) => (
          <a
            href={resolveHref(item.href)}
            class="text-ink underline decoration-ink/40 underline-offset-[3px] transition hover:decoration-ink"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {item.external && <span aria-hidden="true"> ↗</span>}
          </a>
        ))
      }
    </nav>

    {showSocials && <SocialLinks />}

    <p class="text-sm text-muted">{site.year} ® {site.name}</p>
  </div>
</footer>
