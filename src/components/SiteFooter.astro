---
import { site } from '../data/site';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import ThemeMenu from './ThemeMenu.astro';
import LeaveFeedbackButton from './react/LeaveFeedbackButton';

interface Props {
  showSocials?: boolean;
}

const { showSocials = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base.slice(0, -1) : base;

function resolveHref(href: string) {
  if (href.startsWith('http://') || href.startsWith('https://')) return href;
  if (href.startsWith('/')) return `${root}${href}`;
  return href;
}

const pages = [
  { label: 'About', href: '/about', external: false },
  { label: 'Work', href: '/#projects', external: false },
  { label: 'Play', href: '/play', external: false },
  { label: 'Resume', href: site.links.resume, external: true },
  { label: 'Design system', href: '/design-system', external: false },
];

const contact = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'X', href: site.links.x },
  { label: 'Instagram', href: site.links.instagram },
];
---

<footer data-comment-id="site-footer">
  <div class="page-frame footer">
    <div class="footer-card">
      <div class="footer-top">
        <div class="footer-cta" data-comment-id="footer-feedback">
          <p class="subheading text-ink">
            Thanks for stopping by. Would love your feedback on my portfolio!
          </p>
          <LeaveFeedbackButton client:load />
        </div>
        <div class="footer-columns">
          <nav class="footer-column" aria-label="Pages" data-comment-id="footer-nav">
            {
              pages.map((item) => (
                <a
                  href={resolveHref(item.href)}
                  class="text-link text-body text-muted"
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                  {item.external && <ExternalLinkIcon />}
                </a>
              ))
            }
          </nav>
          {
            showSocials && (
              <nav class="footer-column" aria-label="Contact" data-comment-id="footer-socials">
                {site.email && (
                  <button
                    type="button"
                    class="copy-email text-link text-body text-muted"
                    data-email={site.email}
                    data-default-label="Email"
                    aria-label="Copy email"
                  >
                    <span data-email-label>Email</span>
                  </button>
                )}
                {contact.map((item) => (
                  <a
                    href={item.href}
                    class="text-link text-body text-muted"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.label}
                    <ExternalLinkIcon />
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </div>

    <div class="footer-meta">
      <p>© {site.year} {site.name}</p>
      <ThemeMenu />
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 1.5rem;
    padding-bottom: 1.25rem;
  }

  .footer-card {
    padding: 1.5rem 1.35rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-canvas);
  }

  @media (min-width: 768px) {
    .footer-card {
      padding: 1.75rem;
    }
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .footer-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 22rem;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: end;
    gap: 1.5rem 3.5rem;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-columns {
      justify-content: start;
    }
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .footer-column a,
  .footer-column button {
    text-align: left;
  }

  .footer-column button {
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .footer-column a:hover,
  .footer-column button:hover,
  .footer-column button.is-copied {
    color: var(--color-ink);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.15rem 0.35rem 0.35rem;
    color: var(--color-muted);
  }

  .footer-meta p {
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.footer .copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      const defaultLabel = btn.getAttribute('data-default-label') ?? 'Email';
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const label = btn.querySelector('[data-email-label]');
        btn.setAttribute('aria-label', 'Email copied');
        btn.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.setAttribute('aria-label', `Copy ${defaultLabel.toLowerCase()}`);
          btn.classList.remove('is-copied');
          if (label) label.textContent = defaultLabel;
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
