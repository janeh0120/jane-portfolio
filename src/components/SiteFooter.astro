---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';

interface Props {
  showSocials?: boolean;
}

const { showSocials = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base.slice(0, -1) : base;

function resolveHref(href: string) {
  if (href.startsWith('http://') || href.startsWith('https://')) return href;
  if (href.startsWith('/')) return `${root}${href}`;
  return href;
}

const pageLinks = [
  { label: 'Projects', href: '/#projects', external: false },
  ...site.nav
    .filter((item) => item.label !== 'Projects')
    .map((item) => ({
      label: item.label,
      href: item.href,
      external: Boolean(item.external) || item.href.startsWith('http'),
    })),
];
---

<footer data-comment-id="site-footer">
  <div class="mx-auto flex max-w-[1400px] flex-col gap-16 px-6 py-10 md:gap-20 md:px-10 md:py-12">
    <div
      class:list={[
        'grid gap-10',
        showSocials ? 'sm:grid-cols-2 sm:gap-16' : '',
      ]}
    >
      <nav class="flex flex-col gap-3 text-body" aria-label="Footer" data-comment-id="footer-nav">
        {
          pageLinks.map((item) => (
            <a
              href={resolveHref(item.href)}
              class="text-link text-ink"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {item.external && <ExternalLinkIcon />}
            </a>
          ))
        }
      </nav>

      {
        showSocials && (
          <div class="footer-socials flex flex-col" data-comment-id="footer-socials">
            <SocialLinks />
          </div>
        )
      }
    </div>

    <p class="text-body text-muted">
      Built with Astro, React, TypeScript, Supabase, and Vercel using Cursor.
      {' '}
      <a href={resolveHref('/design-system')} class="text-link text-ink">Design system</a>
      {' '}
      built with Tailwind.
    </p>
  </div>
</footer>
