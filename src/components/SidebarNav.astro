---
import ArrowIcon from './ArrowIcon.astro';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav?: NavItem[];
  ariaLabel?: string;
  showBack?: boolean;
  backHref?: string;
  backLabel?: string;
}

const {
  nav = [],
  ariaLabel = 'Page sections',
  showBack = true,
  backHref,
  backLabel = 'Back to Home',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = backHref ?? base;
const hasNav = nav.length > 0;
---

<aside class="case-study-aside lg:sticky lg:top-24 lg:self-start">
  {
    showBack && (
      <a href={home} class="button is-tertiary case-study-back">
        <ArrowIcon direction="left" size="0.9em" class="case-study-back-icon" />
        {backLabel}
      </a>
    )
  }
  {
    hasNav && (
      <nav
        class="case-study-nav mt-6 hidden flex-col gap-3 lg:flex"
        aria-label={ariaLabel}
      >
        {nav.map((item) => (
          <a href={item.href} class="text-body text-muted transition hover:text-ink">
            {item.label}
          </a>
        ))}
      </nav>
    )
  }
</aside>

<script>
  const aside = document.querySelector<HTMLElement>('.case-study-aside');
  const back = aside?.querySelector<HTMLElement>('.case-study-back');
  if (aside && back) {
    const compact = window.matchMedia('(max-width: 1023px)');
    const canvas = document.getElementById('site-canvas');
    const updateBack = () => {
      const scrolled = (canvas?.scrollTop ?? 0) > 0 || window.scrollY > 0;
      const stuckTop = parseFloat(getComputedStyle(aside).top) || 0;
      const stuck = compact.matches && scrolled && aside.getBoundingClientRect().top <= stuckTop + 6;
      back.classList.toggle('is-secondary', stuck);
      back.classList.toggle('is-tertiary', !stuck);
    };
    document.addEventListener('scroll', updateBack, { capture: true, passive: true });
    compact.addEventListener('change', updateBack);
    updateBack();
  }

  const nav = document.querySelector('.case-study-nav');
  if (nav) {
    nav.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;

        const target = document.getElementById(href.slice(1));
        if (!target) return;

        event.preventDefault();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', href);
      });
    });
  }
</script>

<style>
  /* Flush with content when it's plain text; once it has a visible pill (is-secondary),
     let it sit inset like every other pill control (header bar, tags) instead of overhanging the edge. */
  .case-study-back.is-tertiary {
    margin-left: calc(-0.75rem - var(--border-width));
  }

  .case-study-aside {
    scroll-margin-top: 5rem;
  }

  @media (max-width: 1023px) {
    .case-study-aside {
      position: sticky;
      top: 4.5rem;
      z-index: 40;
      padding-block: 0.75rem;
      pointer-events: none;
    }

    .case-study-back {
      pointer-events: auto;
    }
  }
</style>
