---
import '../styles/global.css';
import '../styles/comment-mode.css';
import { site } from '../data/site';
import CommentMode from '../components/CommentMode.astro';

interface Props {
  title?: string;
  description?: string;
  showCommentMode?: boolean;
  adminReview?: boolean;
}

const {
  title = site.title,
  description = site.description,
  showCommentMode = true,
  adminReview = false,
} = Astro.props;

if (adminReview) {
  await import('../styles/admin-review.css');
}
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      'min-h-screen text-ink antialiased',
      adminReview
        ? 'comment-feedback-root admin-review-root comment-view-comment'
        : showCommentMode
          ? 'comment-feedback-root comment-view-only'
          : 'bg-canvas',
    ]}
  >
    {
      adminReview ? (
        <slot />
      ) : showCommentMode ? (
        <div id="site-shell" class="site-shell">
          <div id="site-canvas" class="site-canvas">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )
    }
    {showCommentMode && !adminReview && <CommentMode />}
  </body>
</html>
