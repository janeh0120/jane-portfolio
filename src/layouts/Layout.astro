---
import '../styles/global.css';
import '../styles/comment-mode.css';
import { site } from '../data/site';
import CommentMode from '../components/CommentMode.astro';

interface Props {
  title?: string;
  description?: string;
  showCommentMode?: boolean;
  adminReview?: boolean;
}

const {
  title = site.title,
  description = site.description,
  showCommentMode = true,
  adminReview = false,
} = Astro.props;

if (adminReview) {
  await import('../styles/admin-review.css');
}
const base = import.meta.env.BASE_URL;
const enableClarity = import.meta.env.PROD && !adminReview;
/** Bump when favicon assets change — Safari caches icons aggressively. */
const iconVersion = '3';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(theme) {
          if (theme !== 'light' && theme !== 'dark' && theme !== 'system') theme = 'system';
          var root = document.documentElement;
          root.dataset.theme = theme;
          var dark = theme === 'dark' || (theme === 'system' && media.matches);
          root.classList.toggle('theme-dark', dark);
          try {
            localStorage.setItem('theme', theme);
          } catch (e) {}
        }
        window.__setTheme = apply;
        var stored = 'system';
        try {
          stored = localStorage.getItem('theme') || 'system';
        } catch (e) {}
        apply(stored);
        media.addEventListener('change', function () {
          if (document.documentElement.dataset.theme === 'system') apply('system');
        });
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg?v=${iconVersion}`} type="image/svg+xml" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      href={`${base}favicon-light.png?v=${iconVersion}`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href={`${base}favicon-dark.png?v=${iconVersion}`}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="alternate icon" type="image/png" href={`${base}favicon.png?v=${iconVersion}`} />
    <link rel="shortcut icon" href={`${base}favicon.ico?v=${iconVersion}`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png?v=${iconVersion}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      enableClarity && (
        <script is:inline>
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'ybrgm9n3k0');
        </script>
      )
    }
  </head>
  <body
    class:list={[
      'min-h-screen text-ink antialiased',
      adminReview
        ? 'comment-feedback-root admin-review-root comment-view-comment'
        : showCommentMode
          ? 'comment-feedback-root comment-view-only'
          : 'bg-canvas',
    ]}
  >
    {
      adminReview ? (
        <slot />
      ) : showCommentMode ? (
        <div id="site-shell" class="site-shell">
          <div id="site-canvas" class="site-canvas">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )
    }
    {showCommentMode && !adminReview && <CommentMode />}
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>(
        '.project-card, .case-study-content > section, .about-card',
      );

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const root = document.getElementById('site-canvas');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          { root, rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
