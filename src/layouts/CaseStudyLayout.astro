---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';
import SidebarNav from '../components/SidebarNav.astro';

interface NavItem {
  label: string;
  href: string;
}

interface HeroImage {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

interface Props {
  title: string;
  heading: string;
  role: string;
  /** Where the work was done, as plain text (no logos). */
  company?: string;
  team?: string;
  teamLabel?: string;
  timeline: string;
  projectType: string;
  nav?: NavItem[];
  commentId?: string;
  heroImage?: HeroImage;
}

const {
  title,
  heading,
  role,
  company,
  team,
  teamLabel = 'Team',
  timeline,
  projectType,
  nav = [],
  commentId,
  heroImage,
} = Astro.props;
const studyCommentId = commentId ?? `case-study-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<Layout title={`${title} | Jane Hou's Portfolio`}>
  <Header />
  <main class="page-frame pb-24 pt-6 md:pt-8">
    <div class="grid gap-8 lg:grid-cols-[200px_1fr] lg:gap-20">
      <SidebarNav nav={nav} ariaLabel="Case study" backLabel="Back" />

      <article class="min-w-0 w-full max-w-3xl lg:mx-auto" data-comment-id={studyCommentId}>
        <h1 class="heading text-ink">{heading}</h1>

        {
          Astro.slots.has('hero') ? (
            <div class="case-study-hero mt-6 min-w-0">
              <slot name="hero" />
            </div>
          ) : (
            heroImage && (
              <div class="case-study-hero mt-6">
                <CaseStudyFigure
                  src={heroImage.src}
                  alt={heroImage.alt}
                  caption={heroImage.caption}
                  wide={heroImage.wide}
                />
              </div>
            )
          )
        }

        <dl class:list={['mt-10 grid gap-6 sm:grid-cols-2', company ? 'md:grid-cols-5' : 'md:grid-cols-4']}>
          {company && (
            <div>
              <dt class="text-body text-muted">Company:</dt>
              <dd class="mt-1 text-body text-ink">{company}</dd>
            </div>
          )}
          <div>
            <dt class="text-body text-muted">Role:</dt>
            <dd class="mt-1 text-body text-ink">{role}</dd>
          </div>
          {team && (
            <div>
              <dt class="text-body text-muted">{teamLabel}:</dt>
              <dd class="mt-1 text-body text-ink">{team}</dd>
            </div>
          )}
          <div>
            <dt class="text-body text-muted">Timeline:</dt>
            <dd class="mt-1 text-body text-ink">{timeline}</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Project Type:</dt>
            <dd class="mt-1 text-body text-ink">{projectType}</dd>
          </div>
        </dl>

        <div class="case-study-content section-stack mt-14">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .case-study-hero :global(.case-study-figure) {
    margin: 0;
  }

  .case-study-hero :global(img),
  .case-study-hero :global(video),
  .case-study-hero :global(.feedback-demo-reel),
  .case-study-hero :global(.migration-reel) {
    border-radius: var(--radius-base);
  }

  .case-study-content :global(h3:not(.hero-copy, .text-intro, .heading)) {
    margin: 0;
    font: var(--type-subheading);
    letter-spacing: var(--tracking-tight);
  }


  /* Keep heading + body as one unit; separate each unit clearly */
  .case-study-content :global(h2:not(:first-child)) {
    margin-top: var(--space-12);
  }

  /* Body type for paragraphs, except ones that set a type-ramp class (statements in .heading) */
  .case-study-content :global(p:not(.hero-copy, .text-intro, .heading, .subheading)),
  .case-study-content :global(.lead) {
    margin: 0;
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink);
  }

  .case-study-content :global(p + p) {
    margin-top: var(--space-4);
  }

  .case-study-content :global(section) {
    scroll-margin-top: 8rem;
  }

  @media (min-width: 1024px) {
    .case-study-content :global(section) {
      scroll-margin-top: 6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.case-study-nav)) {
      scroll-behavior: smooth;
    }
  }

  .case-study-content :global(ol) {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-8);
  }

  .case-study-content :global(ol li h3) {
    font: var(--type-subheading);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-1);
    color: var(--color-ink);
  }

  .case-study-content :global(ol li p),
  .case-study-content :global(ol li .lead) {
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure) {
    margin: var(--space-6) 0 0;
  }

  .case-study-content :global(.case-study-figure--wide) {
    margin-top: var(--space-8);
  }

  .case-study-content :global(.case-study-figure--wide + .case-study-figure--wide) {
    margin-top: var(--space-10);
  }

  .case-study-content :global(.case-study-figure img) {
    display: block;
    width: 100%;
    border-radius: var(--radius-base);
    background: transparent;
  }

  .case-study-content :global(.case-study-figure--wide img) {
    border-radius: var(--radius-base);
  }

  .case-study-content :global(.case-study-figure video) {
    display: block;
    width: 100%;
    border-radius: var(--radius-base);
    background: var(--color-ink);
  }

  .case-study-content :global(.case-study-figure--placeholder img) {
    outline: 1px dashed var(--color-placeholder);
  }

  .case-study-content :global(.case-study-figure figcaption) {
    margin-top: var(--space-2);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure-row) {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-figure-row) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stats) {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-stats) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stat) {
    padding: 0;
    background: transparent;
  }

  .case-study-content :global(.case-study-stat strong) {
    display: block;
    font: var(--type-subheading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .case-study-content :global(.case-study-stat span) {
    display: block;
    margin-top: var(--space-1);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-muted);
  }

  .case-study-content :global(ul.case-study-list) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list) {
    list-style: decimal;
    display: block;
    gap: unset;
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    font: var(--type-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list li + li) {
    margin-top: var(--space-1);
  }
</style>
