---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';

interface NavItem {
  label: string;
  href: string;
}

interface HeroImage {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

interface Props {
  title: string;
  heading: string;
  role: string;
  team: string;
  teamLabel?: string;
  timeline: string;
  projectType: string;
  nav?: NavItem[];
  commentId?: string;
  heroImage?: HeroImage;
}

const {
  title,
  heading,
  role,
  team,
  teamLabel = 'Team',
  timeline,
  projectType,
  nav = [],
  commentId,
  heroImage,
} = Astro.props;
const studyCommentId = commentId ?? `case-study-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const base = import.meta.env.BASE_URL;
const home = base;
const hasNav = nav.length > 0;
---

<Layout title={`${title} | Jane Hou's Portfolio`}>
  <Header />
  <main class="mx-auto max-w-[1400px] px-6 pb-24 pt-6 md:px-10">
    <div class="grid gap-8 lg:grid-cols-[200px_1fr] lg:gap-20">
      <aside class="case-study-aside lg:sticky lg:top-24 lg:self-start">
        <a href={home} class="case-study-back text-meta text-muted transition hover:text-ink">
          ← Back to Home
        </a>
        {
          hasNav && (
            <nav
              class="case-study-nav flex gap-3 overflow-x-auto lg:mt-6 lg:flex-col lg:overflow-visible lg:gap-3"
              aria-label="Case study"
            >
              {nav.map((item) => (
                <a href={item.href} class="text-meta text-muted transition hover:text-ink">
                  {item.label}
                </a>
              ))}
            </nav>
          )
        }
      </aside>

      <article class="min-w-0 max-w-3xl" data-comment-id={studyCommentId}>
        <h1 class="case-study-heading text-ink">{heading}</h1>

        {
          Astro.slots.has('hero') ? (
            <div class="case-study-hero mt-6 min-w-0">
              <slot name="hero" />
            </div>
          ) : (
            heroImage && (
              <div class="case-study-hero mt-6">
                <CaseStudyFigure
                  src={heroImage.src}
                  alt={heroImage.alt}
                  caption={heroImage.caption}
                  wide={heroImage.wide}
                />
              </div>
            )
          )
        }

        <dl class="mt-10 grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="text-meta text-muted">Role:</dt>
            <dd class="mt-1 text-body text-ink">{role}</dd>
          </div>
          <div>
            <dt class="text-meta text-muted">{teamLabel}:</dt>
            <dd class="mt-1 text-body text-ink">{team}</dd>
          </div>
          <div>
            <dt class="text-meta text-muted">Timeline:</dt>
            <dd class="mt-1 text-body text-ink">{timeline}</dd>
          </div>
          <div>
            <dt class="text-meta text-muted">Project Type:</dt>
            <dd class="mt-1 text-body text-ink">{projectType}</dd>
          </div>
        </dl>

        <div class="case-study-content mt-14">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  const nav = document.querySelector('.case-study-nav');
  if (nav) {
    nav.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;

        const target = document.getElementById(href.slice(1));
        if (!target) return;

        event.preventDefault();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', href);
      });
    });
  }
</script>

<style>
  .case-study-back {
    display: inline-block;
  }

  .case-study-aside {
    scroll-margin-top: 5rem;
  }

  @media (max-width: 1023px) {
    .case-study-aside {
      position: sticky;
      top: 4.5rem;
      z-index: 40;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-left: -1.5rem;
      margin-right: -1.5rem;
      padding: 0.75rem 1.5rem;
      background: rgb(255 255 255 / 92%);
      backdrop-filter: blur(8px);
    }

    .case-study-nav {
      flex-wrap: nowrap;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .case-study-nav::-webkit-scrollbar {
      display: none;
    }

    .case-study-nav a {
      flex-shrink: 0;
      scroll-snap-align: start;
      white-space: nowrap;
      padding: 0.375rem 0;
    }
  }

  .case-study-hero :global(.case-study-figure) {
    margin: 0;
  }

  .case-study-content {
    display: flex;
    flex-direction: column;
    gap: 5.5rem;
  }

  @media (min-width: 768px) {
    .case-study-content {
      gap: 7rem;
    }
  }

  .case-study-content :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .case-study-content :global(h3) {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }

  /* Keep heading + body as one unit; separate each unit clearly */
  .case-study-content :global(h3:not(:first-child)) {
    margin-top: 2.75rem;
  }

  .case-study-content :global(p),
  .case-study-content :global(.lead) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .case-study-content :global(p + p) {
    margin-top: 0.875rem;
  }

  .case-study-content :global(section) {
    scroll-margin-top: 8rem;
  }

  @media (min-width: 1024px) {
    .case-study-content :global(section) {
      scroll-margin-top: 6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.case-study-nav)) {
      scroll-behavior: smooth;
    }
  }

  .case-study-content :global(ol) {
    list-style: none;
    padding: 0;
    margin: 0.875rem 0 0;
    display: grid;
    gap: 1.75rem;
  }

  .case-study-content :global(ol li h2) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }

  .case-study-content :global(ol li p),
  .case-study-content :global(ol li .lead) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure) {
    margin: 1.5rem 0 0;
  }

  .case-study-content :global(.case-study-figure--wide) {
    margin-top: 2rem;
  }

  .case-study-content :global(.case-study-figure--wide + .case-study-figure--wide) {
    margin-top: 2.5rem;
  }

  .case-study-content :global(.case-study-figure img) {
    display: block;
    width: 100%;
    border-radius: 0;
    background: transparent;
  }

  .case-study-content :global(.case-study-figure--wide img) {
    border-radius: 0;
  }

  .case-study-content :global(.case-study-figure video) {
    display: block;
    width: 100%;
    border-radius: 0;
    background: #000;
  }

  .case-study-content :global(.case-study-figure--placeholder img) {
    outline: 1px dashed #c8c8c8;
  }

  .case-study-content :global(.case-study-figure figcaption) {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure-row) {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-figure-row) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stats) {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-stats) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stat) {
    padding: 0;
    background: transparent;
  }

  .case-study-content :global(.case-study-stat strong) {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .case-study-content :global(.case-study-stat span) {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(ul.case-study-list) {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list) {
    list-style: decimal;
    display: block;
    gap: unset;
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list li + li) {
    margin-top: 0.35rem;
  }
</style>
