---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyFigure from '../components/CaseStudyFigure.astro';
import SidebarNav from '../components/SidebarNav.astro';

interface NavItem {
  label: string;
  href: string;
}

interface HeroImage {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

interface Props {
  title: string;
  heading: string;
  role: string;
  team: string;
  teamLabel?: string;
  timeline: string;
  projectType: string;
  nav?: NavItem[];
  commentId?: string;
  heroImage?: HeroImage;
}

const {
  title,
  heading,
  role,
  team,
  teamLabel = 'Team',
  timeline,
  projectType,
  nav = [],
  commentId,
  heroImage,
} = Astro.props;
const studyCommentId = commentId ?? `case-study-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<Layout title={`${title} | Jane Hou's Portfolio`}>
  <Header />
  <main class="mx-auto max-w-[1400px] px-6 pb-24 pt-6 md:px-10">
    <div class="grid gap-8 lg:grid-cols-[200px_1fr] lg:gap-20">
      <SidebarNav nav={nav} ariaLabel="Case study" />

      <article class="min-w-0 max-w-3xl" data-comment-id={studyCommentId}>
        <h1 class="heading text-ink">{heading}</h1>

        {
          Astro.slots.has('hero') ? (
            <div class="case-study-hero mt-6 min-w-0">
              <slot name="hero" />
            </div>
          ) : (
            heroImage && (
              <div class="case-study-hero mt-6">
                <CaseStudyFigure
                  src={heroImage.src}
                  alt={heroImage.alt}
                  caption={heroImage.caption}
                  wide={heroImage.wide}
                />
              </div>
            )
          )
        }

        <dl class="mt-10 grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="text-body text-muted">Role:</dt>
            <dd class="mt-1 text-body text-ink">{role}</dd>
          </div>
          <div>
            <dt class="text-body text-muted">{teamLabel}:</dt>
            <dd class="mt-1 text-body text-ink">{team}</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Timeline:</dt>
            <dd class="mt-1 text-body text-ink">{timeline}</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Project Type:</dt>
            <dd class="mt-1 text-body text-ink">{projectType}</dd>
          </div>
        </dl>

        <div class="case-study-content section-stack mt-14">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .case-study-hero :global(.case-study-figure) {
    margin: 0;
  }

  .case-study-content :global(h2) {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .case-study-content :global(h3) {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  /* Keep heading + body as one unit; separate each unit clearly */
  .case-study-content :global(h3:not(:first-child)) {
    margin-top: 2.75rem;
  }

  .case-study-content :global(p),
  .case-study-content :global(.lead) {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .case-study-content :global(p + p) {
    margin-top: 0.875rem;
  }

  .case-study-content :global(section) {
    scroll-margin-top: 8rem;
  }

  @media (min-width: 1024px) {
    .case-study-content :global(section) {
      scroll-margin-top: 6rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.case-study-nav)) {
      scroll-behavior: smooth;
    }
  }

  .case-study-content :global(ol) {
    list-style: none;
    padding: 0;
    margin: 0.875rem 0 0;
    display: grid;
    gap: 1.75rem;
  }

  .case-study-content :global(ol li h2) {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }

  .case-study-content :global(ol li p),
  .case-study-content :global(ol li .lead) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure) {
    margin: 1.5rem 0 0;
  }

  .case-study-content :global(.case-study-figure--wide) {
    margin-top: 2rem;
  }

  .case-study-content :global(.case-study-figure--wide + .case-study-figure--wide) {
    margin-top: 2.5rem;
  }

  .case-study-content :global(.case-study-figure img) {
    display: block;
    width: 100%;
    border-radius: 0;
    background: transparent;
  }

  .case-study-content :global(.case-study-figure--wide img) {
    border-radius: 0;
  }

  .case-study-content :global(.case-study-figure video) {
    display: block;
    width: 100%;
    border-radius: 0;
    background: var(--color-ink);
  }

  .case-study-content :global(.case-study-figure--placeholder img) {
    outline: 1px dashed var(--color-placeholder);
  }

  .case-study-content :global(.case-study-figure figcaption) {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(.case-study-figure-row) {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-figure-row) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stats) {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .case-study-content :global(.case-study-stats) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .case-study-content :global(.case-study-stat) {
    padding: 0;
    background: transparent;
  }

  .case-study-content :global(.case-study-stat strong) {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .case-study-content :global(.case-study-stat span) {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .case-study-content :global(ul.case-study-list) {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list) {
    list-style: decimal;
    display: block;
    gap: unset;
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .case-study-content :global(ol.case-study-list li + li) {
    margin-top: 0.35rem;
  }
</style>
